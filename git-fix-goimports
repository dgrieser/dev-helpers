#!/bin/bash

git() { command git -c color.ui=always "$@"; }

abort() {
    echo "Abort." 1>&2
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

# "make" and "find ." below cover the whole repository, so run in its root
# instead of the directory this was started from
git_dir="$(git rev-parse --show-toplevel)" || fail "Not a git repo?"
cd "${git_dir}" || fail "Failed to change to: ${git_dir}"

git-track-branches || exit 1
git checkout master || fail "Failed to checkout branch master"
branches="$(git branch --list --format="%(refname:short)" --sort=-committerdate | head -n 10)"
choice="$(printf '%s\n' "${branches}" | prompt-select -p "Choose branch:")" || abort
git checkout "${choice}" || fail "Failed to checkout branch ${choice}"
echo; echo "Running make imports..." 1>&2
make imports && echo "Done." 1>&2 || warning "Failed to run make imports"
echo; echo "Running goimports..."
goimports -w -d $(find . -type f -name '*.go' -not -name 'zz_generated.*') && echo "Done." 1>&2 || warning "Failed to run goimports"
echo
git-push
