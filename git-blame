#!/bin/bash

git() { command git -c color.ui=always "$@"; }

APP="$(basename "${0}")"

NL=$'\n'

C_LEVEL=$'\033[33m'
C_BOUND=$'\033[38;5;208m'
C_AGE=$'\033[38;5;6m'
C_AUTHOR=$'\033[38;5;33m'
C_LINE=$'\033[38;5;245m'
C_DIM=$'\033[90m'
C_RESET=$'\033[0m'

SHOW_ARGS=(--format= -m --first-parent)

BLAME_HEADER=$'LVL\tAGE\tAUTHOR\tLINE\tCODE'
BLAME_KEYS="ctrl-c,ctrl-s,ctrl-d,ctrl-l,ctrl-o,alt-v,alt-e,alt-p,esc,enter"
BLAME_KEY_DESCS="enter:blame before,ctrl-s:show commit,ctrl-d:diff file,ctrl-l:line log,ctrl-c:copy hash,ctrl-o:open,alt-v:vimdiff,alt-e:edit,alt-p:patch"

PICK_HEADER=$'PATH'
PICK_KEYS="esc,enter"
PICK_KEY_DESCS="enter:blame,esc:quit"

key_help() {
    printf '%s' "${1}" | tr ',' '\n' | awk -F':' '{ printf "  %-8s %s\n", $1, $2 }'
}

usage() {
    cat <<EOF 1>&2
usage: ${APP} [OPTIONS] [--] [<file>]

Interactive git blame picker. Lines are listed as LVL / AGE / AUTHOR / LINE /
CODE and the preview shows the commit that last touched the selected line with
its stat and patch.

Without <file> a file picker lists the tracked files first.

Keys:
$(key_help "${BLAME_KEY_DESCS}")

enter blames the file again as it was before the commit of the selected line,
so the history of a line can be walked change by change. Renames are followed,
the file is blamed under the name it had back then.

LVL is the depth of that walk, 1 for the blame of the file itself. A "^" next
to it marks a line whose commit has nothing before it, enter stays where it is
on those. A dimmed row is a line that is not committed yet.

esc and backspace leave a nested level and return to the previous blame. On
the first level backspace stays the key that erases the search query.

Options:
  -q, --query <query>       start the picker with a search query
  -r, --ref <rev>           blame <rev> instead of the working tree
  -L, --lines <range>       only blame <range>, e.g. 20,40, 20,+10 or
                            :<funcname>; may be repeated
  -w, --ignore-whitespace   ignore whitespace when assigning blame
  -M                        detect lines moved or copied within the file
  -C                        detect lines moved or copied from other files;
                            may be repeated to search harder
      --ignore-rev <rev>    ignore <rev> when assigning blame; may be repeated
      --ignore-revs-file <file>
                            ignore the revisions listed in <file>
      --print               print the blame instead of opening the picker
  -o, --output-dir <dir>    directory for the patch files (default: the current
                            directory)
  -h, --help                show this help message and exit
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

need_cmd() {
    command -v "${1}" >/dev/null 2>&1 || fail "${1} not found"
}

pager() {
    if [ -t 1 ]; then
        less -R
    else
        cat
    fi
}

# pad tab separated columns, ANSI aware, so colored cells still line up; the
# last column stays unpadded and the two space separator doubles as the column
# delimiter of the picker
render_table() {
    awk -F'\t' '
        function vlen(s) { gsub(/\033\[[0-9;]*m/, "", s); return length(s) }
        { rows[NR] = $0
          for (i = 1; i <= NF; i++) { l = vlen($i); if (l > w[i]) w[i] = l } }
        END {
            for (r = 1; r <= NR; r++) {
                nf = split(rows[r], f, "\t")
                line = ""
                for (i = 1; i <= nf; i++) {
                    if (i > 1) line = line "  "
                    line = line f[i]
                    if (i < nf) { pad = w[i] - vlen(f[i]); while (pad-- > 0) line = line " " }
                }
                print line
            }
        }'
}

git_repo() {
    git -C "${repo_root_dir}" "${@}"
}

is_uncommitted() {
    [[ "${1}" =~ ^0+$ ]]
}

# the parent to blame against; empty for a root commit
parent_of() {
    git_repo rev-parse --verify --quiet "${1}^" 2>/dev/null
}

blame_porcelain() {
    local args=(blame --porcelain "${blame_args[@]}" "${@}")

    [ -n "${ref}" ] && args+=("${ref}")
    git_repo "${args[@]}" -- "${path}" 2>/dev/null
}

# the commit a line is blamed on and the name the file had in it, as
# "<sha>\t<file>"; the hash is not a column of the picker, so it is looked up
# from the line, and a rename is only visible in the blame of that single line
line_info() {
    local out sha file

    out="$(blame_porcelain -L "${1},${1}")"
    sha="$(head -n 1 <<< "${out}" | awk '{ print $1 }')"
    file="$(awk '/^filename /{ print substr($0, 10); exit }' <<< "${out}")"
    [ -z "${file}" ] && file="${path}"
    printf '%s\t%s\n' "${sha}" "${file}"
}

# the picker lays its list out from the bottom up, so it is fed the lines in
# reverse and the file still reads from its first line at the top
print_blame() {
    local reverse="${1}"
    local raw lines shas ages rows

    raw="$(blame_porcelain "${line_args[@]}")"
    if [ -z "${raw}" ]; then
        printf '%s\n' "${BLAME_HEADER}" | render_table
        return 0
    fi

    # a porcelain record is a "<sha> <origline> <finalline> [<numlines>]"
    # header, its optional fields, and the content line prefixed with a tab;
    # only the first record of a commit carries the author fields, so the age
    # and the author are looked up per commit instead
    #
    # "boundary" is where the blame stopped walking, which for a full blame is
    # a commit without a parent: those lines have no level below them, and the
    # flag comes for free with the blame that is listed anyway
    lines="$(awk '
        /^[0-9a-f]{40} [0-9]+ [0-9]+/ { sha = $1; lineno = $3; next }
        /^boundary$/ { bnd[sha] = 1; next }
        /^\t/ {
            code = substr($0, 2)
            gsub(/\t/, "    ", code)
            print sha "\t" lineno "\t" (sha in bnd ? 1 : 0) "\t" code
        }' <<< "${raw}")"

    shas="$(awk -F'\t' '{ print $1 }' <<< "${lines}" | grep -v "^0*$" | sort -u)"
    if [ -n "${shas}" ]; then
        ages="$(git_repo log --no-walk --stdin --format='%H%x09%cI%x09%al' \
                    <<< "${shas}" 2>/dev/null | toage)"
    else
        ages=""
    fi

    rows="$(awk -F'\t' -v OFS='\t' -v lvl="${level}" -v clevel="${C_LEVEL}" \
                -v cbound="${C_BOUND}" -v cage="${C_AGE}" -v cauthor="${C_AUTHOR}" \
                -v cline="${C_LINE}" -v cdim="${C_DIM}" -v reset="${C_RESET}" '
            NR == FNR { age[$1] = $2; author[$1] = $3; next }
            {
                n++
                sha[n] = $1; lineno[n] = $2; bnd[n] = $3; code[n] = $4
                if (length($2) > w) w = length($2)
            }
            END {
                # the level, the age, the author and the line are the first four
                # columns of the picker, so none of them may render empty: a
                # blank cell would merge with the padding and shift the fields
                for (i = 1; i <= n; i++) {
                    s = sha[i]
                    known = (s in age)
                    a = (known ? age[s] : "-")
                    au = (known ? author[s] : "-")
                    if (a == "") a = "0s"
                    if (au == "") au = "-"
                    # a line that is not committed yet has no commit to step
                    # into either, its whole row is dimmed
                    if (!known) {
                        printf "%s\t%s\t%s\t%s\t%s\n",
                            cdim lvl reset, cdim a reset, cdim au reset,
                            cdim sprintf("%*s", w, lineno[i]) reset, code[i]
                        continue
                    }
                    printf "%s\t%s\t%s\t%s\t%s\n",
                        clevel lvl reset (bnd[i] ? cbound "^" reset : ""),
                        cage a reset,
                        cauthor au reset,
                        cline sprintf("%*s", w, lineno[i]) reset,
                        code[i]
                }
            }' <(printf '%s\n' "${ages}") <(printf '%s\n' "${lines}"))"

    # the header stays the first line, it is the header of the picker
    [ -n "${reverse}" ] && rows="$(tac <<< "${rows}")"
    printf '%s\n' "${BLAME_HEADER}${NL}${rows}" | render_table
}

# only the picker lists the paths, so they are reversed right away to come out
# sorted from the top of its bottom up layout
print_paths() {
    local rows

    if [ -n "${ref}" ]; then
        rows="$(git_repo ls-tree -r --name-only "${ref}" | tac)"
    else
        rows="$(git_repo ls-files | tac)"
    fi
    printf '%s\n' "${PICK_HEADER}${NL}${rows}"
}

preview_line() {
    local sha file

    IFS=$'\t' read -r sha file < <(line_info "${1}")
    if is_uncommitted "${sha}"; then
        echo "Not committed yet." 1>&2
        git_repo diff --color=always -- "${path}"
        return 0
    fi
    git_repo show -m --first-parent --color=always --stat --patch "${sha}" -- "${file}"
}

preview_path() {
    if [ -n "${ref}" ]; then
        git_repo show "${ref}:${1}" 2>/dev/null | cat -n
    else
        cat -n "${repo_root_dir}/${1}" 2>/dev/null
    fi
}

show_commit() {
    git_repo show -m --first-parent --color=always --stat --patch "${1}" | pager
}

show_file_diff() {
    git_repo show "${SHOW_ARGS[@]}" --color=always "${1}" -- "${2}" | pager
}

show_line_log() {
    local lineno="${1}"
    local args=(log --color=always -L "${lineno},${lineno}:${path}")

    [ -n "${ref}" ] && args+=("${ref}")
    git_repo "${args[@]}" | pager
}

create_patch() {
    local sha="${1}"
    local file="${2}"
    local short out

    [ -d "${output_dir}" ] || fail "No such directory: ${output_dir}"
    short="$(git_repo rev-parse --short "${sha}")"
    out="${output_dir}/$(basename "${file}").${short}.patch"
    git_repo show "${SHOW_ARGS[@]}" --no-color "${sha}" -- "${file}" > "${out}" \
        || fail "Failed to create a patch for ${file}"
    [ -s "${out}" ] || { rm -f "${out}"; fail "Nothing to patch for ${file} in ${short}"; }
    printf '%s\n' "${out}"
}

commit_url() {
    local base host

    base="$(git-browse -p 2>/dev/null)" || return 1
    host="$(git-browse -p --host-only 2>/dev/null)" || return 1
    [ -z "${base}" ] && return 1
    if [[ "${host}" == *github* ]]; then
        echo "${base}/commit/${1}"
    else
        echo "${base}/-/commit/${1}"
    fi
}

open_commit() {
    local url

    need_cmd git-browse
    url="$(commit_url "${1}")" || fail "Failed to determine the commit URL"
    need_cmd gio
    gio open "${url}" &>/dev/null
}

vimdiff_line() {
    local sha="${1}"
    local file="${2}"
    local lineno="${3}"
    local parent tmp_root old new

    need_cmd vim
    parent="$(parent_of "${sha}")"
    tmp_root="$(mktemp -d)" || fail "Cannot create a temp directory"
    trap 'rm -rf "${tmp_root}"' EXIT

    old="${tmp_root}/before/${file}"
    new="${tmp_root}/after/${file}"
    mkdir -p "$(dirname "${old}")" "$(dirname "${new}")"
    # a file that is missing on either side diffs against an empty file
    if [ -n "${parent}" ]; then
        git_repo show "${parent}:${file}" > "${old}" 2>/dev/null || : > "${old}"
    else
        : > "${old}"
    fi
    git_repo show "${sha}:${file}" > "${new}" 2>/dev/null || : > "${new}"

    # both sides are history, so neither is editable; closing one window quits
    # vim so the picker comes back right away
    vim -d "${old}" "${new}" \
        -c 'windo setlocal readonly nomodifiable' -c 'wincmd l' \
        -c "normal ${lineno}Gzz" \
        -c 'autocmd WinClosed * ++nested qall' \
        -c 'redraw!'
}

edit_line() {
    local lineno="${1}"
    local editor="${EDITOR:-vim}"
    local tmp_root file

    need_cmd "${editor%% *}"
    # only the working tree is editable; a blamed revision is opened read only
    if [ -z "${ref}" ] && [ -e "${repo_root_dir}/${path}" ]; then
        ${editor} "+${lineno}" "${repo_root_dir}/${path}"
        return $?
    fi

    tmp_root="$(mktemp -d)" || fail "Cannot create a temp directory"
    trap 'rm -rf "${tmp_root}"' EXIT
    file="${tmp_root}/${path}"
    mkdir -p "$(dirname "${file}")"
    git_repo show "${ref}:${path}" > "${file}" 2>/dev/null \
        || fail "Failed to read ${path} from ${ref}"
    need_cmd vim
    vim -R "+${lineno}" "${file}" -c 'redraw!'
}

# blame the file again as it was before the commit of the selected line; a line
# without a commit below it is already marked with a "^" in its level, so
# nothing is reported here, the picker just stays where it is
blame_before() {
    local sha="${1}"
    local file="${2}"
    local parent

    parent="$(parent_of "${sha}")"
    [ -z "${parent}" ] && return 2
    "${0}" "${blame_args[@]}" --level "$((level + 1))" --ref "${parent}" -- "${file}"
}

write_state() {
    {
        printf 'start_dir=%q\n' "${PWD}"
        printf 'repo_root_dir=%q\n' "${repo_root_dir}"
        printf 'output_dir=%q\n' "${output_dir}"
        printf 'path=%q\n' "${path}"
        printf 'ref=%q\n' "${ref}"
        printf 'level=%q\n' "${level}"
        declare -p blame_args
        declare -p line_args
    } > "${STATE_FILE}"
}

# the list is fed in reverse, so its last entry is the one to start on: the
# first line of the file, at the top of the list
#
# backspace only leaves a nested level, on the first one it stays the key that
# erases the search query
pick_blame() {
    local keys="${BLAME_KEYS}"
    local descs="${BLAME_KEY_DESCS}"

    if [ "${level}" -gt 1 ]; then
        keys="${keys},bspace"
        descs="${descs},esc/bspace:back"
    fi

    fzf-with-header --key-command "${APP} --id ${id} --key" \
                    --key-descriptions "${descs}" \
                    --command "${APP} --id ${id} --print-up" \
                    "${query}" \
                    --preview="${APP} --id ${id} --preview {4}" \
                    --preview-window=right:60%,nowrap \
                    --expect="${keys}" \
                    --bind=load:last \
                    --no-sort
}

pick_path() {
    fzf-with-header --key-command "${APP} --id ${id} --pick-key" \
                    --key-descriptions "${PICK_KEY_DESCS}" \
                    --command "${APP} --id ${id} --pick-print" \
                    "${query}" \
                    --preview="${APP} --id ${id} --pick-preview {1}" \
                    --preview-window=right:60%,nowrap \
                    --expect="${PICK_KEYS}" \
                    --bind=load:last
}

handle_key() {
    local key line lineno sha file

    key="$(head -n 1 <<< "${key_result}")"
    line="$(sed -n '2p' <<< "${key_result}")"
    lineno="$(awk '{print $4}' <<< "${line}")"

    case "${key}" in
        esc|bspace)
            exit 255
            ;;
    esac
    [[ "${lineno}" =~ ^[0-9]+$ ]] || exit 0

    # the line stands for its commit, which is not a column of the picker
    IFS=$'\t' read -r sha file < <(line_info "${lineno}")
    [ -z "${sha}" ] && exit 0

    # a line that is not committed yet has no commit to act on; its row is
    # dimmed and its preview says so, so those keys just do nothing
    if is_uncommitted "${sha}"; then
        case "${key}" in
            enter|ctrl-s|ctrl-d|ctrl-c|ctrl-o|alt-v|alt-p)
                exit 0
                ;;
        esac
    fi

    case "${key}" in
        enter)
            # the nested blame ending on an action ends this picker as well,
            # leaving it with esc or backspace comes back here, and a line
            # without a commit below it stays where it is
            blame_before "${sha}" "${file}"
            case "${?}" in
                0) exit 1 ;;
                *) exit 0 ;;
            esac
            ;;
        ctrl-s)
            show_commit "${sha}"
            exit 0
            ;;
        ctrl-d)
            show_file_diff "${sha}" "${file}"
            exit 0
            ;;
        ctrl-l)
            show_line_log "${lineno}"
            exit 0
            ;;
        ctrl-c)
            printf '%s\n' "${sha}"
            need_cmd clip
            printf '%s' "${sha}" | clip
            exit 1
            ;;
        ctrl-o)
            open_commit "${sha}"
            exit 0
            ;;
        alt-v)
            vimdiff_line "${sha}" "${file}" "${lineno}"
            exit 0
            ;;
        alt-e)
            edit_line "${lineno}"
            exit 0
            ;;
        alt-p)
            create_patch "${sha}" "${file}"
            exit 1
            ;;
        *)
            fail "Unknown key: ${key}"
            ;;
    esac
}

handle_pick_key() {
    local key line child_args=()

    key="$(head -n 1 <<< "${key_result}")"
    line="$(sed -n '2p' <<< "${key_result}")"
    line="${line%"${line##*[![:space:]]}"}"

    case "${key}" in
        esc)
            exit 255
            ;;
    esac
    [ -z "${line}" ] && exit 0

    case "${key}" in
        enter)
            child_args=("${blame_args[@]}" "${line_args[@]}")
            [ -n "${ref}" ] && child_args+=(--ref "${ref}")
            "${0}" "${child_args[@]}" -- "${line}" || exit 0
            exit 1
            ;;
        *)
            fail "Unknown key: ${key}"
            ;;
    esac
}

blame_args=()
line_args=()
path=""
ref=""
level=1
mode="list"
preview_arg=""
key_result=""
query=""
output_dir=""
positional=()
id=$$
id_given=0

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        --print)
            mode="print"
            ;;
        --print-up)
            mode="print-up"
            ;;
        --pick-print)
            mode="pick-print"
            ;;
        --preview)
            shift
            [ -z "${1}" ] && fail "Missing argument for preview"
            mode="preview"
            preview_arg="${1}"
            ;;
        --pick-preview)
            shift
            [ -z "${1}" ] && fail "Missing argument for pick preview"
            mode="pick-preview"
            preview_arg="${1}"
            ;;
        --level)
            shift
            [[ "${1}" =~ ^[0-9]+$ ]] || fail "Invalid level: ${1}"
            level="${1}"
            ;;
        --key)
            shift
            [ -z "${1}" ] && fail "Missing argument for key"
            mode="key"
            key_result="${1}"
            ;;
        --pick-key)
            shift
            [ -z "${1}" ] && fail "Missing argument for key"
            mode="pick-key"
            key_result="${1}"
            ;;
        --id)
            shift
            [ -z "${1}" ] && fail "Missing argument for id"
            id="${1}"
            id_given=1
            ;;
        -q|--query)
            shift
            [ -z "${1}" ] && fail "Missing argument for query"
            query="${1}"
            ;;
        -r|--ref)
            shift
            [ -z "${1}" ] && fail "Missing argument for ref"
            ref="${1}"
            ;;
        -L|--lines)
            shift
            [ -z "${1}" ] && fail "Missing argument for lines"
            line_args+=(-L "${1}")
            ;;
        -o|--output-dir)
            shift
            [ -z "${1}" ] && fail "Missing argument for output directory"
            output_dir="${1}"
            ;;
        -w|--ignore-whitespace)
            blame_args+=(-w)
            ;;
        -M|-C)
            blame_args+=("${1}")
            ;;
        --ignore-rev|--ignore-revs-file)
            opt="${1}"
            shift
            [ -z "${1}" ] && fail "Missing argument for ${opt}"
            blame_args+=("${opt}=${1}")
            ;;
        --)
            shift
            positional+=("${@}")
            break
            ;;
        -*)
            fail "Unknown option: ${1}"
            ;;
        *)
            positional+=("${1}")
            ;;
    esac
    shift
done

[ "${#positional[@]}" -gt 1 ] && fail "Only one file can be blamed"
[ "${#positional[@]}" -eq 1 ] && path="${positional[0]}"

STATE_FILE="/tmp/${APP}-${id}.state"

# --print, --preview and --key are called by the picker and reuse the state of
# the run that opened it
if [ "${id_given}" -eq 1 ] && [ -f "${STATE_FILE}" ]; then
    # shellcheck source=/dev/null
    . "${STATE_FILE}"
    cd "${start_dir}" || fail "Failed to enter ${start_dir}"
    case "${mode}" in
        print)
            print_blame
            exit 0
            ;;
        print-up)
            print_blame "up"
            exit 0
            ;;
        pick-print)
            print_paths
            exit 0
            ;;
        preview)
            preview_line "${preview_arg}"
            exit 0
            ;;
        pick-preview)
            preview_path "${preview_arg}"
            exit 0
            ;;
        key)
            handle_key
            ;;
        pick-key)
            handle_pick_key
            ;;
    esac
fi

case "${mode}" in
    print-up|pick-print|preview|pick-preview|key|pick-key)
        fail "No state for id ${id}"
        ;;
    print)
        [ "${id_given}" -eq 1 ] && fail "No state for id ${id}"
        ;;
esac

need_cmd git
repo_root_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "Not a git repo"
[ -z "${repo_root_dir}" ] && fail "Not a git repo"
[ -z "${output_dir}" ] && output_dir="${PWD}"

git rev-parse --verify --quiet HEAD >/dev/null 2>&1 || fail "No commits yet"

if [ -n "${ref}" ]; then
    rev="$(git_repo rev-parse --verify --quiet "${ref}^{commit}" 2>/dev/null)"
    [ -z "${rev}" ] && fail "Not a commit: ${ref}"
    ref="${rev}"
fi

# the picker and its previews run from the start directory, so every path is
# kept relative to the repository root
if [ -n "${path}" ]; then
    need_cmd realpath
    path="$(realpath -m --relative-to="${repo_root_dir}" -- "${path}")"
    case "${path}" in
        ../*)
            fail "Not inside the repository: ${path}"
            ;;
    esac
    if [ -n "${ref}" ]; then
        git_repo cat-file -e "${ref}:${path}" 2>/dev/null \
            || fail "No such path in $(git_repo rev-parse --short "${ref}"): ${path}"
    else
        [ -e "${repo_root_dir}/${path}" ] || fail "No such file: ${path}"
        git_repo ls-files --error-unmatch -- "${path}" >/dev/null 2>&1 \
            || fail "Not tracked: ${path}"
    fi
fi

write_state
trap 'rm -f "${STATE_FILE}"' EXIT

if [ -z "${path}" ]; then
    [ "${mode}" = "print" ] && fail "No file given"
    [ ! -t 1 ] && fail "No file given"
    need_cmd fzf-with-header
    pick_path
    exit $?
fi

need_cmd toage

if [ "${mode}" = "print" ] || [ ! -t 1 ]; then
    print_blame
    exit 0
fi

need_cmd fzf-with-header
pick_blame
