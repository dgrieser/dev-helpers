#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }
git-color() { command git-color --color=always "$@"; }

APP_NAME="$(basename "${0}")"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [COMMAND] [OPTIONS]

Create, list, or move mirrored git worktree changes back to WORKSPACE.

Commands:
  add                   Add mirrored worktree for BRANCH at:
    WORKSPACE_WORKTREE/<path under WORKSPACE>/BRANCH
    If BRANCH does not exist, ask before creating it.
  list                  List every worktree of the resolved repository: the
                        main tree, the mirrored worktrees, worktrees elsewhere,
                        and mirrored dirs that the repository no longer
                        registers as a worktree
  go                    Print the path of an existing worktree, picked
                        interactively when BRANCH is omitted
  delete                Delete a worktree and print its main dir; without
                        BRANCH the current linked worktree, or one picked
                        interactively when run from the main tree
  move-to-main          Move uncommitted changes from a linked worktree to its main tree

If COMMAND is omitted, add is used.

Only add is bound to WORKSPACE_WORKTREE; the other commands work on any
worktree of a repository whose main tree is under WORKSPACE, wherever the
worktree lives, and can run from inside it.

Options:
  -b, --branch BRANCH    Branch to add, or whose worktree to delete/go to;
                         add asks for it, defaulting to the current branch
  -B, --base REF         Start point for a branch that has to be created;
                         asked interactively when omitted, defaulting to the
                         default remote branch
  -w, --workdir DIR      Dir inside any worktree of the repository; defaults
                         to current dir
      --fetch            Fetch the base before creating the branch
      --no-fetch         Do not fetch the base before creating the branch
                         (asked interactively when neither is given)
  -h, --help             Show this help message and exit

Environment:
  WORKSPACE              Source workspace root
  WORKSPACE_WORKTREE     Mirrored worktree root
EOF
    exit 1
}

need_cmd() {
    command -v "${1}" >/dev/null 2>&1 || fail "${1} not found"
}

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 1
}

set_command() {
    if [ "${command_seen}" = "1" ]; then
        error "Unexpected argument: ${1}"
        usage
    fi

    case "${1}" in
        add|list|go|delete|move-to-main)
            mode="${1}"
            command_seen=1
            ;;
        *)
            error "Unknown command: ${1}"
            usage
            ;;
    esac
}

canonical_dir() {
    [ -n "${1}" ] || return 1
    [ -d "${1}" ] || return 1
    (cd "${1}" 2>/dev/null && pwd -P)
}

inside_path() {
    case "${1}" in
        "${2}"|"${2}"/*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

relative_to() {
    if [ "${1}" = "${2}" ]; then
        echo ""
        return 0
    fi
    echo "${1#"${2}/"}"
}

current_branch() {
    git -C "${1}" symbolic-ref --quiet --short HEAD 2>/dev/null
}

require_git_repo() {
    git -C "${1}" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
        fail "Not inside a git repository: ${1}"
}

git_common_dir() {
    common_dir="$(git -C "${1}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
        return 1
    canonical_dir "${common_dir}"
}

same_git_repo() {
    left_common="$(git_common_dir "${1}")" || return 1
    right_common="$(git_common_dir "${2}")" || return 1
    [ "${left_common}" = "${right_common}" ]
}

has_uncommitted_changes() {
    [ -n "$(git -C "${1}" status --porcelain --untracked-files=all)" ]
}

require_clean_tree() {
    if has_uncommitted_changes "${1}"; then
        fail "${2} has uncommitted changes: ${1}"
    fi
}

cleanup_move_files() {
    [ -n "${move_staged_patch:-}" ] && ${RM_CMD} -f "${move_staged_patch}"
    [ -n "${move_unstaged_patch:-}" ] && ${RM_CMD} -f "${move_unstaged_patch}"
    [ -n "${move_untracked_list:-}" ] && ${RM_CMD} -f "${move_untracked_list}"
    [ -n "${move_untracked_tar:-}" ] && ${RM_CMD} -f "${move_untracked_tar}"
}

move_fail() {
    cleanup_move_files
    fail "${1}"
}

rollback_main_tree() {
    git -C "${workdir}" reset --hard >/dev/null 2>&1
    git -C "${workdir}" clean -fd >/dev/null 2>&1
}

rollback_move_fail() {
    rollback_main_tree
    move_fail "${1}"
}

check_untracked_targets() {
    move_conflict_path=""
    while IFS= read -r -d "" untracked_path; do
        if [ -e "${workdir}/${untracked_path}" ]; then
            move_conflict_path="${untracked_path}"
            return 1
        fi
    done < "${move_untracked_list}"
}

copy_untracked_files() {
    [ -s "${move_untracked_list}" ] || return 0
    (cd "${source_worktree}" && tar --null -T "${move_untracked_list}" -cf "${move_untracked_tar}") ||
        return 1
    (cd "${workdir}" && tar -xf "${move_untracked_tar}") ||
        return 1
}

validate_branch_name() {
    [ -n "${1}" ] || fail "Branch is required"
    git -C "${workdir}" check-ref-format --branch "${1}" >/dev/null 2>&1 ||
        fail "Invalid branch name: ${1}"
}

branch_exists() {
    git -C "${workdir}" show-ref --verify --quiet "refs/heads/${1}"
}

branch_checked_out() {
    git -C "${workdir}" worktree list --porcelain 2>/dev/null |
        grep -Fqx "branch refs/heads/${1}"
}

default_base() {
    (cd "${workdir}" && git-default 2>/dev/null) || current_branch "${workdir}"
}

resolve_base() {
    if [ -n "${base_arg}" ]; then
        base="${base_arg}"
    else
        base="$(prompt-input -p "Base:" -d "$(default_base)")" || fail "Base is required"
    fi
    [ -n "${base}" ] || fail "Base is required"
}

resolve_fetch() {
    case "${fetch_arg}" in
        yes)
            do_fetch=1
            return 0
            ;;
        no)
            do_fetch=0
            return 0
            ;;
    esac

    prompt-yes-no "Fetch ${base} before creating ${branch}?"
    case "${?}" in
        0)
            do_fetch=1
            ;;
        1)
            do_fetch=0
            ;;
        *)
            abort
            ;;
    esac
}

resolve_base_remote() {
    base_remote=""
    base_remote_ref=""
    base_is_local=1

    remote_candidate="${base%%/*}"
    if [ "${remote_candidate}" != "${base}" ] &&
        git -C "${workdir}" remote get-url "${remote_candidate}" >/dev/null 2>&1; then
        base_remote="${remote_candidate}"
        base_remote_ref="${base#*/}"
        base_is_local=0
        return 0
    fi

    if branch_exists "${base}"; then
        base_remote="$(git -C "${workdir}" config --get "branch.${base}.remote" 2>/dev/null)"
        base_remote_ref="$(git -C "${workdir}" config --get "branch.${base}.merge" 2>/dev/null)"
        base_remote_ref="${base_remote_ref#refs/heads/}"
    fi

    if [ -z "${base_remote}" ]; then
        for remote_name in $(git -C "${workdir}" remote); do
            if git -C "${workdir}" show-ref --verify --quiet "refs/remotes/${remote_name}/${base}"; then
                base_remote="${remote_name}"
                break
            fi
        done
    fi

    if [ -z "${base_remote}" ]; then
        if git -C "${workdir}" rev-parse --verify --quiet "${base}^{commit}" >/dev/null; then
            warning "No remote branch found for base ${base}, skipping fetch"
            return 1
        fi
        git -C "${workdir}" remote get-url origin >/dev/null 2>&1 ||
            { warning "No remote configured, skipping fetch"; return 1; }
        base_remote="origin"
    fi

    [ -n "${base_remote_ref}" ] || base_remote_ref="${base}"
}

fetch_base() {
    resolve_base_remote || return 0

    if [ "${base_is_local}" = "1" ] && ! branch_checked_out "${base}"; then
        git-color -C "${workdir}" fetch "${base_remote}" "${base_remote_ref}:${base}" 1>&2 ||
            fail "git fetch failed: ${base_remote} ${base_remote_ref}:${base}"
        return 0
    fi

    git-color -C "${workdir}" fetch "${base_remote}" "${base_remote_ref}" 1>&2 ||
        fail "git fetch failed: ${base_remote} ${base_remote_ref}"
    if [ "${base_is_local}" = "1" ]; then
        if git -C "${workdir}" rev-parse --verify --quiet "${base_remote}/${base_remote_ref}^{commit}" >/dev/null; then
            base="${base_remote}/${base_remote_ref}"
        else
            base="$(git -C "${workdir}" rev-parse --verify --quiet "FETCH_HEAD^{commit}")" ||
                fail "Cannot resolve fetched base: ${base_remote} ${base_remote_ref}"
        fi
    fi
}

resolve_branch() {
    if [ -n "${branch_arg}" ]; then
        branch="${branch_arg}"
    else
        current="$(current_branch "${workdir}")" || fail "Cannot determine current branch in workspace dir: ${workdir}"
        branch="$(prompt-input -p "Branch:" -d "${current}")" || fail "Branch is required"
    fi
    validate_branch_name "${branch}"
}

# The repository is resolved through git: the worktree the dir is in, wherever it
# lives, and the main tree, which git always lists first. Only the main tree has
# to be under WORKSPACE, as add mirrors its path.
resolve_workdir() {
    source_path="$(canonical_dir "${1}")" ||
        fail "Workdir does not exist: ${1}"
    require_git_repo "${source_path}"

    source_worktree="$(git -C "${source_path}" rev-parse --show-toplevel 2>/dev/null)" ||
        fail "Cannot resolve git root: ${source_path}"
    source_worktree="$(canonical_dir "${source_worktree}")" ||
        fail "Cannot resolve git root: ${source_path}"

    main_tree="$(git -C "${source_worktree}" worktree list --porcelain 2>/dev/null |
        sed -n "1s/^worktree //p")"
    workdir="$(canonical_dir "${main_tree}")" ||
        fail "Cannot resolve main tree: ${source_worktree}"
    inside_path "${workdir}" "${workspace_root}" ||
        fail "Main tree is not under WORKSPACE: ${workdir}"

    if [ "${source_worktree}" = "${workdir}" ]; then
        source_kind="main"
    else
        source_kind="linked"
    fi
}

target_path_for() {
    rel="$(relative_to "${workdir}" "${workspace_root}")"
    if [ -n "${rel}" ]; then
        echo "${workspace_worktree_root}/${rel}/${1}"
    else
        echo "${workspace_worktree_root}/${1}"
    fi
}

add_worktree() {
    target="$(target_path_for "${branch}")"
    create_branch=0

    if [ -e "${target}" ]; then
        if [ -d "${target}" ] &&
            git -C "${target}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            same_git_repo "${workdir}" "${target}" ||
                fail "Existing target belongs to a different git repository: ${target}"
            existing_branch="$(current_branch "${target}")" ||
                fail "Existing worktree is detached: ${target}"
            [ "${existing_branch}" = "${branch}" ] ||
                fail "Existing worktree is on ${existing_branch}, expected ${branch}: ${target}"
            echo "${target}"
            return 0
        fi
        fail "Target exists and is not a git worktree: ${target}"
    fi

    # --force below also lifts the guard against a branch checked out twice, so
    # only a stale registration of the target itself may already hold it
    checked_out_at="$(worktree_of_branch "${branch}")"
    if [ -n "${checked_out_at}" ] && [ "${checked_out_at}" != "${target}" ]; then
        fail "${branch} is already checked out at ${checked_out_at}"
    fi

    if ! branch_exists "${branch}"; then
        prompt-yes-no "Branch ${branch} does not exist. Create it?" || abort
        create_branch=1
        resolve_base
        resolve_fetch
        [ "${do_fetch}" = "1" ] && fetch_base
        git -C "${workdir}" rev-parse --verify --quiet "${base}^{commit}" >/dev/null ||
            fail "Base is not a valid commit-ish: ${base}"
    else
        [ -z "${base_arg}" ] || warning "Branch ${branch} already exists, ignoring --base"
        [ -z "${fetch_arg}" ] || warning "Branch ${branch} already exists, ignoring --fetch/--no-fetch"
    fi

    mkdir -p "$(dirname "${target}")" ||
        fail "Cannot create parent dir for target: ${target}"
    if [ "${create_branch}" = "1" ]; then
        git -C "${workdir}" worktree add --force --quiet -b "${branch}" "${target}" "${base}" >/dev/null ||
            fail "git worktree add failed"
    else
        git -C "${workdir}" worktree add --force --quiet "${target}" "${branch}" >/dev/null ||
            fail "git worktree add failed"
    fi
    echo "${target}"
}

# Every worktree the repository registers, wherever it lives, one
# "path<TAB>head<TAB>is_main<TAB>prunable<TAB>branch" row each. The branch goes
# last as it is empty for a detached HEAD, and read merges adjacent tabs.
worktree_rows() {
    worktree_output="$(git -C "${workdir}" worktree list --porcelain)" ||
        fail "git worktree list failed"
    printf "%s\n" "${worktree_output}" |
        awk '
            function flush() {
                if (path != "" && !bare)
                    printf "%s\t%s\t%d\t%d\t%s\n", path, head, is_main, prunable, branch
                path = ""
                head = ""
                branch = ""
                bare = 0
                prunable = 0
            }
            /^worktree / {
                flush()
                path = substr($0, 10)
                is_main = ++count == 1
                next
            }
            /^HEAD / {
                head = substr($0, 6, 7)
                next
            }
            /^branch / {
                branch = substr($0, 8)
                sub("^refs/heads/", "", branch)
                next
            }
            /^bare$/ {
                bare = 1
                next
            }
            /^prunable/ {
                prunable = 1
                next
            }
            END {
                flush()
            }
        '
}

format_worktree_row() {
    if [ -n "${5}" ]; then
        entry="$(printf "%s %s [%s]" "${1}" "${2}" "${5}")"
    else
        entry="$(printf "%s %s (detached HEAD)" "${1}" "${2}")"
    fi
    if [ "${3}" = "1" ]; then
        entry="${entry} (main tree)"
    fi
    if [ "${4}" = "1" ]; then
        entry="${entry} (prunable)"
    fi
    echo "${entry}"
}

mirror_dir_for_workdir() {
    rel="$(relative_to "${workdir}" "${workspace_root}")"
    if [ -n "${rel}" ]; then
        echo "${workspace_worktree_root}/${rel}"
    else
        echo "${workspace_worktree_root}"
    fi
}

mirror_gitdir_of() {
    [ -f "${1}/.git" ] || return 1
    sed -n "s/^gitdir: //p" "${1}/.git" | head -n 1
}

unregistered_mirror_worktrees() {
    mirror_dir="$(mirror_dir_for_workdir)"
    [ -d "${mirror_dir}" ] || return 0
    repo_common_dir="$(git_common_dir "${workdir}")" || return 0

    find "${mirror_dir}" -mindepth 2 -name .git -print 2>/dev/null |
        sed "s|/\.git$||" |
        sort |
        while IFS= read -r candidate; do
            printf "%s\n" "${1}" | grep -Fqx "${candidate}" && continue
            candidate_gitdir="$(mirror_gitdir_of "${candidate}")" || continue
            case "${candidate_gitdir}" in
                "${repo_common_dir}"/*)
                    ;;
                *)
                    continue
                    ;;
            esac
            printf "%s (unregistered)\n" "${candidate}"
        done
}

list_worktrees() {
    rows="$(worktree_rows)" || exit 1
    printf "%s\n" "${rows}" |
        while IFS="$(printf "\t")" read -r path head is_main prunable branch; do
            [ -n "${path}" ] || continue
            format_worktree_row "${path}" "${head}" "${is_main}" "${prunable}" "${branch}"
        done
    unregistered_mirror_worktrees "$(printf "%s\n" "${rows}" | cut -f1)"
}

worktree_of_branch() {
    rows="$(worktree_rows)" || exit 1
    printf "%s\n" "${rows}" |
        awk -F "\t" -v branch="${1}" '$5 == branch { print $1; exit }'
}

# Picker items "path<TAB>title", never the worktree the run started in. go (${1})
# offers the main tree but no prunable worktree, as there is no dir to change
# into, delete the other way round. A worktree outside the mirrored dir of the
# repository names its path in the title.
worktree_items() {
    mirror_dir="$(mirror_dir_for_workdir)"
    rows="$(worktree_rows)" || exit 1
    printf "%s\n" "${rows}" |
        while IFS="$(printf "\t")" read -r path head is_main prunable branch; do
            [ -n "${path}" ] || continue
            [ "${path}" = "${source_worktree}" ] && continue
            if [ "${1}" = "go" ]; then
                [ "${prunable}" = "1" ] && continue
            else
                [ "${is_main}" = "1" ] && continue
            fi
            if [ -n "${branch}" ]; then
                title="${branch}"
            else
                title="${head} (detached HEAD)"
            fi
            if [ "${is_main}" = "1" ]; then
                title="${title} (main tree)"
            elif ! inside_path "${path}" "${mirror_dir}"; then
                title="${title} (${path})"
            fi
            [ "${prunable}" = "1" ] && title="${title} (prunable)"
            printf "%s\t%s\n" "${path}" "${title}"
        done
}

pick_worktree() {
    need_cmd prompt-select
    items="$(worktree_items "${mode}")" || exit 1
    [ -n "${items}" ] || fail "${2}"
    target="$(printf "%s\n" "${items}" |
        prompt-select --prompt "${1}" --delimiter "\t")" || abort
    [ -n "${target}" ] || abort
}

go_worktree() {
    if [ -n "${branch_arg}" ]; then
        target="$(worktree_of_branch "${branch}")"
        [ -n "${target}" ] || fail "No worktree has ${branch} checked out"
        [ -d "${target}" ] || fail "Worktree does not exist: ${target}"
    else
        pick_worktree "Go to:" "No other worktree to go to"
    fi
    echo "${target}"
}

delete_worktree() {
    if [ -n "${branch_arg}" ]; then
        target="$(worktree_of_branch "${branch}")"
        [ -n "${target}" ] || fail "No worktree has ${branch} checked out"
    elif [ "${source_kind}" = "linked" ]; then
        target="${source_worktree}"
    else
        pick_worktree "Delete:" "No worktree to delete"
    fi

    [ "${target}" != "${workdir}" ] || fail "Cannot delete the main tree: ${workdir}"
    git-color -C "${workdir}" worktree remove "${target}" ||
        fail "git worktree remove failed"
    echo "Deleted worktree: ${target}" 1>&2
    echo "${workdir}"
}

move_to_main() {
    [ "${source_kind}" = "linked" ] ||
        fail "move-to-main must run from a linked worktree or use --workdir"
    has_uncommitted_changes "${source_worktree}" ||
        fail "No uncommitted changes to move: ${source_worktree}"
    require_clean_tree "${workdir}" "Main tree"

    move_staged_patch="$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.staged.XXXXXX")" ||
        fail "Cannot create temp file"
    move_unstaged_patch="$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.unstaged.XXXXXX")" ||
        move_fail "Cannot create temp file"
    move_untracked_list="$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.untracked.XXXXXX")" ||
        move_fail "Cannot create temp file"
    move_untracked_tar="$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.untracked.XXXXXX.tar")" ||
        move_fail "Cannot create temp file"

    git -C "${source_worktree}" diff --no-color --cached --binary > "${move_staged_patch}" ||
        move_fail "Cannot generate staged diff"
    git -C "${source_worktree}" diff --no-color --binary > "${move_unstaged_patch}" ||
        move_fail "Cannot generate unstaged diff"
    git -C "${source_worktree}" ls-files --others --exclude-standard -z > "${move_untracked_list}" ||
        move_fail "Cannot list untracked files"

    if [ -s "${move_staged_patch}" ]; then
        git -C "${workdir}" apply --check --index "${move_staged_patch}" ||
            move_fail "Cannot apply staged changes to main tree"
        git-color -C "${workdir}" apply --index "${move_staged_patch}" ||
            move_fail "Cannot apply staged changes to main tree"
    fi

    if [ -s "${move_unstaged_patch}" ]; then
        git -C "${workdir}" apply --check "${move_unstaged_patch}" ||
            rollback_move_fail "Cannot apply unstaged changes to main tree"
        git-color -C "${workdir}" apply "${move_unstaged_patch}" ||
            rollback_move_fail "Cannot apply unstaged changes to main tree"
    fi

    if [ -s "${move_untracked_list}" ]; then
        check_untracked_targets ||
            rollback_move_fail "Untracked target already exists in main tree: ${move_conflict_path}"
        copy_untracked_files ||
            rollback_move_fail "Cannot copy untracked files to main tree"
    fi

    git -C "${source_worktree}" reset --hard >/dev/null ||
        move_fail "Changes copied, but source worktree reset failed: ${source_worktree}"
    git -C "${source_worktree}" clean -fd >/dev/null ||
        move_fail "Changes copied, but source worktree clean failed: ${source_worktree}"

    cleanup_move_files
    echo "${workdir}"
}

RM_CMD="$(command -v trash 2>/dev/null || command -v rm 2>/dev/null)"
mode="add"
command_seen=0
branch_arg=""
base_arg=""
base=""
fetch_arg=""
do_fetch=0
workdir_arg=""

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        -b|--branch)
            shift
            [ -z "${1}" ] && usage
            branch_arg="${1}"
            ;;
        -B|--base)
            shift
            [ -z "${1}" ] && usage
            base_arg="${1}"
            ;;
        --fetch)
            fetch_arg="yes"
            ;;
        --no-fetch)
            fetch_arg="no"
            ;;
        -w|--workdir)
            shift
            [ -z "${1}" ] && usage
            workdir_arg="${1}"
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            set_command "${1}"
            ;;
    esac
    shift
done

[ -n "${WORKSPACE:-}" ] || fail "WORKSPACE is not set"
[ -n "${WORKSPACE_WORKTREE:-}" ] || fail "WORKSPACE_WORKTREE is not set"

workspace_root="$(canonical_dir "${WORKSPACE}")" ||
    fail "WORKSPACE does not exist: ${WORKSPACE}"
mkdir -p "${WORKSPACE_WORKTREE}" ||
    fail "Cannot create WORKSPACE_WORKTREE: ${WORKSPACE_WORKTREE}"
workspace_worktree_root="$(canonical_dir "${WORKSPACE_WORKTREE}")" ||
    fail "WORKSPACE_WORKTREE does not exist: ${WORKSPACE_WORKTREE}"

if [ -n "${workdir_arg}" ]; then
    resolve_workdir "${workdir_arg}"
else
    resolve_workdir "$(pwd -P)"
fi

if [ "${mode}" != "add" ]; then
    [ -z "${base_arg}" ] || fail "--base can only be used with add"
    [ -z "${fetch_arg}" ] || fail "--fetch/--no-fetch can only be used with add"
fi

case "${mode}" in
    add)
        resolve_branch
        add_worktree
        ;;
    list)
        [ -z "${branch_arg}" ] || fail "--branch cannot be used with list"
        list_worktrees
        ;;
    go)
        [ -z "${branch_arg}" ] || resolve_branch
        go_worktree
        ;;
    delete)
        [ -z "${branch_arg}" ] || resolve_branch
        delete_worktree
        ;;
    move-to-main)
        [ -z "${branch_arg}" ] || fail "--branch cannot be used with move-to-main"
        move_to_main
        ;;
esac
