#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }

APP_NAME="$(basename "${0}")"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} [OPTIONS] [BRANCH]

Move local changes to a new branch.

Uncommitted changes (staged, unstaged and untracked files) are carried over to
BRANCH, leaving the current branch clean. Unpushed commits can be moved as well,
resetting the current branch back to its upstream.

Changes are never written to temporary files: if BRANCH starts at the current
commit they are simply carried along by the branch switch, otherwise they are
parked in a stash which is only dropped after it applied cleanly.

BRANCH          Name of the branch to create. Prompted for if omitted.

Options:
    -b, --base <ref>    Create BRANCH from <ref> instead of the current commit
    -c, --with-commits  Also move unpushed commits and reset the current branch
                        back to its upstream
    -C, --no-commits    Keep unpushed commits on the current branch, don't ask
    -y, --yes           Run without prompting
    -h, --help          Show this help
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 1
}

# Ask a yes/no question, honouring --yes. Ctrl-C always aborts.
confirm() {
    local answer_default="${2}"
    [ "${assume_yes}" -eq 1 ] && return 0
    if [ "${answer_default}" == "yes" ]; then
        prompt-yes-no "${1}"
    else
        prompt-no-yes "${1}"
    fi
    local exit_code=$?
    [ ${exit_code} -eq 130 ] && abort
    return ${exit_code}
}

# Print the stash entry reference (e.g. "stash@{1}") pointing at the given commit.
stash_ref_of() {
    local sha="${1}" ref
    while read -r ref; do
        [ -z "${ref}" ] && continue
        if [ "$(git -C "${git_dir}" rev-parse --verify --quiet "${ref}")" == "${sha}" ]; then
            echo "${ref}"
            return 0
        fi
    done < <(git -C "${git_dir}" stash list --format='%gd' 2>/dev/null)
    return 1
}

# Re-apply the stash. Restores the staged/unstaged split when something was staged.
apply_stash() {
    local sha="${1}"
    if [ "${had_staged}" -eq 1 ]; then
        git -C "${git_dir}" stash apply --index "${sha}"
    else
        git -C "${git_dir}" stash apply "${sha}"
    fi
}

drop_stash() {
    local sha="${1}" ref
    ref="$(stash_ref_of "${sha}")" || {
        warning "Could not locate stash entry ${sha}, leaving it in place."
        return 1
    }
    git -C "${git_dir}" stash drop "${ref}" 1>/dev/null
}

# Undo whatever we already did and put the changes back on the source branch.
rollback() {
    if [ "${did_reset}" -eq 1 ]; then
        git -C "${git_dir}" reset --hard "${head_sha}" 1>/dev/null || \
            error "Failed to restore \"${source_name}\" to ${head_sha}."
        did_reset=0
    fi
    if [ "${created_branch}" -eq 1 ]; then
        git -C "${git_dir}" branch -D "${branch}" 1>/dev/null 2>&1
        created_branch=0
    fi
    if [ -n "${stash_sha}" ]; then
        if apply_stash "${stash_sha}"; then
            drop_stash "${stash_sha}"
            stash_sha=""
        else
            error "Your changes are kept in the stash: ${stash_sha}"
            error "Restore them with: git stash apply ${stash_sha}"
        fi
    fi
}

branch=""
base_ref=""
move_commits=-1
assume_yes=0

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        -b|--base)
            shift
            [ -z "${1}" ] && { error "Missing value for --base"; usage; }
            base_ref="${1}"
            ;;
        -c|--with-commits)
            move_commits=1
            ;;
        -C|--no-commits)
            move_commits=0
            ;;
        -y|--yes)
            assume_yes=1
            ;;
        -*)
            error "Unknown option: ${1}"
            usage
            ;;
        *)
            if [ -n "${branch}" ]; then
                error "Unexpected argument: ${1}"
                usage
            fi
            branch="${1}"
            ;;
    esac
    shift
done

if [ -n "${base_ref}" ] && [ "${move_commits}" -eq 1 ]; then
    error "Cannot use --base and --with-commits together"
    usage
fi

command -v prompt-yes-no 1>/dev/null || fail "Required helper \"prompt-yes-no\" not found."

git_dir="$(git rev-parse --show-toplevel)" || fail "Not a git repo?"

head_sha="$(git -C "${git_dir}" rev-parse --verify HEAD 2>/dev/null)" || \
    fail "No commit found, cannot move changes out of an empty repository."
current_branch="$(git -C "${git_dir}" branch --show-current)"
source_name="${current_branch}"
[ -z "${source_name}" ] && source_name="${head_sha:0:12} (detached HEAD)"

# What is there to move?
had_staged=0
git -C "${git_dir}" diff --cached --quiet || had_staged=1
has_changes=0
[ -n "$(git -C "${git_dir}" status --porcelain 2>/dev/null)" ] && has_changes=1

# Which commits are local only?
unpushed_base=""
unpushed_count=0
if upstream="$(git -C "${git_dir}" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" && [ -n "${upstream}" ]; then
    unpushed_base="${upstream}"
elif default_branch="$(git-default --fqn 2>/dev/null)" && [ -n "${default_branch}" ]; then
    unpushed_base="${default_branch}"
fi
if [ -n "${unpushed_base}" ]; then
    unpushed_count="$(git -C "${git_dir}" rev-list --count "${unpushed_base}..HEAD" 2>/dev/null)"
    [ -z "${unpushed_count}" ] && unpushed_count=0
fi

if [ "${move_commits}" -eq 1 ] && [ "${unpushed_count}" -eq 0 ]; then
    fail "No unpushed commits found on \"${source_name}\"."
fi

if [ "${has_changes}" -eq 0 ] && [ "${move_commits}" -ne 1 ]; then
    if [ "${unpushed_count}" -gt 0 ] && [ "${move_commits}" -eq -1 ]; then
        move_commits=1
    else
        fail "No local changes to move."
    fi
fi

# Offer to take the unpushed commits along.
if [ "${move_commits}" -eq -1 ]; then
    if [ "${unpushed_count}" -gt 0 ]; then
        warning "\"${source_name}\" has ${unpushed_count} commit(s) not in \"${unpushed_base}\""
        git -C "${git_dir}" log --oneline "${unpushed_base}..HEAD"
        echo
        if [ "${assume_yes}" -eq 1 ]; then
            move_commits=0
        else
            confirm "Move those commits to the new branch too?" && move_commits=1 || move_commits=0
        fi
    else
        move_commits=0
    fi
fi

reset_point=""
if [ "${move_commits}" -eq 1 ]; then
    reset_point="$(git -C "${git_dir}" merge-base HEAD "${unpushed_base}")" || \
        fail "Failed to determine the fork point from \"${unpushed_base}\"."
    [ -z "${current_branch}" ] && fail "Cannot move commits off a detached HEAD."
fi

# Ask for the branch name, suggesting one based on the changes.
if [ -z "${branch}" ]; then
    prompt_args=( "--single-line" "--prompt" "Enter branch name:" )
    if command -v cmai 1>/dev/null; then
        cmai_args=( "--branch-name-only" )
        if [ "${has_changes}" -eq 1 ]; then
            cmai_args+=( "--unstaged" )
        else
            cmai_args+=( "--diff" "${reset_point}...HEAD" )
        fi
        suggestion="$(timeout 10 cmai "${cmai_args[@]}" 2>/dev/null)"; exit_code=$?
        [ ${exit_code} -eq 0 ] && [ -n "${suggestion}" ] && prompt_args+=( "--default" "${suggestion}" )
    fi
    branch="$(prompt "${prompt_args[@]}")" || abort
    [ -z "${branch}" ] && abort
fi

git -C "${git_dir}" check-ref-format --branch "${branch}" 1>/dev/null 2>&1 || \
    fail "Not a valid branch name: ${branch}"
[ "${branch}" == "${current_branch}" ] && fail "Already on branch \"${branch}\"."

# Resolve where the new branch will start.
use_existing=0
if git -C "${git_dir}" show-ref --verify --quiet "refs/heads/${branch}"; then
    [ -n "${base_ref}" ] && warning "Branch \"${branch}\" already exists, ignoring --base."
    confirm "Branch \"${branch}\" already exists. Move the changes onto it?" || abort
    use_existing=1
    target_sha="$(git -C "${git_dir}" rev-parse --verify "refs/heads/${branch}")"
else
    if [ -n "${base_ref}" ]; then
        target_sha="$(git -C "${git_dir}" rev-parse --verify "${base_ref}^{commit}" 2>/dev/null)" || \
            fail "Not a valid base: ${base_ref}"
    else
        target_sha="${head_sha}"
    fi
fi

if [ "${move_commits}" -eq 1 ] && [ "${target_sha}" != "${head_sha}" ]; then
    fail "Branch \"${branch}\" does not start at the current commit, the unpushed commits would be lost."
fi

echo "Source: ${source_name}" 1>&2
echo "Target: ${branch} ($(git -C "${git_dir}" log -1 --format='%h %s' "${target_sha}"))" 1>&2
[ "${has_changes}" -eq 1 ] && git -C "${git_dir}" status --short 1>&2
echo 1>&2

message="Move local changes to \"${branch}\"?"
if [ "${move_commits}" -eq 1 ]; then
    message="Move local changes and ${unpushed_count} commit(s) to \"${branch}\" and reset \"${source_name}\" to $(git -C "${git_dir}" log -1 --format='%h' "${reset_point}")?"
fi
confirm "${message}" "yes" || abort

# A stash is only needed when the working tree cannot simply travel along with
# the branch switch, i.e. when the new branch starts somewhere else.
need_stash=0
if [ "${has_changes}" -eq 1 ] && { [ "${move_commits}" -eq 1 ] || [ "${target_sha}" != "${head_sha}" ]; }; then
    need_stash=1
fi

stash_sha=""
created_branch=0
did_reset=0

if [ "${need_stash}" -eq 1 ]; then
    stash_before="$(git -C "${git_dir}" rev-parse --verify --quiet refs/stash)"
    git -C "${git_dir}" stash push --include-untracked --message "${APP_NAME}: ${source_name} -> ${branch}" 1>/dev/null || \
        fail "Failed to stash local changes."
    stash_sha="$(git -C "${git_dir}" rev-parse --verify --quiet refs/stash)"
    if [ -z "${stash_sha}" ] || [ "${stash_sha}" == "${stash_before}" ]; then
        stash_sha=""
        fail "Failed to stash local changes."
    fi
    echo "Stashed local changes: ${stash_sha}" 1>&2
fi

if [ "${use_existing}" -eq 0 ]; then
    if ! git -C "${git_dir}" branch "${branch}" "${target_sha}"; then
        error "Failed to create branch \"${branch}\"."
        rollback
        exit 1
    fi
    created_branch=1
fi

if [ "${move_commits}" -eq 1 ]; then
    if ! git -C "${git_dir}" reset --hard "${reset_point}" 1>/dev/null; then
        error "Failed to reset \"${source_name}\" to ${reset_point}."
        rollback
        exit 1
    fi
    did_reset=1
    echo "Reset \"${source_name}\" to $(git -C "${git_dir}" log -1 --format='%h %s' "${reset_point}")" 1>&2
fi

if ! git -C "${git_dir}" switch "${branch}"; then
    error "Failed to switch to branch \"${branch}\"."
    rollback
    exit 1
fi
# From here on the commits live on ${branch}, so the reset is no longer undone.
did_reset=0
created_branch=0

if [ -n "${stash_sha}" ]; then
    if apply_stash "${stash_sha}"; then
        drop_stash "${stash_sha}"
        stash_sha=""
    else
        echo 1>&2
        error "Failed to apply the changes onto \"${branch}\"."
        error "Nothing is lost, they are still stashed as ${stash_sha}"
        stash_ref="$(stash_ref_of "${stash_sha}")" && \
            error "Resolve the conflicts, then drop the stash with: git stash drop ${stash_ref}"
        exit 1
    fi
fi

echo 1>&2
echo "Moved local changes to \"${branch}\"." 1>&2
git -C "${git_dir}" status --short --branch 1>&2
