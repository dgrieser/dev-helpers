# bash completion for dev-helpers commands
# Installed once per completed command name so bash-completion can lazy-load it.
#
# Aliases and wrapper functions don't trigger lazy loading (bash looks up the
# typed name, not the expansion). To complete them, source this file from your
# shell rc after defining the aliases and map them:
#
#   source /usr/local/share/bash-completion/completions/dev-helpers
#   __dh_register_aliases                    # auto-map aliases to git-* commands
#   __dh_complete_alias g git-find-repo      # map wrapper functions explicitly

# Map NAME to the completion of a dev-helpers command: __dh_complete_alias <name> <command>
__dh_complete_alias()
{
    declare -F "_${2}" >/dev/null || return 1
    # git-color hands over to git's own completion, which needs the same
    # complete options git registers itself
    case "${2}" in
        git-color) complete -o bashdefault -o default -o nospace -F "_${2}" "${1}" ;;
        *) complete -F "_${2}" "${1}" ;;
    esac
}

# Register completions for all defined aliases whose expansion starts with a
# git-* command completed in this file, e.g. alias gco='git-checkout'.
__dh_register_aliases()
{
    local line name target
    while IFS= read -r line; do
        name="${line#alias }"
        name="${name%%=*}"
        target="${line#*=\'}"
        target="${target%%[\'; ]*}"
        [[ "${target}" == git-* ]] && __dh_complete_alias "${name}" "${target}"
    done < <(alias -p)
    return 0
}

__dh_local_branches()
{
    LC_ALL=C git branch --list --format='%(refname:short)' 2>/dev/null
}

__dh_all_branches()
{
    {
        LC_ALL=C git branch --list --format='%(refname:short)'
        LC_ALL=C git branch --list --remotes --format='%(refname:lstrip=2)' | grep -v 'HEAD' | sed 's|^origin/||'
    } 2>/dev/null | sort -u
}

__dh_tags()
{
    LC_ALL=C git tag --sort=-v:refname 2>/dev/null
}

__dh_commits()
{
    LC_ALL=C git log --max-count=50 --pretty=format:'%h' 2>/dev/null
}

__dh_projects()
{
    git-find-repo --list 2>/dev/null
}

__dh_changed_files()
{
    LC_ALL=C git status --porcelain 2>/dev/null | cut -c4-
}

__dh_git_commands()
{
    LC_ALL=C git --list-cmds=list-mainporcelain,others 2>/dev/null \
        || LC_ALL=C git help -a 2>/dev/null | awk '/^   [a-z]/{print $1}'
}

# Load git's own completion, which bash-completion only lazy-loads once "git"
# itself was completed. Returns non-zero when there is none to load.
__dh_load_git_completion()
{
    declare -F __git_main >/dev/null && return 0
    declare -F _git >/dev/null && return 0
    # the loaders return 124 to ask bash for a retry, which is none of our
    # business here, so the status is dropped
    if declare -F _comp_load >/dev/null; then
        _comp_load git
    elif declare -F __load_completion >/dev/null; then
        __load_completion git
    elif declare -F _completion_loader >/dev/null; then
        _completion_loader git
    fi
    if ! declare -F __git_main >/dev/null && ! declare -F _git >/dev/null; then
        local candidate
        for candidate in /usr/share/bash-completion/completions/git \
                         /usr/local/share/bash-completion/completions/git \
                         /usr/share/git/completion/git-completion.bash \
                         /etc/bash_completion.d/git; do
            [ -r "${candidate}" ] && . "${candidate}" && break
        done
    fi
    declare -F __git_main >/dev/null || declare -F _git >/dev/null
}

# Complete the git command line that starts at word INDEX with git's own
# completion: git-color takes a git command line, so everything behind its own
# options is git's business. git's completion ignores the name it was invoked
# under, so as long as INDEX is 1 the line can be handed over as it is.
__dh_git_delegate()
{
    local index="${1}"
    __dh_load_git_completion || return 1
    local -a saved_words=( "${COMP_WORDS[@]}" )
    local saved_cword="${COMP_CWORD}"
    local saved_line="${COMP_LINE}" saved_point="${COMP_POINT}"
    if [ "${index}" -gt 1 ]; then
        # git-color's own options have to leave the line as well, and not only
        # the word list: bash-completion reads the word under the cursor off
        # COMP_LINE and COMP_POINT
        local offset=0 i
        for (( i = 0; i < index; i++ )); do
            while [ "${COMP_LINE:offset:1}" = " " ]; do offset=$(( offset + 1 )); done
            offset=$(( offset + ${#saved_words[i]} ))
        done
        COMP_WORDS=( git "${saved_words[@]:index}" )
        COMP_CWORD=$(( saved_cword - index + 1 ))
        COMP_LINE="git${COMP_LINE:offset}"
        COMP_POINT=$(( saved_point - offset + 3 ))
    fi
    if declare -F __git_func_wrap >/dev/null && declare -F __git_main >/dev/null; then
        __git_func_wrap __git_main
    elif declare -F __git_wrap__git_main >/dev/null; then
        __git_wrap__git_main
    else
        _git
    fi
    COMP_WORDS=( "${saved_words[@]}" )
    COMP_CWORD="${saved_cword}"
    COMP_LINE="${saved_line}"
    COMP_POINT="${saved_point}"
    return 0
}

__dh_compgen()
{
    COMPREPLY=( $(compgen -W "${1}" -- "${cur}") )
}

__dh_files()
{
    COMPREPLY=( $(compgen -f -- "${cur}") )
    compopt -o filenames 2>/dev/null
}

__dh_dirs()
{
    COMPREPLY=( $(compgen -d -- "${cur}") )
    compopt -o filenames 2>/dev/null
}

__dh_init()
{
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
}

_git-activity-to-issue()
{
    local cur prev
    __dh_init
    case "${prev}" in
        --start|--end|--per-page|--max-pages|--time-spent-slot-minutes|--filter) return 0 ;;
        --issue-group|--issue-project|--issue-limit) return 0 ;;
        --issue-state) __dh_compgen "opened closed all"; return 0 ;;
    esac
    __dh_compgen "--start --end --per-page --max-pages --json-array --time-spent --time-spent-book --interactive --issue-group --issue-project --issue-limit --issue-state --issue-refresh --time-spent-slot-minutes --filter -v --verbose -h --help"
    return 0
}
complete -F _git-activity-to-issue git-activity-to-issue

_git-add()
{
    local cur prev
    __dh_init
    case "${prev}" in
        -q|--query) return 0 ;;
        -s|--stage|-u|--unstage|-d|--delete|-r|--reset|-i|--ignore)
            __dh_compgen "$(__dh_changed_files)"
            return 0 ;;
    esac
    if [[ "${cur}" == -* ]]; then
        __dh_compgen "-h --help -p --print -q --query -s --stage -u --unstage -d --delete -r --reset -i --ignore"
    else
        __dh_files
    fi
    return 0
}
complete -F _git-add git-add

_git-blame()
{
    local cur prev
    __dh_init
    case "${prev}" in
        -r|--ref|--ignore-rev)
            __dh_compgen "$(__dh_all_branches) $(__dh_tags) $(__dh_commits)"
            return 0 ;;
        --ignore-revs-file)
            __dh_files
            return 0 ;;
        -o|--output-dir)
            __dh_dirs
            return 0 ;;
        -q|--query|-L|--lines) return 0 ;;
    esac
    if [[ "${cur}" == -* ]]; then
        __dh_compgen "-h --help --print -q --query -r --ref -L --lines \
                      -w --ignore-whitespace -M -C --ignore-rev \
                      --ignore-revs-file -o --output-dir"
    else
        __dh_files
    fi
    return 0
}
complete -F _git-blame git-blame

