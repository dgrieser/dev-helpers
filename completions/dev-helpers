_git-color()
{
    local cur prev
    __dh_init
    case "${prev}" in
        --color|--pager)
            compopt +o nospace 2>/dev/null
            __dh_compgen "auto always never"
            return 0 ;;
    esac
    # walk over git-color's own options to find where the git command line begins
    local index=1
    while [ "${index}" -lt "${COMP_CWORD}" ]; do
        case "${COMP_WORDS[index]}" in
            --color|--pager) index=$(( index + 2 )) ;;
            --color=*|--pager=*|--raw|-h|--help) index=$(( index + 1 )) ;;
            --) index=$(( index + 1 )); break ;;
            *) break ;;
        esac
    done
    if [ "${index}" -ge "${COMP_CWORD}" ] && [[ "${cur}" == -* ]]; then
        compopt +o nospace 2>/dev/null
        __dh_compgen "--color --pager --raw -h --help"
        return 0
    fi
    __dh_git_delegate "${index}" && return 0
    # no git completion installed, so complete at least the command itself
    compopt +o nospace 2>/dev/null
    if [ "${index}" -eq "${COMP_CWORD}" ]; then
        __dh_compgen "$(__dh_git_commands)"
    else
        __dh_compgen "$(__dh_all_branches) $(__dh_changed_files)"
    fi
    return 0
}
complete -o bashdefault -o default -o nospace -F _git-color git-color

