#!/bin/bash

APP_NAME="$(basename "${0}")"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<EOF
usage: ${APP_NAME} [-u|--unstaged] [-d|--diff <diff>]

Prints a branch name from git branch-ai without creating a branch.
Uses staged changes by default. --unstaged uses unstaged and untracked
changes, and --diff uses the specified diff, for example main...HEAD.
EOF
    exit 0
fi

if ! command -v git-branch-ai >/dev/null; then
    print-text-muted "git branch-ai not found. Install it with updater git-commit-ai." >&2
    exit 127
fi

exec git branch-ai --print "${@}"
