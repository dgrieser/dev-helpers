#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }

APP_NAME="$(basename "${0}")"

PER_PAGE_DEFAULT=20
WATCH_SECONDS_DEFAULT=5
WATCH_FIRST_DELAY=10
# a pipeline a push just triggered may not be there yet, see wait_for_pipelines
WAIT_SECONDS_DEFAULT=30
WAIT_POLL_SECONDS=3
# how many of the most recent tags to include pipelines for, and how many
# pipelines to fetch per tag
TAG_LIMIT_DEFAULT=3
TAG_PER_PAGE=20

NL=$'\n'
CR=$'\r'
TAB=$'\t'
C_ID=$'\033[33m'
C_FILTER=$'\033[38;5;208m'
C_LABEL=$'\033[38;5;250m'
C_RESET=$'\033[0m'
# the id and the URL are in the list for the search and for the keys, the picker
# shows neither of them (see PICKER_COLUMNS)
HEADER="ID  STATUS  SOURCE  REF  USER  CREATED  URL"
PICKER_COLUMNS="2,3,4,5,6"
# only enter ends the pipeline list, and only to open the jobs of a pipeline: the
# log pager gets the terminal handed over, the browser and the clipboard are
# silent, and the status filter reloads the list it narrows down
KEYS="esc,ctrl-c,ctrl-d,enter"
EXEC_KEYS="ctrl-l"
SILENT_KEYS="ctrl-o,ctrl-y"
RELOAD_KEYS="tab,ctrl-r"
KEY_DESCS="enter:jobs,tab:running only,ctrl-r:refresh,ctrl-y:copy url,ctrl-o:open,ctrl-l:logs"
KEY_DESCS_HELP="enter jobs, tab running only, ctrl-r refresh, ctrl-y copy url, ctrl-o open, ctrl-l logs"

# the jobs of a pipeline, opened with enter: the log pager gets the terminal
# handed over, the browser and the clipboard are silent, esc returns to the
# pipeline list and ctrl-c/ctrl-d leave both
JOBS_KEYS="esc,ctrl-c,ctrl-d"
JOBS_EXEC_KEYS="enter"
JOBS_SILENT_KEYS="ctrl-o,ctrl-y"
JOBS_KEY_DESCS="enter:log,ctrl-y:copy url,ctrl-o:open,esc:back"
JOBS_KEY_DESCS_HELP="enter log, ctrl-y copy url, ctrl-o open, esc back"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} COMMAND [OPTIONS]

Show and search GitLab CI or GitHub Actions pipeline information for a repository.

In addition to the pipelines of the selected ref, the pipelines of the ${TAG_LIMIT_DEFAULT} most
recent tags are included (see --tags/--no-tags).

Results are shown in an interactive picker (keys: ${KEY_DESCS_HELP}).
tab narrows the list down to the pipelines that are still running and back.
The picker reloads once ${WATCH_FIRST_DELAY} seconds after it opened, then keeps reloading
as long as pipelines are still running. A reload fetches the pipelines of the
ref and of the most recent tag; ctrl-r fetches everything again, the tag list
and the older tags included. Once the reloading stopped, a manual refresh that
brings up a running pipeline resumes it.

enter steps into a pipeline and opens a picker with its jobs, the details and
the tail of the log of the selected job in the preview (keys: ${JOBS_KEY_DESCS_HELP}).
The log of a job that is still running is shown as it grows; on GitHub the
logs of a job only become available once it finished, so its steps take their
place until then.

COMMAND
    status                  show CI pipeline status for a ref
    search                  list pipelines matching variable, log, or status filters

Options:
    -h|--help               show this help
    -r|--repo <PROJECT>     project to operate on (default: current directory)
    -j|--jobs <PIPELINE_ID> open the jobs of a pipeline instead of the pipeline list
        --ref <REF>         ref to filter by (default: current branch)
        --tags <N>          also show the pipelines of the N most recent tags
                            (default ${TAG_LIMIT_DEFAULT}, 0 disables)
        --no-tags           shorthand for --tags 0
    -q|--query <QUERY>      start the picker with a search query
    -p|--print              print the result table instead of opening the picker
    -w|--watch <SECONDS>    reload interval while pipelines are still running
                            (default ${WATCH_SECONDS_DEFAULT}, 0 disables auto-reloading)
        --wait [SECONDS]    wait up to SECONDS for a pipeline to show up instead
                            of reporting none right away; a pipeline a push just
                            triggered takes a moment to exist
                            (default ${WAIT_SECONDS_DEFAULT} when no value is given)

search options:
        --all-refs            do not filter by ref (search all refs)
        --var <NAME[=VALUE]>  GitLab pipeline has variable NAME (optionally equal to VALUE);
                              repeatable, all must match (unsupported on GitHub)
        --grep <PATTERN>      keep pipelines whose job logs match PATTERN (extended regex, case-insensitive)
        --source <SOURCE>     filter by pipeline source (push, trigger, schedule, web, api, ...)
    -s|--status <STATUS>      filter by raw status (repeatable)
        --failed              shorthand for --status failed
        --succeeded           shorthand for --status success
        --aborted             shorthand for --status canceled
        --running             shorthand for --status running
        --pending             shorthand for --status pending
        --manual              shorthand for --status manual
        --skipped             shorthand for --status skipped
    -n|--limit <N>            results per page (1-100, default ${PER_PAGE_DEFAULT})
    -a|--all                  fetch all pages (overrides --limit window)
    -o|--output <txt|json>    output format: txt or json (default txt)
EOF
    exit 1
}

log() {
    echo "${1}" 1>&2
}

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 130
}

need_cmd() {
    command -v "${1}" >/dev/null 2>&1 || fail "missing required command: ${1}"
}

urlenc() {
    jq -rn --arg v "${1}" '$v|@uri'
}

build_qs() {
    [ "${#}" -eq 0 ] && return 0
    local IFS='&'
    printf '?%s' "$*"
}

project_id() {
    if [ -z "${PROJECT_ID:-}" ]; then
        PROJECT_ID="$(glab repo view -F json | jq -r '.id')"
        [ -z "${PROJECT_ID}" ] && fail "failed to determine GitLab project id"
        [ "${PROJECT_ID}" = "null" ] && fail "failed to determine GitLab project id"
    fi
    printf '%s\n' "${PROJECT_ID}"
}

repository_from_url() {
    local url="${1}"
    local repository

    url="${url%/}"
    url="${url%.git}"
    case "${url}" in
        *://*)
            repository="${url#*://}"
            repository="${repository#*@}"
            repository="${repository#*/}"
            ;;
        *@*:*)
            repository="${url#*:}"
            ;;
        *)
            return 1
            ;;
    esac

    [ "${repository}" = "${repository#*/}" ] && return 1
    printf '%s\n' "${repository}"
}

host_from_url() {
    local url="${1}"
    local host

    case "${url}" in
        *://*)
            host="${url#*://}"
            host="${host%%/*}"
            host="${host#*@}"
            ;;
        *@*:*)
            host="${url#*@}"
            host="${host%%:*}"
            ;;
        *)
            return 1
            ;;
    esac
    printf '%s\n' "${host}"
}

detect_provider() {
    local remote_url="${1}"
    local host

    host="$(host_from_url "${remote_url}")" || fail "failed to determine remote host"
    # the path of the project, which GitLab's GraphQL API takes instead of the id
    remote_repository="$(repository_from_url "${remote_url}")" \
        || fail "failed to determine the repository of ${remote_url}"
    if [[ "${host}" == *github* ]] \
        || [ -n "$(git config --get remote.origin.gh-resolved 2>/dev/null)" ]; then
        provider="github"
        github_repository="${remote_repository}"
        github_repo_selector="${github_repository}"
        github_api_args=()
        if [ "${host}" != "github.com" ]; then
            github_api_args+=("--hostname" "${host}")
            github_repo_selector="${host}/${github_repository}"
        fi
    else
        provider="gitlab"
    fi
}

cmd_status() {
    local pipelines
    pipelines="$(list_pipelines_json)" || fail "failed to list pipelines"
    merge_tag_pipelines "${pipelines}"
}

list_gitlab_pipelines_json() {
    local base
    base="projects/$(project_id)/pipelines"
    local common=("per_page=${per_page}" "order_by=id" "sort=desc")
    [ -n "${ref}" ] && common+=("ref=$(urlenc "${ref}")")
    [ -n "${source}" ] && common+=("source=$(urlenc "${source}")")

    local page_flag=()
    [ "${paginate}" -eq 1 ] && page_flag+=("--paginate")

    local out="[]" part qs s
    TRUNCATED=0
    if [ "${#statuses[@]}" -eq 0 ]; then
        qs="$(build_qs "${common[@]}")"
        part="$(glab api "${page_flag[@]}" "${base}${qs}")" || return 1
        # --paginate emits one array per page; slurp them into a single array
        part="$(jq -s 'add // []' <<< "${part}")"
        [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
        out="${part}"
    else
        for s in "${statuses[@]}"; do
            qs="$(build_qs "${common[@]}" "status=${s}")"
            part="$(glab api "${page_flag[@]}" "${base}${qs}")" || return 1
            part="$(jq -s 'add // []' <<< "${part}")"
            [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
            out="$(jq -s 'add' <(echo "${out}") <(echo "${part}"))"
        done
    fi
    jq 'unique_by(.id) | sort_by(.id) | reverse' <<< "${out}"
}

github_status() {
    case "${1}" in
        failed)    echo "failure" ;;
        canceled)  echo "cancelled" ;;
        running)   echo "in_progress" ;;
        manual)    echo "action_required" ;;
        *)         echo "${1}" ;;
    esac
}

list_github_pipelines_json() {
    local base="repos/${github_repository}/actions/runs"
    local common=("per_page=${per_page}")
    [ -n "${ref}" ] && common+=("branch=$(urlenc "${ref}")")
    [ -n "${source}" ] && common+=("event=$(urlenc "${source}")")

    local page_flag=()
    [ "${paginate}" -eq 1 ] && page_flag+=("--paginate")

    local out="[]" part qs s mapped_status
    TRUNCATED=0
    if [ "${#statuses[@]}" -eq 0 ]; then
        qs="$(build_qs "${common[@]}")"
        part="$(gh api "${github_api_args[@]}" "${page_flag[@]}" "${base}${qs}")" || return 1
        part="$(jq -s '[.[].workflow_runs[]]' <<< "${part}")"
        [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
        out="${part}"
    else
        for s in "${statuses[@]}"; do
            mapped_status="$(github_status "${s}")"
            qs="$(build_qs "${common[@]}" "status=$(urlenc "${mapped_status}")")"
            part="$(gh api "${github_api_args[@]}" "${page_flag[@]}" "${base}${qs}")" || return 1
            part="$(jq -s '[.[].workflow_runs[]]' <<< "${part}")"
            [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
            out="$(jq -s 'add' <(echo "${out}") <(echo "${part}"))"
        done
    fi
    jq '
        unique_by(.id)
        | sort_by(.id)
        | reverse
        | map({
            id,
            status: (if .status == "completed" then (.conclusion // .status) else .status end),
            source: .event,
            ref: .head_branch,
            user: (.triggering_actor.login // .actor.login // "-"),
            created_at,
            web_url: .html_url
        })
    ' <<< "${out}"
}

list_pipelines_json() {
    if [ "${provider}" = "github" ]; then
        list_github_pipelines_json
    else
        list_gitlab_pipelines_json
    fi
}

# GitLab's pipeline list does not carry the user who triggered a pipeline, and
# asking the REST API for it is one request per pipeline; GraphQL answers for a
# whole list of them at once
gitlab_user_map() {
    local ids_json="${1}"
    local gids query out

    gids="$(jq -r 'map("\"gid://gitlab/Ci::Pipeline/\(.)\"") | join(",")' <<< "${ids_json}")"
    [ -z "${gids}" ] && { echo '{}'; return 0; }
    query="{ project(fullPath: \"${remote_repository}\") { pipelines(ids: [${gids}]) { nodes { id user { username } } } } }"
    out="$(glab api graphql -f query="${query}" 2>/dev/null)" || return 1
    jq -e '.data.project.pipelines.nodes' <<< "${out}" >/dev/null 2>&1 || return 1
    jq -c '
        .data.project.pipelines.nodes
        | map({ key: (.id | sub("^.*/"; "")), value: (.user.username // "-") })
        | from_entries
    ' <<< "${out}"
}

# the user of a pipeline never changes, so every id is looked up once per run;
# the lookup is capped at what GraphQL returns per page
gitlab_annotate_users() {
    local json="${1}"
    local cache="{}" missing chunk map total i

    [ -s "${USERS_FILE}" ] && cache="$(cat "${USERS_FILE}")"
    missing="$(jq -c --argjson c "${cache}" '[ .[] | .id | tostring | select($c[.] == null) ]' <<< "${json}")"
    total="$(jq 'length' <<< "${missing}")"
    i=0
    while [ "${i}" -lt "${total}" ]; do
        chunk="$(jq -c --argjson i "${i}" '.[$i:$i+100]' <<< "${missing}")"
        i=$((i + 100))
        map="$(gitlab_user_map "${chunk}")" || continue
        # an id the answer says nothing about is not asked for again
        cache="$(jq -c -n --argjson c "${cache}" --argjson ids "${chunk}" --argjson m "${map}" \
            '$c + ($ids | map({ key: ., value: "-" }) | from_entries) + $m')"
    done
    printf '%s\n' "${cache}" > "${USERS_FILE}"
    jq --argjson c "${cache}" 'map(.user = ($c[.id | tostring] // "-"))' <<< "${json}"
}

annotate_users() {
    local json="${1}"

    # the runs of GitHub Actions name their actor themselves
    if [ "${provider}" = "github" ] || [ "$(jq 'length' <<< "${json}")" -eq 0 ]; then
        printf '%s\n' "${json}"
        return 0
    fi
    gitlab_annotate_users "${json}"
}

list_tag_names() {
    if [ "${provider}" = "github" ]; then
        gh api "${github_api_args[@]}" "repos/${github_repository}/tags?per_page=100" 2>/dev/null \
            | jq -r '.[].name'
    else
        glab api "projects/$(project_id)/repository/tags?per_page=100" 2>/dev/null \
            | jq -r '.[].name'
    fi
}

# the tags of a repository change rarely, and a reload of the picker is not what
# brings a new one, so the list is asked for once per run
cached_tag_names() {
    if [ ! -s "${TAGS_FILE}" ]; then
        list_tag_names | head -n "${tag_limit}" > "${TAGS_FILE}"
    fi
    cat "${TAGS_FILE}"
}

# Neither API can filter pipelines by "is a tag", so query the tags by ref - both
# providers accept a tag name where they take a branch/ref. That is one request
# per tag, and they wait for the network instead of for each other, so they run
# at once and every one of them answers into a file of its own.
fetch_tag_pipelines() {
    local tags="${1}"
    local dir tag out
    local i=0

    [ -z "${tags}" ] && { echo "[]"; return 0; }
    dir="$(mktemp -d)" || { echo "[]"; return 0; }
    while IFS= read -r tag; do
        [ -z "${tag}" ] && continue
        (
            # the query context of a tag belongs to its subshell alone, so the
            # ref and the window of the caller stay what they are and TRUNCATED
            # keeps naming the main query
            ref="${tag}"
            per_page="${TAG_PER_PAGE}"
            paginate=0
            part="$(list_pipelines_json 2>/dev/null)" || part="[]"
            [ -z "${part}" ] && part="[]"
            printf '%s\n' "${part}"
        ) > "${dir}/${i}" &
        i=$((i + 1))
    done <<< "${tags}"
    wait

    if [ "${i}" -eq 0 ]; then
        out="[]"
    else
        out="$(cat "${dir}"/* | jq -s 'add // []')" || out="[]"
    fi
    rm -rf "${dir}"
    printf '%s\n' "${out}"
}

# The pipelines of a tag that is not the most recent one are done with, so they
# are fetched once and read back from the cache by every reload after that; only
# the newest tag can still have something running, so only it is asked for again.
# ctrl-r drops both caches, see handle_key.
list_tag_pipelines_json() {
    local tags newest older cached fresh

    tags="$(cached_tag_names)"
    [ -z "${tags}" ] && { echo "[]"; return 0; }
    newest="$(head -n 1 <<< "${tags}")"
    older="$(tail -n +2 <<< "${tags}")"

    if [ -s "${TAGPIPES_FILE}" ]; then
        cached="$(cat "${TAGPIPES_FILE}")"
    else
        cached="$(fetch_tag_pipelines "${older}")"
        printf '%s\n' "${cached}" > "${TAGPIPES_FILE}"
    fi
    fresh="$(fetch_tag_pipelines "${newest}")"

    jq -s 'add | unique_by(.id) | sort_by(.id) | reverse' \
        <(printf '%s\n' "${cached}") <(printf '%s\n' "${fresh}")
}

merge_tag_pipelines() {
    local pipelines="${1}"
    local tag_pipelines

    # without a ref filter every tag pipeline is in the result set already
    { [ "${tag_limit}" -le 0 ] || [ -z "${ref}" ]; } && { printf '%s\n' "${pipelines}"; return 0; }

    tag_pipelines="$(list_tag_pipelines_json)" || tag_pipelines="[]"
    jq -s 'add | unique_by(.id) | sort_by(.id) | reverse' \
        <(printf '%s\n' "${pipelines}") <(printf '%s\n' "${tag_pipelines}")
}

match_gitlab_vars() {
    local pid="${1}"
    local vars_json spec key val

    vars_json="$(glab api "projects/$(project_id)/pipelines/${pid}/variables" 2>/dev/null)"
    [ -z "${vars_json}" ] && vars_json="[]"

    for spec in "${var_specs[@]}"; do
        if [[ "${spec}" == *"="* ]]; then
            key="${spec%%=*}"; val="${spec#*=}"
            jq -e --arg k "${key}" --arg v "${val}" 'any(.[]; .key==$k and .value==$v)' <<< "${vars_json}" >/dev/null || return 1
        else
            jq -e --arg k "${spec}" 'any(.[]; .key==$k)' <<< "${vars_json}" >/dev/null || return 1
        fi
    done
    return 0
}

match_gitlab_grep() {
    local pid="${1}"
    local jobs_json job_id trace

    jobs_json="$(glab api "projects/$(project_id)/pipelines/${pid}/jobs" --paginate 2>/dev/null)"
    [ -z "${jobs_json}" ] && return 1

    while IFS= read -r job_id; do
        [ -z "${job_id}" ] && continue
        trace="$(glab api "projects/$(project_id)/jobs/${job_id}/trace" 2>/dev/null)"
        grep -qiE -- "${grep_pattern}" <<< "${trace}" && return 0
    done < <(jq -r '.[].id' <<< "${jobs_json}")
    return 1
}

match_github_grep() {
    local run_id="${1}"
    local logs

    logs="$(gh run view "${run_id}" --repo "${github_repo_selector}" --log 2>/dev/null)" || return 1
    grep -qiE -- "${grep_pattern}" <<< "${logs}"
}

JQ_STATUS_COLOR='
    def statuscolor:
        if . == "success" or . == "passed" then "\u001b[32m"
        elif . == "failed" or . == "failure" or . == "timed_out" then "\u001b[31m"
        elif . == "running" or . == "in_progress" or . == "pending" or . == "queued"
            or . == "waiting" or . == "created" or . == "preparing" then "\u001b[33m"
        elif . == "manual" or . == "action_required" then "\u001b[35m"
        elif . == "canceled" or . == "cancelled" or . == "skipped" or . == "neutral" then "\u001b[90m"
        else "" end;
    def colored: (. // "-") as $s | ($s | statuscolor) + $s + "\u001b[0m";
    # the user who triggered a pipeline, colored like the author of a commit
    def usercolored: (. // "-") as $u | "\u001b[38;5;33m" + $u + "\u001b[0m";
    # k-format only turns timestamps without fractional seconds into an age
    def ts: (. // "-") | sub("\\.[0-9]+(?=(Z|[+-]))"; "");
'

# the statuses a pipeline or a job has not reached a final state in yet
JQ_ACTIVE='
    def active:
        . == "created" or . == "waiting_for_resource" or . == "preparing"
        or . == "pending" or . == "queued" or . == "requested" or . == "waiting"
        or . == "running" or . == "in_progress";
'

JQ_TIME='
    def epoch: sub("\\.[0-9]+(?=(Z|[+-]))"; "") | fromdateiso8601;
    def dur:
        if . == null then "-"
        else (. | floor) as $s
            | if $s >= 3600 then "\($s / 3600 | floor)h\($s % 3600 / 60 | floor)m"
              elif $s >= 60 then "\($s / 60 | floor)m\($s % 60)s"
              else "\($s)s" end
        end;
'

print_table() {
    local header="${1}"
    local rows="${2}"

    if [ -z "${rows}" ]; then
        printf '%s\n' "${header}" | k-format
        return 0
    fi
    printf '%s\n' "${header}${NL}${rows}" | k-format
}

# tab is a filter no row of the list names, and it is switched while the picker
# runs, so the footer always says which of the two the list is
state_filter_label() {
    if [ "$(active_only)" -eq 1 ]; then
        echo "running only"
    else
        echo "all states"
    fi
}

# The ref, the source and the status of a pipeline are columns of the list, so
# filtering by them is on the screen already. --grep and --var are not: they
# drop pipelines with nothing saying why the list is as short as it is, so they
# lead the footer.
print_footer() {
    local text=""

    [ -n "${grep_pattern}" ] && text="grep ${grep_pattern}"
    if [ "${#var_specs[@]}" -gt 0 ]; then
        [ -n "${text}" ] && text="${text} · "
        text="${text}var ${var_specs[*]}"
    fi
    [ -n "${text}" ] && printf '%s%s%s · ' "${C_FILTER}" "${text}" "${C_RESET}"
    printf '%s%s%s\n' "${C_LABEL}" "$(state_filter_label)" "${C_RESET}"
}

print_pipelines() {
    local json="${1}"
    local rows

    if [ "${output}" = "json" ]; then
        echo "${json}"
        return 0
    fi
    rows="$(jq -r "${JQ_STATUS_COLOR}"'
        .[] | [
            (.id | tostring),
            (.status | colored),
            (.source // "-"),
            (.ref // "-"),
            (.user | usercolored),
            (.created_at | ts),
            (.web_url // "-")
        ] | join("  ")
    ' <<< "${json}")"
    print_table "${HEADER}" "${rows}"
}

# a job that is still running has no duration of its own yet, so the one shown
# for it is how long it has been running
list_gitlab_jobs_json() {
    local pid="${1}"
    local jobs

    jobs="$(glab api "projects/$(project_id)/pipelines/${pid}/jobs" --paginate 2>/dev/null)" || return 1
    jq -s "${JQ_TIME}"'
        add // []
        | sort_by(.id)
        | map({
            id,
            name,
            stage,
            status,
            started_at: (.started_at // .created_at),
            duration: (
                if .duration != null then .duration
                elif .started_at != null and .finished_at == null then (now - (.started_at | epoch))
                else null end
            ),
            runner: (((.runner.description // "") | gsub("^\\s+|\\s+$"; ""))
                     | if . == "" then null else . end),
            user: (.user.username // null),
            failure_reason,
            web_url
        })
    ' <<< "${jobs}"
}

list_github_jobs_json() {
    local rid="${1}"
    local jobs

    jobs="$(gh api "${github_api_args[@]}" --paginate \
        "repos/${github_repository}/actions/runs/${rid}/jobs?per_page=100" 2>/dev/null)" || return 1
    jq -s "${JQ_TIME}"'
        [.[].jobs[]]
        | sort_by(.id)
        | map({
            id,
            name,
            stage: (.workflow_name // "-"),
            status: (if .status == "completed" then (.conclusion // .status) else .status end),
            started_at: (.started_at // .created_at),
            duration: (
                if .started_at == null then null
                else ((if .completed_at != null then (.completed_at | epoch) else now end)
                      - (.started_at | epoch))
                end
            ),
            runner: (.runner_name // null),
            user: null,
            failure_reason: null,
            web_url: .html_url,
            steps: [ .steps[]? | {
                number,
                name,
                status: (if .status == "completed" then (.conclusion // .status) else .status end)
            } ]
        })
    ' <<< "${jobs}"
}

list_jobs_json() {
    if [ "${provider}" = "github" ]; then
        list_github_jobs_json "${1}"
    else
        list_gitlab_jobs_json "${1}"
    fi
}

# the jobs of a pipeline in the preview of the pipeline list, in the order they
# run in
show_jobs() {
    local pid="${1}"
    local json rows

    json="$(list_jobs_json "${pid}")" || { echo "failed to list jobs for ${pid}"; return 1; }

    rows="$(jq -r "${JQ_STATUS_COLOR}${JQ_TIME}"'
        .[] | [
            (.status | colored),
            (.stage // "-"),
            (.name // "-"),
            (.started_at | ts),
            (.duration | dur)
        ] | join("  ")
    ' <<< "${json}")"
    print_table "STATUS  $(stage_header)  NAME  STARTED  DURATION" "${rows}"
}

stage_header() {
    if [ "${provider}" = "github" ]; then
        echo "WORKFLOW"
    else
        echo "STAGE"
    fi
}

jobs_header() {
    printf 'ID  STATUS  %s  NAME  STARTED  DURATION  URL\n' "$(stage_header)"
}

# The jobs of a pipeline. The list is fed newest first, which the bottom up
# layout of the picker turns into the order the jobs run in, with the cursor on
# the one that ran last.
print_jobs() {
    local json="${1}"
    local rows

    if [ "${output}" = "json" ]; then
        echo "${json}"
        return 0
    fi
    rows="$(jq -r "${JQ_STATUS_COLOR}${JQ_TIME}"'
        reverse | .[] | [
            (.id | tostring),
            (.status | colored),
            (.stage // "-"),
            (.name // "-"),
            (.started_at | ts),
            (.duration | dur),
            (.web_url // "-")
        ] | join("  ")
    ' <<< "${json}")"
    print_table "$(jobs_header)" "${rows}"
}

# the pipeline the jobs belong to is gone from the screen while the jobs picker
# runs, so its footer names it
print_jobs_footer() {
    local pid ref status

    pid="$(jq -r '.id // "-"' <<< "${jobs_pipeline_json}")"
    ref="$(jq -r '.ref // "-"' <<< "${jobs_pipeline_json}")"
    status="$(jq -r "${JQ_STATUS_COLOR}"'.status | colored' <<< "${jobs_pipeline_json}")"
    printf '%spipeline %s%s · %s%s%s · %s\n' \
        "${C_ID}" "${pid}" "${C_RESET}" "${C_FILTER}" "${ref}" "${C_RESET}" "${status}"
}

# what both providers put into a log for their own web UI and what neither of
# them says anything with in a terminal: GitLab's collapsible sections, the
# timestamp both of them prefix every line with, GitHub's groups, and the
# carriage returns whatever ran in the job drew its progress with. A GitLab
# runner also flags every line with the stream it came from, and a flag ending
# in "+" means the line continues the one before it instead of being one of its
# own.
clean_trace() {
    sed -E "s/\x1b\[0K//g; s/^\xef\xbb\xbf//; s/section_(start|end):[0-9]+:[^${CR}]*${CR}//g" \
        | awk '
            function flush() { if (open) print buf }
            {
                line = $0
                stamped = 0
                # the timestamp of the provider, which carries fractional
                # seconds; one a tool of its own wrote stays where it is
                if (match(line, /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+Z /)) {
                    line = substr(line, RLENGTH + 1)
                    stamped = 1
                }
                cont = 0
                if (stamped && match(line, /^[0-9][0-9][OE][+ ]/)) {
                    cont = (substr(line, 4, 1) == "+")
                    line = substr(line, 5)
                }
                if (cont && open) { buf = buf line; next }
                flush()
                buf = line
                open = 1
            }
            END { flush() }
        ' \
        | sed -E "s/^##\[(group|endgroup|command)\]//" \
        | tr "${CR}" '\n'
}

# A job with nothing to show yet answers with an error instead of an empty log:
# GitHub has no log for a job before it finished and drops it once it expired,
# GitLab knows no trace for a job that has not started. Both of them say so on
# stdout, so the answer only counts if the request went through.
job_trace() {
    local jid="${1}"
    local out

    if [ "${provider}" = "github" ]; then
        out="$(gh api "${github_api_args[@]}" \
            "repos/${github_repository}/actions/jobs/${jid}/logs" 2>/dev/null)" || return 0
    else
        out="$(glab api "projects/$(project_id)/jobs/${jid}/trace" 2>/dev/null)" || return 0
    fi
    printf '%s\n' "${out}"
}

# the details of a job and the tail of its log in the preview of the jobs picker;
# the log is cut to what the preview window holds, so its last line is the last
# one of the log
show_job() {
    local jid="${1}"
    local job lines detail_lines tail_lines
    local name stage status started duration runner user failure url steps trace

    job="$(jq -c --arg id "${jid}" 'map(select((.id | tostring) == $id)) | first // empty' < "${JSON_FILE}")"
    [ -z "${job}" ] && { echo "no job ${jid}"; return 0; }

    IFS=$'\t' read -r name stage status started duration runner user failure url \
        < <(jq -r "${JQ_STATUS_COLOR}${JQ_TIME}"'[
                (.name // "-"),
                (.stage // "-"),
                (.status | colored),
                (.started_at | ts),
                (.duration | dur),
                (.runner // "-"),
                (.user // "-"),
                (.failure_reason // "-"),
                (.web_url // "-")
            ] | @tsv' <<< "${job}")

    local details=()
    details+=("NAME${TAB}${name}")
    details+=("$(stage_header)${TAB}${stage}")
    details+=("STATUS${TAB}${status}")
    details+=("STARTED${TAB}${started}")
    details+=("DURATION${TAB}${duration}")
    [ "${runner}" != "-" ] && details+=("RUNNER${TAB}${runner}")
    [ "${user}" != "-" ] && details+=("USER${TAB}${user}")
    [ "${failure}" != "-" ] && details+=("FAILURE${TAB}${failure}")
    details+=("URL${TAB}${url}")
    detail_lines="${#details[@]}"
    printf '%s\n' "${details[@]}" \
        | awk -F'\t' -v c="${C_LABEL}" -v r="${C_RESET}" '{ printf "%s%-10s%s%s\n", c, $1, r, $2 }'

    # what is left of the preview window below the details, so the last line of
    # the log is the last line of the preview - which only holds as long as no
    # line of it is wrapped, hence the nowrap window of the jobs picker
    lines="${FZF_PREVIEW_LINES:-40}"
    tail_lines=$((lines - detail_lines - 2))
    [ "${tail_lines}" -lt 5 ] && tail_lines=5

    trace="$(job_trace "${jid}" | clean_trace)"
    # the steps of a GitHub job are what there is to watch until its log shows up
    if [ -z "${trace}" ] && [ "${provider}" = "github" ]; then
        steps="$(jq -r "${JQ_STATUS_COLOR}"'
            (.steps // []) | .[] | "  \(.status | colored)  \(.name)"
        ' <<< "${job}" | tail -n "${tail_lines}")"
        if [ -n "${steps}" ]; then
            printf '\n%sSTEPS%s\n%s\n' "${C_LABEL}" "${C_RESET}" "${steps}"
            return 0
        fi
    fi
    if [ -z "${trace}" ]; then
        printf '\n%sno log%s\n' "${C_LABEL}" "${C_RESET}"
        return 0
    fi

    printf '\n%sLOG%s\n' "${C_LABEL}" "${C_RESET}"
    printf '%s\n' "${trace}" | tail -n "${tail_lines}"
}

show_job_log() {
    local jid="${1}"
    local trace

    trace="$(job_trace "${jid}" | clean_trace)"
    if [ -z "${trace}" ]; then
        printf 'No log for job %s.\n' "${jid}" | less -R
        return 0
    fi
    printf '%s\n' "${trace}" | less -R
}

show_logs() {
    local pid="${1}"
    local jobs_json job_id job_name

    jobs_json="$(list_jobs_json "${pid}")" || fail "failed to list jobs for ${pid}"
    {
        while IFS=$'\t' read -r job_id job_name; do
            [ -z "${job_id}" ] && continue
            printf '\n\033[1m===== %s (job %s) =====\033[0m\n' "${job_name}" "${job_id}"
            job_trace "${job_id}" | clean_trace
        done < <(jq -r '.[] | [(.id | tostring), .name] | @tsv' <<< "${jobs_json}")
    } | less -R
}

pipeline_detail_json() {
    local pid="${1}"

    if [ "${provider}" = "github" ]; then
        gh api "${github_api_args[@]}" "repos/${github_repository}/actions/runs/${pid}" 2>/dev/null \
            | jq -c '{
                id,
                status: (if .status == "completed" then (.conclusion // .status) else .status end),
                source: .event,
                ref: .head_branch,
                user: (.triggering_actor.login // .actor.login // "-"),
                created_at,
                web_url: .html_url
            }'
    else
        glab api "projects/$(project_id)/pipelines/${pid}" 2>/dev/null \
            | jq -c '{
                id,
                status,
                source,
                ref,
                user: (.user.username // "-"),
                created_at,
                web_url
            }'
    fi
}

open_url() {
    local url="${1}"

    [ -z "${url}" ] && fail "no URL for the selected pipeline"
    need_cmd gio
    gio open "${url}" &>/dev/null
}

copy_url() {
    local url="${1}"

    [ -z "${url}" ] && { error "no URL for the selected row"; return 1; }
    need_cmd clip
    printf '%s' "${url}" | clip || { error "Failed to copy the URL"; return 1; }
    echo "${url} copied to clipboard." 1>&2
}

# tab switches the status filter of the pipeline list; the file is what the
# reload that follows the key reads it back from
active_only() {
    if [ -s "${FILTER_FILE}" ]; then
        echo 1
    else
        echo 0
    fi
}

toggle_active_only() {
    if [ "$(active_only)" -eq 1 ]; then
        rm -f "${FILTER_FILE}"
    else
        echo 1 > "${FILTER_FILE}"
    fi
}

handle_key() {
    local key line pid url

    key="$(head -n 1 <<< "${key_result}")"
    # an empty list has no row for the key, and the key itself must not be taken
    # for one
    line="$(sed -n '2p' <<< "${key_result}")"
    pid="$(awk '{print $1}' <<< "${line}")"
    url="$(awk '{print $NF}' <<< "${line}")"

    case "${key}" in
        tab)
            toggle_active_only
            exit 0
            ;;
        ctrl-r)
            # the tags of a run are fetched once, and a manual refresh is what
            # asks for them again
            rm -f "${TAGS_FILE}" "${TAGPIPES_FILE}"
            exit 0
            ;;
        esc|ctrl-c|ctrl-d)
            exit 255
            ;;
    esac
    [ -z "${pid}" ] && exit 0

    case "${key}" in
        enter)
            # leaving the jobs of a pipeline with esc returns to this list,
            # ending it there ends this one as well
            PROJECT_ID="${PROJECT_ID:-}" "${0}" --jobs "${pid}" --watch "${watch_seconds}" || exit 0
            exit 1
            ;;
        ctrl-y)
            copy_url "${url}"
            exit 0
            ;;
        ctrl-o)
            open_url "${url}"
            exit 0
            ;;
        ctrl-l)
            show_logs "${pid}"
            exit 0
            ;;
        *)
            fail "Unknown key: ${key}"
            ;;
    esac
}

handle_jobs_key() {
    local key line jid url

    key="$(head -n 1 <<< "${key_result}")"
    line="$(sed -n '2p' <<< "${key_result}")"
    jid="$(awk '{print $1}' <<< "${line}")"
    url="$(awk '{print $NF}' <<< "${line}")"

    case "${key}" in
        esc)
            # back to the pipeline list this view was opened from
            exit 255
            ;;
        ctrl-c|ctrl-d)
            exit 1
            ;;
    esac
    [ -z "${jid}" ] && exit 0

    case "${key}" in
        enter)
            show_job_log "${jid}"
            exit 0
            ;;
        ctrl-y)
            copy_url "${url}"
            exit 0
            ;;
        ctrl-o)
            open_url "${url}"
            exit 0
            ;;
        *)
            fail "Unknown key: ${key}"
            ;;
    esac
}

write_state() {
    {
        printf 'provider=%q\n' "${provider}"
        printf 'remote_repository=%q\n' "${remote_repository}"
        printf 'github_repository=%q\n' "${github_repository}"
        printf 'github_repo_selector=%q\n' "${github_repo_selector}"
        declare -p github_api_args
        printf 'PROJECT_ID=%q\n' "${PROJECT_ID:-}"
        printf 'repo_dir=%q\n' "${PWD}"
        # the query context, so a --watch reload can fetch the result set again
        printf 'refresh=%q\n' "${refresh}"
        printf 'watch_seconds=%q\n' "${watch_seconds}"
        printf 'action=%q\n' "${action}"
        printf 'ref=%q\n' "${ref}"
        printf 'tag_limit=%q\n' "${tag_limit}"
        printf 'source=%q\n' "${source}"
        printf 'grep_pattern=%q\n' "${grep_pattern}"
        printf 'per_page=%q\n' "${per_page}"
        printf 'paginate=%q\n' "${paginate}"
        # the jobs view lists one pipeline instead of a result set of its own
        printf 'jobs_pipeline_id=%q\n' "${jobs_pipeline_id}"
        printf 'jobs_pipeline_json=%q\n' "${jobs_pipeline_json}"
        declare -p statuses
        declare -p var_specs
    } > "${STATE_FILE}"
}

fetch_pipelines() {
    local pipelines

    case "${action}" in
        status) pipelines="$(cmd_status)" || return 1 ;;
        search) pipelines="$(cmd_search)" || return 1 ;;
        *)      return 1 ;;
    esac
    annotate_users "${pipelines}"
}

# The pipeline of a ref that was just pushed does not exist the moment the push
# returns, so asking for it right away answers with nothing. --wait keeps asking
# until one shows up or the time is up.
wait_for_pipelines() {
    local pipelines="${1}"
    local count deadline left nap

    count="$(jq 'length' <<< "${pipelines}")"
    { [ "${count}" -gt 0 ] || [ "${wait_seconds}" -le 0 ]; } \
        && { printf '%s\n' "${pipelines}"; return 0; }

    log "No pipelines yet, waiting up to ${wait_seconds}s for one to show up..."
    deadline=$((SECONDS + wait_seconds))
    while [ "${SECONDS}" -lt "${deadline}" ]; do
        left=$((deadline - SECONDS))
        nap="${WAIT_POLL_SECONDS}"
        [ "${left}" -lt "${nap}" ] && nap="${left}"
        sleep "${nap}"
        pipelines="$(fetch_pipelines)" || return 1
        count="$(jq 'length' <<< "${pipelines}")"
        [ "${count}" -gt 0 ] && break
    done
    printf '%s\n' "${pipelines}"
}

# pipelines or jobs that are not in a final state yet, so the view has to keep
# updating
has_active() {
    jq -e "${JQ_ACTIVE}"'any(.[].status; active)' <<< "${1}" >/dev/null
}

# what tab narrows the list down to; the unfiltered list is what the watcher
# looks at, so the reloading does not stop with the running pipelines hidden
filter_active() {
    if [ "$(active_only)" -eq 1 ]; then
        jq "${JQ_ACTIVE}"'[ .[] | select(.status | active) ]' <<< "${1}"
    else
        printf '%s\n' "${1}"
    fi
}

pick_pipelines() {
    local watch_args=() refresh_bind=()

    if [ "${refresh}" -eq 1 ]; then
        # reload once shortly after the picker opened - a pipeline may have
        # started in the meantime - then keep reloading while something runs
        watch_args=("--watch" "${watch_seconds}"
                    "--watch-delay" "${WATCH_FIRST_DELAY}"
                    "--watch-while" "${APP_NAME} --id ${id} --active")
        # keep the job preview in sync with every reload of the list
        refresh_bind=("--bind=result:refresh-preview")
    fi

    fzf-with-header --key-command "${APP_NAME} --id ${id} --key" \
                    --key-descriptions "${KEY_DESCS}" \
                    --exec-keys "${EXEC_KEYS}" \
                    --silent-keys "${SILENT_KEYS}" \
                    --reload-keys "${RELOAD_KEYS}" \
                    --columns "${PICKER_COLUMNS}" \
                    --command "${APP_NAME} --id ${id} --print" \
                    --footer-prefix "${APP_NAME} --id ${id} --footer" \
                    "${watch_args[@]}" \
                    "${query}" \
                    --preview="${APP_NAME} --id ${id} --preview {1}" \
                    --preview-window=right:50%,wrap \
                    "${refresh_bind[@]}" \
                    --expect="${KEYS}" \
                    --no-sort
}

pick_jobs() {
    local watch_args=() refresh_bind=()

    if [ "${refresh}" -eq 1 ]; then
        # a job that starts while the view is open shows up on its own, and the
        # preview of a running one keeps up with its log
        watch_args=("--watch" "${watch_seconds}"
                    "--watch-while" "${APP_NAME} --id ${id} --active")
        refresh_bind=("--bind=result:refresh-preview")
    fi

    fzf-with-header --key-command "${APP_NAME} --id ${id} --jobs-key" \
                    --key-descriptions "${JOBS_KEY_DESCS}" \
                    --exec-keys "${JOBS_EXEC_KEYS}" \
                    --silent-keys "${JOBS_SILENT_KEYS}" \
                    --columns "${PICKER_COLUMNS}" \
                    --command "${APP_NAME} --id ${id} --jobs-print" \
                    --footer-prefix "${APP_NAME} --id ${id} --jobs-footer" \
                    "${watch_args[@]}" \
                    --preview="${APP_NAME} --id ${id} --jobs-preview {1}" \
                    --preview-window=right:60%,nowrap \
                    "${refresh_bind[@]}" \
                    --expect="${JOBS_KEYS}" \
                    --no-sort
}

cmd_search() {
    local pipelines pid
    local matched_ids=()

    [ "${provider}" = "github" ] && [ "${#var_specs[@]}" -gt 0 ] \
        && fail "--var is not supported for GitHub Actions"

    pipelines="$(list_pipelines_json)" || fail "failed to list pipelines"

    [ "${TRUNCATED}" -eq 1 ] \
        && warning "Hit the ${per_page}-result page limit; more pipelines may match. Use -a/--all or raise -n/--limit."

    # merge before filtering, so --var/--grep apply to the tag pipelines as well
    pipelines="$(merge_tag_pipelines "${pipelines}")"

    [ -n "${grep_pattern}" ] && echo "Searching job logs (this may take a while)..." 1>&2

    while IFS= read -r pid; do
        [ -z "${pid}" ] && continue
        [ "${#var_specs[@]}" -gt 0 ] && { match_gitlab_vars "${pid}" || continue; }
        if [ -n "${grep_pattern}" ]; then
            if [ "${provider}" = "github" ]; then
                match_github_grep "${pid}" || continue
            else
                match_gitlab_grep "${pid}" || continue
            fi
        fi
        matched_ids+=("${pid}")
    done < <(jq -r '.[].id' <<< "${pipelines}")

    local ids_json
    ids_json="$(printf '%s\n' "${matched_ids[@]}" | jq -R 'select(length>0) | tonumber' | jq -s '.')"

    jq --argjson ids "${ids_json}" '[ .[] | select(.id as $i | $ids | index($i)) ]' <<< "${pipelines}"
}

