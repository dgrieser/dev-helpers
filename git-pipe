STATE_FILE="/tmp/${APP_NAME}-${id}.state"
JSON_FILE="/tmp/${APP_NAME}-${id}.json"
# the status filter of the pipeline list, switched with tab while it runs
FILTER_FILE="/tmp/${APP_NAME}-${id}.filter"
# the users the pipelines of this run were looked up for, see gitlab_user_map
USERS_FILE="/tmp/${APP_NAME}-${id}.users"
# the tags of this run and the pipelines of the ones that are not the newest,
# both fetched once and dropped by ctrl-r
TAGS_FILE="/tmp/${APP_NAME}-${id}.tags"
TAGPIPES_FILE="/tmp/${APP_NAME}-${id}.tagpipes"

# --key, --preview and --print are called by the picker with the id of the run
# that produced the result set; reuse its state and cached pipelines or jobs
if [ "${id_given}" -eq 1 ] && [ -f "${STATE_FILE}" ] && [ -f "${JSON_FILE}" ]; then
    # shellcheck source=/dev/null
    . "${STATE_FILE}"
    cd "${repo_dir}" || fail "failed to enter ${repo_dir}"
    if [ "${provider}" = "github" ]; then
        need_cmd gh
    else
        need_cmd glab
    fi
    case "${mode}" in
        active)
            # the cached list is the one of the view that asked, pipelines or jobs
            has_active "$(cat "${JSON_FILE}")"
            exit $?
            ;;
        footer)
            print_footer
            exit 0
            ;;
        key)
            handle_key
            ;;
        preview)
            show_jobs "${preview_id}"
            exit 0
            ;;
        print)
            need_cmd k-format
            pipelines=""
            # every reload refetches, so a pipeline that started after the picker
            # opened shows up; the watcher stops on its own once nothing runs
            # anymore, a manual refresh still refetches and its result is what
            # lets the watcher pick the watching back up
            if [ "${refresh:-0}" -eq 1 ]; then
                pipelines="$(fetch_pipelines 2>/dev/null)"
                [ -n "${pipelines}" ] && printf '%s\n' "${pipelines}" > "${JSON_FILE}"
            fi
            [ -z "${pipelines}" ] && pipelines="$(cat "${JSON_FILE}")"
            print_pipelines "$(filter_active "${pipelines}")"
            exit 0
            ;;
        jobs-footer)
            print_jobs_footer
            exit 0
            ;;
        jobs-key)
            handle_jobs_key
            ;;
        jobs-preview)
            show_job "${preview_id}"
            exit 0
            ;;
        jobs-print)
            need_cmd k-format
            jobs=""
            # a job that starts while the view is open is one the next reload
            # brings, the same way the pipeline list picks up a new pipeline
            if [ "${refresh:-0}" -eq 1 ]; then
                jobs="$(list_jobs_json "${jobs_pipeline_id}" 2>/dev/null)"
                [ -n "${jobs}" ] && printf '%s\n' "${jobs}" > "${JSON_FILE}"
            fi
            [ -z "${jobs}" ] && jobs="$(cat "${JSON_FILE}")"
            print_jobs "${jobs}"
            exit 0
            ;;
    esac
fi

case "${mode}" in
    key|preview|active|footer|jobs-key|jobs-preview|jobs-print|jobs-footer)
        fail "no cached pipeline result for id ${id}"
        ;;
esac

[ -z "${action}" ] && [ -z "${jobs_pipeline_id}" ] && error "Missing command" && usage
[ -n "${action}" ] && [ -n "${jobs_pipeline_id}" ] \
    && error "-j/--jobs takes a pipeline instead of a command" && usage

if [ "${action}" = "status" ]; then
    { [ "${#statuses[@]}" -gt 0 ] || [ "${#var_specs[@]}" -gt 0 ] || [ -n "${grep_pattern}" ] || [ -n "${source}" ] \
        || [ "${paginate}" -eq 1 ] || [ "${per_page}" != "${PER_PAGE_DEFAULT}" ] \
        || [ "${all_refs}" -eq 1 ]; } \
        && error "Those options are only valid for 'search'" && usage
fi

[ "${all_refs}" -eq 1 ] && [ -n "${ref}" ] && error "--ref and --all-refs are mutually exclusive" && usage

cded=0
if [ -n "${repo}" ]; then
    need_cmd git-find-repo
    cd "$(git-find-repo "${repo}")" || abort
    cded=1
fi

# the jobs view lists one pipeline, whichever ref it belongs to
if [ -z "${ref}" ] && [ "${all_refs}" -eq 0 ] && [ -z "${jobs_pipeline_id}" ]; then
    ref="$(git branch --show-current)"
    [ -z "${ref}" ] && fail "failed to determine current branch (detached HEAD?); use --ref$([ "${action}" = "search" ] && echo " or --all-refs")"
fi

remote_url="$(git remote get-url origin)" || fail "failed to determine origin remote"
detect_provider "${remote_url}"
if [ "${provider}" = "github" ]; then
    need_cmd gh
else
    need_cmd glab
fi

[ "${provider}" = "gitlab" ] && project_id >/dev/null

trap 'rm -f "${STATE_FILE}" "${JSON_FILE}" "${FILTER_FILE}" "${USERS_FILE}" "${TAGS_FILE}" "${TAGPIPES_FILE}"' EXIT

if [ -n "${jobs_pipeline_id}" ]; then
    jobs="$(list_jobs_json "${jobs_pipeline_id}")" \
        || fail "failed to list the jobs of ${jobs_pipeline_id}"
    exit_code=0
    if [ "${output}" = "json" ]; then
        echo "${jobs}"
    elif [ "${mode}" = "print" ] || [ ! -t 1 ]; then
        need_cmd k-format
        print_jobs "${jobs}"
    else
        need_cmd k-format
        need_cmd fzf-with-header
        # the pipeline the footer names; it is the one thing of this view that
        # every reload would fetch again without changing
        jobs_pipeline_json="$(pipeline_detail_json "${jobs_pipeline_id}")"
        [ -z "${jobs_pipeline_json}" ] \
            && jobs_pipeline_json="$(jq -cn --arg id "${jobs_pipeline_id}" '{id: $id}')"
        [ "${watch_seconds}" -gt 0 ] && refresh=1
        printf '%s\n' "${jobs}" > "${JSON_FILE}"
        write_state
        pick_jobs
        exit_code=$?
    fi
    if [ "${cded}" -eq 1 ]; then
        cd - &> /dev/null || fail "failed to return to previous directory"
    fi
    exit "${exit_code}"
fi

pipelines="$(fetch_pipelines)" || exit 1
pipelines="$(wait_for_pipelines "${pipelines}")" || exit 1

pipeline_count="$(jq 'length' <<< "${pipelines}")"

exit_code=0
if [ "${output}" = "json" ]; then
    echo "${pipelines}"
elif [ "${pipeline_count}" -eq 0 ]; then
    log "No pipelines."
elif [ "${mode}" = "print" ] || [ ! -t 1 ]; then
    need_cmd k-format
    print_pipelines "${pipelines}"
else
    need_cmd k-format
    need_cmd fzf-with-header
    if [ "${watch_seconds}" -gt 0 ]; then
        if [ -n "${grep_pattern}" ] || [ "${#var_specs[@]}" -gt 0 ]; then
            has_active "${pipelines}" \
                && warning "pipelines are still running, but --grep/--var results are too expensive to refresh automatically"
        else
            refresh=1
        fi
    fi
    printf '%s\n' "${pipelines}" > "${JSON_FILE}"
    write_state
    pick_pipelines "${pipelines}"
    exit_code=$?
fi

if [ "${cded}" -eq 1 ]; then
    cd - &> /dev/null || fail "failed to return to previous directory"
fi
exit "${exit_code}"
