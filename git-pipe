#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }

APP_NAME="$(basename "${0}")"

PER_PAGE_DEFAULT=20
WATCH_SECONDS_DEFAULT=5
WATCH_FIRST_DELAY=10
# how many of the most recent tags to include pipelines for, and how many
# pipelines to fetch per tag
TAG_LIMIT_DEFAULT=3
TAG_PER_PAGE=20

NL=$'\n'
C_FILTER=$'\033[38;5;208m'
C_RESET=$'\033[0m'
HEADER="ID  STATUS  SOURCE  REF  CREATED  URL"
# both actions leave the pipeline list alone, so neither reloads it: the log
# pager gets the terminal handed over, the browser is opened silently
KEYS="esc,ctrl-c,ctrl-d,enter"
EXEC_KEYS="ctrl-l"
SILENT_KEYS="ctrl-o"
KEY_DESCS="enter:copy url,ctrl-o:open,ctrl-l:logs"
KEY_DESCS_HELP="enter copy url, ctrl-o open, ctrl-l logs"

usage() {
    cat <<EOF 1>&2
usage: ${APP_NAME} COMMAND [OPTIONS]

Show and search GitLab CI or GitHub Actions pipeline information for a repository.

In addition to the pipelines of the selected ref, the pipelines of the ${TAG_LIMIT_DEFAULT} most
recent tags are included (see --tags/--no-tags).

Results are shown in an interactive picker (keys: ${KEY_DESCS_HELP}).
The picker reloads once ${WATCH_FIRST_DELAY} seconds after it opened, then keeps reloading
as long as pipelines are still running. Once it stopped, a manual refresh
(ctrl-r) that brings up a running pipeline resumes the auto-reloading.

COMMAND
    status                  show CI pipeline status for a ref
    search                  list pipelines matching variable, log, or status filters

Options:
    -h|--help               show this help
    -r|--repo <PROJECT>     project to operate on (default: current directory)
        --ref <REF>         ref to filter by (default: current branch)
        --tags <N>          also show the pipelines of the N most recent tags
                            (default ${TAG_LIMIT_DEFAULT}, 0 disables; one API request per tag)
        --no-tags           shorthand for --tags 0
    -q|--query <QUERY>      start the picker with a search query
    -p|--print              print the result table instead of opening the picker
    -w|--watch <SECONDS>    reload interval while pipelines are still running
                            (default ${WATCH_SECONDS_DEFAULT}, 0 disables auto-reloading)

search options:
        --all-refs            do not filter by ref (search all refs)
        --var <NAME[=VALUE]>  GitLab pipeline has variable NAME (optionally equal to VALUE);
                              repeatable, all must match (unsupported on GitHub)
        --grep <PATTERN>      keep pipelines whose job logs match PATTERN (extended regex, case-insensitive)
        --source <SOURCE>     filter by pipeline source (push, trigger, schedule, web, api, ...)
    -s|--status <STATUS>      filter by raw status (repeatable)
        --failed              shorthand for --status failed
        --succeeded           shorthand for --status success
        --aborted             shorthand for --status canceled
        --running             shorthand for --status running
        --pending             shorthand for --status pending
        --manual              shorthand for --status manual
        --skipped             shorthand for --status skipped
    -n|--limit <N>            results per page (1-100, default ${PER_PAGE_DEFAULT})
    -a|--all                  fetch all pages (overrides --limit window)
    -o|--output <txt|json>    output format: txt or json (default txt)
EOF
    exit 1
}

log() {
    echo "${1}" 1>&2
}

error() {
    echo "ERROR: ${1}" 1>&2
}

warning() {
    echo "WARNING: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

abort() {
    echo "Abort." 1>&2
    exit 130
}

need_cmd() {
    command -v "${1}" >/dev/null 2>&1 || fail "missing required command: ${1}"
}

urlenc() {
    jq -rn --arg v "${1}" '$v|@uri'
}

build_qs() {
    [ "${#}" -eq 0 ] && return 0
    local IFS='&'
    printf '?%s' "$*"
}

project_id() {
    if [ -z "${PROJECT_ID:-}" ]; then
        PROJECT_ID="$(glab repo view -F json | jq -r '.id')"
        [ -z "${PROJECT_ID}" ] && fail "failed to determine GitLab project id"
        [ "${PROJECT_ID}" = "null" ] && fail "failed to determine GitLab project id"
    fi
    printf '%s\n' "${PROJECT_ID}"
}

repository_from_url() {
    local url="${1}"
    local repository

    url="${url%/}"
    url="${url%.git}"
    case "${url}" in
        *://*)
            repository="${url#*://}"
            repository="${repository#*@}"
            repository="${repository#*/}"
            ;;
        *@*:*)
            repository="${url#*:}"
            ;;
        *)
            return 1
            ;;
    esac

    [ "${repository}" = "${repository#*/}" ] && return 1
    printf '%s\n' "${repository}"
}

host_from_url() {
    local url="${1}"
    local host

    case "${url}" in
        *://*)
            host="${url#*://}"
            host="${host%%/*}"
            host="${host#*@}"
            ;;
        *@*:*)
            host="${url#*@}"
            host="${host%%:*}"
            ;;
        *)
            return 1
            ;;
    esac
    printf '%s\n' "${host}"
}

detect_provider() {
    local remote_url="${1}"
    local host

    host="$(host_from_url "${remote_url}")" || fail "failed to determine remote host"
    if [[ "${host}" == *github* ]] \
        || [ -n "$(git config --get remote.origin.gh-resolved 2>/dev/null)" ]; then
        provider="github"
        github_repository="$(repository_from_url "${remote_url}")" \
            || fail "failed to determine GitHub repository"
        github_repo_selector="${github_repository}"
        github_api_args=()
        if [ "${host}" != "github.com" ]; then
            github_api_args+=("--hostname" "${host}")
            github_repo_selector="${host}/${github_repository}"
        fi
    else
        provider="gitlab"
    fi
}

cmd_status() {
    local pipelines
    pipelines="$(list_pipelines_json)" || fail "failed to list pipelines"
    merge_tag_pipelines "${pipelines}"
}

list_gitlab_pipelines_json() {
    local base
    base="projects/$(project_id)/pipelines"
    local common=("per_page=${per_page}" "order_by=id" "sort=desc")
    [ -n "${ref}" ] && common+=("ref=$(urlenc "${ref}")")
    [ -n "${source}" ] && common+=("source=$(urlenc "${source}")")

    local page_flag=()
    [ "${paginate}" -eq 1 ] && page_flag+=("--paginate")

    local out="[]" part qs s
    TRUNCATED=0
    if [ "${#statuses[@]}" -eq 0 ]; then
        qs="$(build_qs "${common[@]}")"
        part="$(glab api "${page_flag[@]}" "${base}${qs}")" || return 1
        # --paginate emits one array per page; slurp them into a single array
        part="$(jq -s 'add // []' <<< "${part}")"
        [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
        out="${part}"
    else
        for s in "${statuses[@]}"; do
            qs="$(build_qs "${common[@]}" "status=${s}")"
            part="$(glab api "${page_flag[@]}" "${base}${qs}")" || return 1
            part="$(jq -s 'add // []' <<< "${part}")"
            [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
            out="$(jq -s 'add' <(echo "${out}") <(echo "${part}"))"
        done
    fi
    jq 'unique_by(.id) | sort_by(.id) | reverse' <<< "${out}"
}

github_status() {
    case "${1}" in
        failed)    echo "failure" ;;
        canceled)  echo "cancelled" ;;
        running)   echo "in_progress" ;;
        manual)    echo "action_required" ;;
        *)         echo "${1}" ;;
    esac
}

list_github_pipelines_json() {
    local base="repos/${github_repository}/actions/runs"
    local common=("per_page=${per_page}")
    [ -n "${ref}" ] && common+=("branch=$(urlenc "${ref}")")
    [ -n "${source}" ] && common+=("event=$(urlenc "${source}")")

    local page_flag=()
    [ "${paginate}" -eq 1 ] && page_flag+=("--paginate")

    local out="[]" part qs s mapped_status
    TRUNCATED=0
    if [ "${#statuses[@]}" -eq 0 ]; then
        qs="$(build_qs "${common[@]}")"
        part="$(gh api "${github_api_args[@]}" "${page_flag[@]}" "${base}${qs}")" || return 1
        part="$(jq -s '[.[].workflow_runs[]]' <<< "${part}")"
        [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
        out="${part}"
    else
        for s in "${statuses[@]}"; do
            mapped_status="$(github_status "${s}")"
            qs="$(build_qs "${common[@]}" "status=$(urlenc "${mapped_status}")")"
            part="$(gh api "${github_api_args[@]}" "${page_flag[@]}" "${base}${qs}")" || return 1
            part="$(jq -s '[.[].workflow_runs[]]' <<< "${part}")"
            [ "${paginate}" -eq 0 ] && [ "$(jq 'length' <<< "${part}")" -ge "${per_page}" ] && TRUNCATED=1
            out="$(jq -s 'add' <(echo "${out}") <(echo "${part}"))"
        done
    fi
    jq '
        unique_by(.id)
        | sort_by(.id)
        | reverse
        | map({
            id,
            status: (if .status == "completed" then (.conclusion // .status) else .status end),
            source: .event,
            ref: .head_branch,
            created_at,
            web_url: .html_url
        })
    ' <<< "${out}"
}

list_pipelines_json() {
    if [ "${provider}" = "github" ]; then
        list_github_pipelines_json
    else
        list_gitlab_pipelines_json
    fi
}

list_tag_names() {
    if [ "${provider}" = "github" ]; then
        gh api "${github_api_args[@]}" "repos/${github_repository}/tags?per_page=100" 2>/dev/null \
            | jq -r '.[].name'
    else
        glab api "projects/$(project_id)/repository/tags?per_page=100" 2>/dev/null \
            | jq -r '.[].name'
    fi
}

# neither API can filter pipelines by "is a tag", so query the most recent tags
# by ref - both providers accept a tag name where they take a branch/ref
list_tag_pipelines_json() {
    local out="[]" tag part
    local saved_ref="${ref}"
    local saved_per_page="${per_page}"
    local saved_paginate="${paginate}"
    local saved_truncated="${TRUNCATED}"

    per_page="${TAG_PER_PAGE}"
    paginate=0
    while IFS= read -r tag; do
        [ -z "${tag}" ] && continue
        ref="${tag}"
        part="$(list_pipelines_json)" || part="[]"
        out="$(jq -s 'add' <(printf '%s\n' "${out}") <(printf '%s\n' "${part}"))"
    done < <(list_tag_names | head -n "${tag_limit}")

    ref="${saved_ref}"
    per_page="${saved_per_page}"
    paginate="${saved_paginate}"
    # the tag queries use their own window, so keep the warning about the main one
    TRUNCATED="${saved_truncated}"

    jq 'unique_by(.id) | sort_by(.id) | reverse' <<< "${out}"
}

merge_tag_pipelines() {
    local pipelines="${1}"
    local tag_pipelines

    # without a ref filter every tag pipeline is in the result set already
    { [ "${tag_limit}" -le 0 ] || [ -z "${ref}" ]; } && { printf '%s\n' "${pipelines}"; return 0; }

    tag_pipelines="$(list_tag_pipelines_json)" || tag_pipelines="[]"
    jq -s 'add | unique_by(.id) | sort_by(.id) | reverse' \
        <(printf '%s\n' "${pipelines}") <(printf '%s\n' "${tag_pipelines}")
}

match_gitlab_vars() {
    local pid="${1}"
    local vars_json spec key val

    vars_json="$(glab api "projects/$(project_id)/pipelines/${pid}/variables" 2>/dev/null)"
    [ -z "${vars_json}" ] && vars_json="[]"

    for spec in "${var_specs[@]}"; do
        if [[ "${spec}" == *"="* ]]; then
            key="${spec%%=*}"; val="${spec#*=}"
            jq -e --arg k "${key}" --arg v "${val}" 'any(.[]; .key==$k and .value==$v)' <<< "${vars_json}" >/dev/null || return 1
        else
            jq -e --arg k "${spec}" 'any(.[]; .key==$k)' <<< "${vars_json}" >/dev/null || return 1
        fi
    done
    return 0
}

match_gitlab_grep() {
    local pid="${1}"
    local jobs_json job_id trace

    jobs_json="$(glab api "projects/$(project_id)/pipelines/${pid}/jobs" --paginate 2>/dev/null)"
    [ -z "${jobs_json}" ] && return 1

    while IFS= read -r job_id; do
        [ -z "${job_id}" ] && continue
        trace="$(glab api "projects/$(project_id)/jobs/${job_id}/trace" 2>/dev/null)"
        grep -qiE -- "${grep_pattern}" <<< "${trace}" && return 0
    done < <(jq -r '.[].id' <<< "${jobs_json}")
    return 1
}

match_github_grep() {
    local run_id="${1}"
    local logs

    logs="$(gh run view "${run_id}" --repo "${github_repo_selector}" --log 2>/dev/null)" || return 1
    grep -qiE -- "${grep_pattern}" <<< "${logs}"
}

JQ_STATUS_COLOR='
    def statuscolor:
        if . == "success" or . == "passed" then "\u001b[32m"
        elif . == "failed" or . == "failure" or . == "timed_out" then "\u001b[31m"
        elif . == "running" or . == "in_progress" or . == "pending" or . == "queued"
            or . == "waiting" or . == "created" or . == "preparing" then "\u001b[33m"
        elif . == "manual" or . == "action_required" then "\u001b[35m"
        elif . == "canceled" or . == "cancelled" or . == "skipped" or . == "neutral" then "\u001b[90m"
        else "" end;
    def colored: (. // "-") as $s | ($s | statuscolor) + $s + "\u001b[0m";
    # k-format only turns timestamps without fractional seconds into an age
    def ts: (. // "-") | sub("\\.[0-9]+(?=(Z|[+-]))"; "");
'

print_table() {
    local header="${1}"
    local rows="${2}"

    if [ -z "${rows}" ]; then
        printf '%s\n' "${header}" | k-format
        return 0
    fi
    printf '%s\n' "${header}${NL}${rows}" | k-format
}

# The ref, the source and the status of a pipeline are columns of the list, so
# filtering by them is on the screen already. --grep and --var are not: they
# drop pipelines with nothing saying why the list is as short as it is, so they
# lead the footer.
print_footer() {
    local text=""

    [ -n "${grep_pattern}" ] && text="grep ${grep_pattern}"
    if [ "${#var_specs[@]}" -gt 0 ]; then
        [ -n "${text}" ] && text="${text} · "
        text="${text}var ${var_specs[*]}"
    fi
    [ -z "${text}" ] && return 0
    printf '%s%s%s\n' "${C_FILTER}" "${text}" "${C_RESET}"
}

print_pipelines() {
    local json="${1}"
    local rows

    if [ "${output}" = "json" ]; then
        echo "${json}"
        return 0
    fi
    rows="$(jq -r "${JQ_STATUS_COLOR}"'
        .[] | [
            (.id | tostring),
            (.status | colored),
            (.source // "-"),
            (.ref // "-"),
            (.created_at | ts),
            (.web_url // "-")
        ] | join("  ")
    ' <<< "${json}")"
    print_table "${HEADER}" "${rows}"
}

list_gitlab_jobs_json() {
    local pid="${1}"
    local jobs

    jobs="$(glab api "projects/$(project_id)/pipelines/${pid}/jobs" --paginate 2>/dev/null)" || return 1
    jq -s '
        add // []
        | sort_by(.id)
        | map({name, stage, status, created_at: (.started_at // .created_at), web_url})
    ' <<< "${jobs}"
}

list_github_jobs_json() {
    local rid="${1}"
    local jobs

    jobs="$(gh api "${github_api_args[@]}" --paginate \
        "repos/${github_repository}/actions/runs/${rid}/jobs?per_page=100" 2>/dev/null)" || return 1
    jq -s '
        [.[].jobs[]]
        | sort_by(.id)
        | map({
            name,
            stage: (.workflow_name // "-"),
            status: (if .status == "completed" then (.conclusion // .status) else .status end),
            created_at: (.started_at // .created_at),
            web_url: .html_url
        })
    ' <<< "${jobs}"
}

show_jobs() {
    local pid="${1}"
    local json rows

    if [ "${provider}" = "github" ]; then
        json="$(list_github_jobs_json "${pid}")" || { echo "failed to list jobs for ${pid}"; return 1; }
    else
        json="$(list_gitlab_jobs_json "${pid}")" || { echo "failed to list jobs for ${pid}"; return 1; }
    fi

    rows="$(jq -r "${JQ_STATUS_COLOR}"'
        .[] | [
            (.status | colored),
            (.stage // "-"),
            (.name // "-"),
            (.created_at | ts)
        ] | join("  ")
    ' <<< "${json}")"
    local stage_header="STAGE"
    [ "${provider}" = "github" ] && stage_header="WORKFLOW"
    print_table "STATUS  ${stage_header}  NAME  STARTED" "${rows}"
}

show_logs() {
    local pid="${1}"
    local jobs_json job_id job_name

    if [ "${provider}" = "github" ]; then
        gh run view "${pid}" --repo "${github_repo_selector}" --log 2>&1 | less -R
        return 0
    fi

    jobs_json="$(glab api "projects/$(project_id)/pipelines/${pid}/jobs" --paginate 2>/dev/null)" \
        || fail "failed to list jobs for ${pid}"
    {
        while IFS=$'\t' read -r job_id job_name; do
            [ -z "${job_id}" ] && continue
            printf '\n\033[1m===== %s (job %s) =====\033[0m\n' "${job_name}" "${job_id}"
            glab api "projects/$(project_id)/jobs/${job_id}/trace" 2>/dev/null
        done < <(jq -rs 'add // [] | sort_by(.id) | .[] | [(.id | tostring), .name] | @tsv' <<< "${jobs_json}")
    } | less -R
}

open_url() {
    local url="${1}"

    [ -z "${url}" ] && fail "no URL for the selected pipeline"
    need_cmd gio
    gio open "${url}" &>/dev/null
}

handle_key() {
    local key line pid url

    key="$(head -n 1 <<< "${key_result}")"
    line="$(tail -n 1 <<< "${key_result}")"
    pid="$(awk '{print $1}' <<< "${line}")"
    url="$(awk '{print $NF}' <<< "${line}")"

    case "${key}" in
        enter)
            echo "${line}"
            need_cmd clip
            printf '%s' "${url}" | clip
            exit 1
            ;;
        ctrl-o)
            open_url "${url}"
            exit 0
            ;;
        ctrl-l)
            show_logs "${pid}"
            exit 0
            ;;
        esc|ctrl-c|ctrl-d)
            exit 255
            ;;
        *)
            fail "Unknown key: ${key}"
            ;;
    esac
}

write_state() {
    {
        printf 'provider=%q\n' "${provider}"
        printf 'github_repository=%q\n' "${github_repository}"
        printf 'github_repo_selector=%q\n' "${github_repo_selector}"
        declare -p github_api_args
        printf 'PROJECT_ID=%q\n' "${PROJECT_ID:-}"
        printf 'repo_dir=%q\n' "${PWD}"
        # the query context, so a --watch reload can fetch the result set again
        printf 'refresh=%q\n' "${refresh}"
        printf 'action=%q\n' "${action}"
        printf 'ref=%q\n' "${ref}"
        printf 'tag_limit=%q\n' "${tag_limit}"
        printf 'source=%q\n' "${source}"
        printf 'grep_pattern=%q\n' "${grep_pattern}"
        printf 'per_page=%q\n' "${per_page}"
        printf 'paginate=%q\n' "${paginate}"
        declare -p statuses
        declare -p var_specs
    } > "${STATE_FILE}"
}

fetch_pipelines() {
    case "${action}" in
        status) cmd_status ;;
        search) cmd_search ;;
        *)      return 1 ;;
    esac
}

# pipelines that are not in a final state yet, so the view has to keep updating
has_active_pipelines() {
    jq -e '
        any(.[].status; . == "created" or . == "waiting_for_resource" or . == "preparing"
            or . == "pending" or . == "queued" or . == "requested" or . == "waiting"
            or . == "running" or . == "in_progress")
    ' <<< "${1}" >/dev/null
}

pick_pipelines() {
    local watch_args=() refresh_bind=() footer_args=()

    # a list nothing was silently dropped from has nothing to name
    { [ -n "${grep_pattern}" ] || [ "${#var_specs[@]}" -gt 0 ]; } \
        && footer_args=(--footer-prefix "${APP_NAME} --id ${id} --footer")

    if [ "${refresh}" -eq 1 ]; then
        # reload once shortly after the picker opened - a pipeline may have
        # started in the meantime - then keep reloading while something runs
        watch_args=("--watch" "${watch_seconds}"
                    "--watch-delay" "${WATCH_FIRST_DELAY}"
                    "--watch-while" "${APP_NAME} --id ${id} --active")
        # keep the job preview in sync with every reload of the list
        refresh_bind=("--bind=result:refresh-preview")
    fi

    fzf-with-header --key-command "${APP_NAME} --id ${id} --key" \
                    --key-descriptions "${KEY_DESCS}" \
                    --exec-keys "${EXEC_KEYS}" \
                    --silent-keys "${SILENT_KEYS}" \
                    --columns 1,2,3,4,5 \
                    --command "${APP_NAME} --id ${id} --print" \
                    "${footer_args[@]}" \
                    "${watch_args[@]}" \
                    "${query}" \
                    --preview="${APP_NAME} --id ${id} --preview {1}" \
                    --preview-window=right:50%,wrap \
                    "${refresh_bind[@]}" \
                    --expect="${KEYS}" \
                    --no-sort
}

cmd_search() {
    local pipelines pid
    local matched_ids=()

    [ "${provider}" = "github" ] && [ "${#var_specs[@]}" -gt 0 ] \
        && fail "--var is not supported for GitHub Actions"

    pipelines="$(list_pipelines_json)" || fail "failed to list pipelines"

    [ "${TRUNCATED}" -eq 1 ] \
        && warning "Hit the ${per_page}-result page limit; more pipelines may match. Use -a/--all or raise -n/--limit."

    # merge before filtering, so --var/--grep apply to the tag pipelines as well
    pipelines="$(merge_tag_pipelines "${pipelines}")"

    [ -n "${grep_pattern}" ] && echo "Searching job logs (this may take a while)..." 1>&2

    while IFS= read -r pid; do
        [ -z "${pid}" ] && continue
        [ "${#var_specs[@]}" -gt 0 ] && { match_gitlab_vars "${pid}" || continue; }
        if [ -n "${grep_pattern}" ]; then
            if [ "${provider}" = "github" ]; then
                match_github_grep "${pid}" || continue
            else
                match_gitlab_grep "${pid}" || continue
            fi
        fi
        matched_ids+=("${pid}")
    done < <(jq -r '.[].id' <<< "${pipelines}")

    local ids_json
    ids_json="$(printf '%s\n' "${matched_ids[@]}" | jq -R 'select(length>0) | tonumber' | jq -s '.')"

    jq --argjson ids "${ids_json}" '[ .[] | select(.id as $i | $ids | index($i)) ]' <<< "${pipelines}"
}

need_cmd git

action=""
repo=""
provider=""
github_repository=""
github_repo_selector=""
github_api_args=()
ref=""
all_refs=0
tag_limit="${TAG_LIMIT_DEFAULT}"
source=""
grep_pattern=""
output="txt"
per_page="${PER_PAGE_DEFAULT}"
paginate=0
statuses=()
var_specs=()
TRUNCATED=0
mode="list"
watch_seconds="${WATCH_SECONDS_DEFAULT}"
refresh=0
id=$$
id_given=0
query=""
key_result=""
preview_id=""

add_status() {
    statuses+=("${1}")
}

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        -r|--repo)
            shift
            [ -z "${1:-}" ] && error "Missing repo argument" && usage
            repo="${1}"
            ;;
        --ref)
            shift
            [ -z "${1:-}" ] && error "Missing ref argument" && usage
            ref="${1}"
            ;;
        --all-refs)
            all_refs=1
            ;;
        --tags)
            shift
            [ -z "${1:-}" ] && error "Missing tags argument" && usage
            ! [[ "${1}" =~ ^[0-9]+$ ]] && error "Invalid tags count: ${1}" && usage
            [ "${1}" -gt 100 ] && error "Tags count must be between 0 and 100" && usage
            tag_limit="${1}"
            ;;
        --no-tags)
            tag_limit=0
            ;;
        -q|--query)
            shift
            [ -z "${1:-}" ] && error "Missing query argument" && usage
            query="${1}"
            ;;
        -p|--print)
            mode="print"
            ;;
        -w|--watch)
            shift
            [ -z "${1:-}" ] && error "Missing watch argument" && usage
            ! [[ "${1}" =~ ^[0-9]+$ ]] && error "Invalid watch interval: ${1}" && usage
            watch_seconds="${1}"
            ;;
        --id)
            shift
            [ -z "${1:-}" ] && error "Missing id argument" && usage
            id="${1}"
            id_given=1
            ;;
        --key)
            shift
            [ -z "${1:-}" ] && error "Missing key argument" && usage
            mode="key"
            key_result="${1}"
            ;;
        --preview)
            shift
            [ -z "${1:-}" ] && error "Missing preview argument" && usage
            mode="preview"
            preview_id="${1}"
            ;;
        --active)
            mode="active"
            ;;
        --footer)
            mode="footer"
            ;;
        --var)
            shift
            [ -z "${1:-}" ] && error "Missing var argument" && usage
            var_specs+=("${1}")
            ;;
        --grep)
            shift
            [ -z "${1:-}" ] && error "Missing grep argument" && usage
            grep_pattern="${1}"
            ;;
        --source)
            shift
            [ -z "${1:-}" ] && error "Missing source argument" && usage
            source="${1}"
            ;;
        -s|--status)
            shift
            [ -z "${1:-}" ] && error "Missing status argument" && usage
            add_status "${1}"
            ;;
        --failed)    add_status "failed" ;;
        --succeeded) add_status "success" ;;
        --aborted)   add_status "canceled" ;;
        --running)   add_status "running" ;;
        --pending)   add_status "pending" ;;
        --manual)    add_status "manual" ;;
        --skipped)   add_status "skipped" ;;
        -n|--limit)
            shift
            [ -z "${1:-}" ] && error "Missing limit argument" && usage
            ! [[ "${1}" =~ ^[0-9]+$ ]] && error "Invalid limit: ${1}" && usage
            { [ "${1}" -lt 1 ] || [ "${1}" -gt 100 ]; } && error "Limit must be between 1 and 100" && usage
            per_page="${1}"
            ;;
        -a|--all)
            paginate=1
            ;;
        -o|--output)
            shift
            [ -z "${1:-}" ] && error "Missing output argument" && usage
            [ "${1}" != "txt" ] && [ "${1}" != "json" ] && error "Invalid output argument: ${1}" && usage
            output="${1}"
            ;;
        status|search)
            [ -n "${action}" ] && error "Unknown command: ${1}" && usage
            action="${1}"
            ;;
        *)
            error "Unknown argument: ${1}"
            usage
            ;;
    esac
    shift
done

need_cmd jq

STATE_FILE="/tmp/${APP_NAME}-${id}.state"
JSON_FILE="/tmp/${APP_NAME}-${id}.json"

# --key, --preview and --print are called by the picker with the id of the run
# that produced the result set; reuse its state and cached pipelines
if [ "${id_given}" -eq 1 ] && [ -f "${STATE_FILE}" ] && [ -f "${JSON_FILE}" ]; then
    # shellcheck source=/dev/null
    . "${STATE_FILE}"
    cd "${repo_dir}" || fail "failed to enter ${repo_dir}"
    if [ "${provider}" = "github" ]; then
        need_cmd gh
    else
        need_cmd glab
    fi
    case "${mode}" in
        active)
            has_active_pipelines "$(cat "${JSON_FILE}")"
            exit $?
            ;;
        footer)
            print_footer
            exit 0
            ;;
        key)
            handle_key
            ;;
        preview)
            show_jobs "${preview_id}"
            exit 0
            ;;
        print)
            need_cmd k-format
            pipelines=""
            # every reload refetches, so a pipeline that started after the picker
            # opened shows up; the watcher stops on its own once nothing runs
            # anymore, a manual refresh still refetches and its result is what
            # lets the watcher pick the watching back up
            if [ "${refresh:-0}" -eq 1 ]; then
                pipelines="$(fetch_pipelines 2>/dev/null)"
                [ -n "${pipelines}" ] && printf '%s\n' "${pipelines}" > "${JSON_FILE}"
            fi
            [ -z "${pipelines}" ] && pipelines="$(cat "${JSON_FILE}")"
            print_pipelines "${pipelines}"
            exit 0
            ;;
    esac
fi

case "${mode}" in
    key|preview|active|footer)
        fail "no cached pipeline result for id ${id}"
        ;;
esac

[ -z "${action}" ] && error "Missing command" && usage

if [ "${action}" = "status" ]; then
    { [ "${#statuses[@]}" -gt 0 ] || [ "${#var_specs[@]}" -gt 0 ] || [ -n "${grep_pattern}" ] || [ -n "${source}" ] \
        || [ "${paginate}" -eq 1 ] || [ "${per_page}" != "${PER_PAGE_DEFAULT}" ] \
        || [ "${all_refs}" -eq 1 ]; } \
        && error "Those options are only valid for 'search'" && usage
fi

[ "${all_refs}" -eq 1 ] && [ -n "${ref}" ] && error "--ref and --all-refs are mutually exclusive" && usage

cded=0
if [ -n "${repo}" ]; then
    need_cmd git-find-repo
    cd "$(git-find-repo "${repo}")" || abort
    cded=1
fi

if [ -z "${ref}" ] && [ "${all_refs}" -eq 0 ]; then
    ref="$(git branch --show-current)"
    [ -z "${ref}" ] && fail "failed to determine current branch (detached HEAD?); use --ref$([ "${action}" = "search" ] && echo " or --all-refs")"
fi

remote_url="$(git remote get-url origin)" || fail "failed to determine origin remote"
detect_provider "${remote_url}"
if [ "${provider}" = "github" ]; then
    need_cmd gh
else
    need_cmd glab
fi

[ "${provider}" = "gitlab" ] && project_id >/dev/null

pipelines="$(fetch_pipelines)" || exit 1

pipeline_count="$(jq 'length' <<< "${pipelines}")"

exit_code=0
if [ "${output}" = "json" ]; then
    echo "${pipelines}"
elif [ "${pipeline_count}" -eq 0 ]; then
    log "No pipelines."
elif [ "${mode}" = "print" ] || [ ! -t 1 ]; then
    need_cmd k-format
    print_pipelines "${pipelines}"
else
    need_cmd k-format
    need_cmd fzf-with-header
    if [ "${watch_seconds}" -gt 0 ]; then
        if [ -n "${grep_pattern}" ] || [ "${#var_specs[@]}" -gt 0 ]; then
            has_active_pipelines "${pipelines}" \
                && warning "pipelines are still running, but --grep/--var results are too expensive to refresh automatically"
        else
            refresh=1
        fi
    fi
    trap 'rm -f "${STATE_FILE}" "${JSON_FILE}"' EXIT
    printf '%s\n' "${pipelines}" > "${JSON_FILE}"
    write_state
    pick_pipelines "${pipelines}"
    exit_code=$?
fi

if [ "${cded}" -eq 1 ]; then
    cd - &> /dev/null || fail "failed to return to previous directory"
fi
exit "${exit_code}"
