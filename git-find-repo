#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }
git-color() { command git-color --color=always "$@"; }

usage() {
    cat <<EOF 1>&2
usage: $(basename "${0}") [--workspace|-W <path, default \$WORKSPACE>] [--vc-folder|-F <folder, default \$VC_FOLDER>] [--update-listing|-U] [--update-remote-listing] [--list|-L] [--list-remote|-R] [--print-history|--history|-H] [--no-git-clone] [--no-history] [--no-checkout] <project|url|mr-url|pr-url|mr-id|->
EOF
    exit 1
}

error() {
    print-text-error "ERROR: ${1}" 1>&2
}

warning() {
    print-text-warning "WARNING: ${1}" 1>&2
}

note() {
    print-text-muted "${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

listing_cache_file() {
    local workspace_key

    workspace_key="${workspace}"
    if [ -n "${HOME}" ]; then
        workspace_key="${workspace_key#${HOME}/}"
        [ "${workspace_key}" = "${workspace}" ] && workspace_key="${workspace_key#${HOME}}"
    fi
    workspace_key="${workspace_key#/}"

    echo "${HOME}/.cache/git-find-repo/${workspace_key}/${vc_folder}-listing"
}

history_cache_file() {
    local workspace_key

    workspace_key="${workspace}"
    if [ -n "${HOME}" ]; then
        workspace_key="${workspace_key#${HOME}/}"
        [ "${workspace_key}" = "${workspace}" ] && workspace_key="${workspace_key#${HOME}}"
    fi
    workspace_key="${workspace_key#/}"

    echo "${HOME}/.cache/git-find-repo/${workspace_key}/${vc_folder}-history"
}

record_history() {
    [ "${no_history}" -eq 1 ] && return 0
    local history_file
    local history_dir
    local history_entry
    local history_path
    local timestamp

    history_entry="${1}"
    [ -z "${history_entry}" ] && return 0

    history_file="$(history_cache_file)"
    history_dir="$(dirname "${history_file}")"
    mkdir -p "${history_dir}" || fail "Could not create cache dir ${history_dir}"
    history_path="${history_entry}"

    timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
    history_entry="${timestamp}"$'\t'"${history_path}"
    printf '%s\n' "${history_entry}" >> "${history_file}" || fail "Could not update history cache ${history_file}"
}

record_switch() {
    local target_dir

    target_dir="${1}"
    # the repo being left goes in first, so that "-" can go back to it even
    # when it was not entered through here
    [ -n "${current_dir}" ] && [ "${current_dir}" != "${target_dir}" ] && record_history "${current_dir}"
    record_history "${target_dir}"
}

print_history() {
    local history_file

    history_file="$(history_cache_file)"
    [ -f "${history_file}" ] && cat "${history_file}"
}

current_project_dir() {
    local dir
    local parent

    dir="${PWD}"
    case "${dir}" in
        "${workspace}"|"${workspace}"/*)
            ;;
        *)
            return 0
            ;;
    esac

    while :; do
        [ -d "${dir}/${vc_folder}" ] && {
            printf '%s\n' "${dir}"
            return 0
        }

        [ "${dir}" = "${workspace}" ] && break
        parent="$(dirname "${dir}")"
        [ "${parent}" = "${dir}" ] && break
        dir="${parent}"
    done
}

recent_history_entries() {
    local history_file
    local excluded_path
    local timestamp
    local history_path
    local count

    history_file="$(history_cache_file)"
    excluded_path="${1}"
    count=0
    [ -f "${history_file}" ] || return 0

    # newest first, each repo once with the time of its last visit, skipping
    # the ones deleted since
    tac "${history_file}" | awk -F '\t' -v excluded_path="${excluded_path}" '
        NF >= 2 && $2 != excluded_path && !seen[$2]++ { print $1 "\t" $2 }
    ' | while IFS=$'\t' read -r timestamp history_path; do
        [ -d "${history_path}" ] || continue
        printf '%s\t%s\n' "${timestamp}" "${history_path}"
        count=$((count + 1))
        [ "${count}" -ge 10 ] && break
    done
}

choose_history_entry() {
    local entries
    local timestamp
    local history_path
    local width

    entries="${1}"
    width=0
    while IFS=$'\t' read -r timestamp history_path; do
        history_path="$(relative_repo_path "${history_path}")"
        [ "${#history_path}" -gt "${width}" ] && width="${#history_path}"
    done <<< "${entries}"

    while IFS=$'\t' read -r timestamp history_path; do
        printf '%s\t%-*s  %s\n' "${history_path}" "${width}" "$(relative_repo_path "${history_path}")" \
            "${timestamp:0:10} ${timestamp:11:5}"
    done <<< "${entries}" | prompt-select --prompt "Go to:" --delimiter '\t'
}

generate_listing() {
    local repo_paths
    local repo_path

    repo_paths="$(
        find "${workspace}" -type d -name "${vc_folder}" -prune -print 2>/dev/null \
        | sed "s:/${vc_folder}\$::" \
        | LC_ALL=C sort -u \
        | awk 'NR==1{keep=$0; print; next} { if (index($0, keep"/")!=1) {keep=$0; print} }'
    )"

    while IFS= read -r repo_path; do
        [ -z "${repo_path}" ] && continue
        printf '%s\t%s\n' "$(format_repo_name "${repo_path}" "${repo_paths}")" "${repo_path}"
    done <<< "${repo_paths}"
}

relative_repo_path() {
    local repo_path

    repo_path="${1#${workspace}/}"
    repo_path="${repo_path#${workspace}}"
    repo_path="${repo_path#/}"
    printf '%s\n' "${repo_path}"
}

repo_parent_path() {
    local relative_path

    relative_path="$(relative_repo_path "${1}")"
    dirname "${relative_path}"
}

repo_disambiguator() {
    local repo_path
    local listing

    repo_path="${1}"
    listing="${2}"

    awk -v target="${repo_path}" -v workspace="${workspace}" -v workspace_name="$(basename -- "${workspace}")" '
        function rel(path) {
            sub("^" workspace "/?", "", path)
            sub("^/", "", path)
            return path
        }
        function dirname_of(path,   copy) {
            copy = path
            if (copy !~ /\//) {
                return "."
            }
            sub("/[^/]+$", "", copy)
            return copy == "" ? "." : copy
        }
        function basename_of(path,   copy) {
            copy = path
            sub("^.*/", "", copy)
            return copy
        }
        function count_parts(path,   n, copy) {
            copy = path
            if (copy == "." || copy == "") {
                return 0
            }
            n = split(copy, _, "/")
            return n
        }
        function suffix_parts(path, count,   n, parts, start, out, i) {
            if (count <= 0 || path == "." || path == "") {
                return ""
            }
            n = split(path, parts, "/")
            start = n - count + 1
            if (start < 1) {
                start = 1
            }
            out = parts[start]
            for (i = start + 1; i <= n; i++) {
                out = out "/" parts[i]
            }
            return out
        }
        BEGIN {
            target_rel = rel(target)
            target_name = basename_of(target_rel)
            target_parent = dirname_of(target_rel)
        }
        {
            current_rel = rel($0)
            current_name = basename_of(current_rel)
            if (current_name != target_name) {
                next
            }
            current_parent = dirname_of(current_rel)
            parents[++count] = current_parent
            if (current_rel == target_rel) {
                target_index = count
            }
        }
        END {
            if (count <= 1 || target_index == 0) {
                exit
            }

            max_parts = count_parts(target_parent)
            for (parts = 1; parts <= max_parts; parts++) {
                target_suffix = suffix_parts(target_parent, parts)
                unique = 1
                for (i = 1; i <= count; i++) {
                    if (i == target_index) {
                        continue
                    }
                    if (suffix_parts(parents[i], parts) == target_suffix) {
                        unique = 0
                        break
                    }
                }
                if (unique) {
                    if (target_suffix == ".") {
                        print "#" workspace_name
                    } else {
                        print "#" target_suffix
                    }
                    exit
                }
            }

            if (target_parent == ".") {
                print "#" workspace_name
            } else {
                print "#" target_parent
            }
        }
    ' <<< "${listing}"
}

format_repo_name() {
    local repo_path
    local listing
    local repo_name
    local disambiguator

    repo_path="${1}"
    listing="${2}"
    repo_name="$(basename -- "${repo_path}")"
    disambiguator="$(repo_disambiguator "${repo_path}" "${listing}")"
    printf '%s%s\n' "${repo_name}" "${disambiguator}"
}

listing_repo_path() {
    local listing_entry

    listing_entry="${1}"
    case "${listing_entry}" in
        *$'\t'*)
            printf '%s\n' "${listing_entry#*$'\t'}"
            ;;
        *)
            printf '%s\n' "${listing_entry}"
            ;;
    esac
}

project_matches_repo() {
    local requested_project
    local listing_entry
    local repo_path
    local repo_name
    local repo_parent
    local requested_name
    local qualifier

    requested_project="${1}"
    listing_entry="${2}"
    repo_path="$(listing_repo_path "${listing_entry}")"
    repo_name="$(basename -- "${repo_path}")"
    repo_parent="$(repo_parent_path "${repo_path}")"

    case "${requested_project}" in
        *"#"*)
            requested_name="${requested_project%%#*}"
            qualifier="${requested_project#*#}"
            [ "${requested_name}" = "${repo_name}" ] || return 1
            case "${repo_parent}" in
                "${qualifier}"|*/"${qualifier}")
                    return 0
                    ;;
                ".")
                    [ "${qualifier}" = "$(basename -- "${workspace}")" ] && return 0
                    ;;
            esac
            return 1
            ;;
        *)
            case "${repo_path}" in
                */"${requested_project}")
                    return 0
                    ;;
            esac
            return 1
            ;;
    esac
}

find_matching_repos() {
    local requested_project
    local listing
    local listing_entry
    local matched_paths

    requested_project="${1}"
    listing="${2}"
    matched_paths=""

    while IFS= read -r listing_entry; do
        [ -z "${listing_entry}" ] && continue
        if project_matches_repo "${requested_project}" "${listing_entry}"; then
            matched_paths="${matched_paths}$(listing_repo_path "${listing_entry}")"$'\n'
        fi
    done <<< "${listing}"

    printf '%s' "${matched_paths}"
}

find_similar_repos() {
    local requested_project
    local listing
    local listing_entry
    local repo_path
    local candidate
    local similar_paths

    # a qualifier only narrows exact matches, the name alone is looked for here
    requested_project="${1%%#*}"
    requested_project="${requested_project,,}"
    listing="${2}"
    similar_paths=""
    [ -z "${requested_project}" ] && return 0

    while IFS= read -r listing_entry; do
        [ -z "${listing_entry}" ] && continue
        repo_path="${listing_entry#*$'\t'}"
        # a name is looked for in the repo name, a path in the relative path
        case "${requested_project}" in
            */*)
                candidate="${repo_path#"${workspace}"/}"
                ;;
            *)
                candidate="${repo_path##*/}"
                ;;
        esac
        [[ "${candidate,,}" == *"${requested_project}"* ]] && similar_paths="${similar_paths}${repo_path}"$'\n'
    done <<< "${listing}"

    printf '%s' "${similar_paths}"
}

choose_similar_repo() {
    local similar_paths
    local repo_path

    similar_paths="${1}"
    {
        while IFS= read -r repo_path; do
            [ -z "${repo_path}" ] && continue
            printf '%s\t%s\n' "${repo_path}" "$(relative_repo_path "${repo_path}")"
        done <<< "${similar_paths}"
        # the key cannot clash with a repo, those are absolute paths
        [ "${no_git_clone}" -eq 0 ] && printf '%s\t%s\n' "online" "Find ${project} online"
    } | prompt-select --prompt "Choose repository:" --delimiter '\t'
}

# the sources whose repos are completed and cloned even when not cloned yet, in
# the order a bare repo name is looked up in: github.com/<owner> lists the
# repos of a GitHub owner with gh, <host>/<group> the projects of a GitLab group
# and its subgroups with glab, and a bare <host> all GitLab projects of the
# groups and namespaces one is a member of
remote_sources() {
    printf '%s\n' ${GIT_FIND_REPO_REMOTES:-github.com/dgrieser github.com/mittwald gitlab.mittwald.it}
}

remote_listing_cache_file() {
    echo "${HOME}/.cache/git-find-repo/remote-listing"
}

# the repo paths of one source, one per line
list_source_repos() {
    local host
    local group
    local endpoint
    local pages
    local page_dir
    local status

    host="${1%%/*}"
    group="${1#*/}"
    [ "${group}" = "${1}" ] && group=""
    case "${host}" in
        github.com)
            command -v gh &>/dev/null || return 1
            gh repo list "${group}" --limit 10000 --json nameWithOwner -q '.[].nameWithOwner'
            return
            ;;
    esac

    command -v glab &>/dev/null || return 1
    if [ -n "${group}" ]; then
        endpoint="groups/${group//\//%2F}/projects?include_subgroups=true&simple=true&per_page=100"
    else
        endpoint="projects?membership=true&simple=true&per_page=100"
    fi
    export GITLAB_HOST="${host}"
    # the pages are fetched side by side, which takes a second or two instead of
    # many; GitLab leaves out the page count for very large results, which are
    # then paged through one after the other
    pages="$(glab api -i "${endpoint}&page=1" 2>/dev/null | tr -d '\r' | awk -F ': ' 'tolower($1) == "x-total-pages" { print $2; exit }')"
    if [[ "${pages}" =~ ^[0-9]+$ ]]; then
        [ "${pages}" -eq 0 ] && return 0
        # each page goes to a file of its own, their output would interleave
        page_dir="$(mktemp -d)" || return 1
        seq 1 "${pages}" | xargs -P 8 -I '{}' sh -c 'glab api "${1}&page=${2}" > "${3}/${2}"' _ "${endpoint}" '{}' "${page_dir}" \
            && cat "${page_dir}"/* | jq -r '.[].path_with_namespace'
        status=$?
        rm -rf "${page_dir}"
        return "${status}"
    else
        glab api --paginate "${endpoint}" | jq -r '.[].path_with_namespace'
    fi
}

# <source>\t<path> per line for all repos of the remote sources, in source
# order; the sources are fetched side by side
update_remote_listing() {
    local cache_file
    local temp_dir
    local source
    local index
    local failed

    cache_file="$(remote_listing_cache_file)"
    mkdir -p "$(dirname "${cache_file}")" || return 1
    temp_dir="$(mktemp -d "${cache_file}.tmp.XXXXXX")" || return 1
    index=0
    for source in $(remote_sources); do
        index=$((index + 1))
        (
            set -o pipefail
            list_source_repos "${source}" 2>/dev/null | LC_ALL=C sort -u \
                | awk -v source="${source}" '{ print source "\t" $0 }' > "${temp_dir}/${index}" \
                || rm -f "${temp_dir}/${index}"
        ) &
    done
    wait
    # a failing source keeps the old listing rather than dropping its repos
    failed=0
    for (( ; index > 0; index-- )); do
        [ -f "${temp_dir}/${index}" ] || failed=1
    done
    if [ "${failed}" -eq 0 ]; then
        cat $(ls "${temp_dir}" | sort -n | sed "s|^|${temp_dir}/|") > "${temp_dir}/listing" \
            && mv "${temp_dir}/listing" "${cache_file}" || failed=1
    fi
    rm -rf "${temp_dir}"
    [ "${failed}" -eq 0 ]
}

# remote repo paths not cloned to ${workspace}/<path>; the listing is kept for
# good and only fetched when missing, resolve_remote_repo refetches it when it
# turns out to be out of date
list_remote_repos() {
    local cache_file
    local source
    local remote_repo

    cache_file="$(remote_listing_cache_file)"
    if [ ! -s "${cache_file}" ]; then
        update_remote_listing || return 0
    fi

    while IFS=$'\t' read -r source remote_repo; do
        [ -z "${remote_repo}" ] && continue
        [ -d "${workspace}/${remote_repo}" ] && continue
        printf '%s\n' "${remote_repo}"
    done < "${cache_file}" | awk '!seen[$0]++'
}

# the <source>\t<path> lines of the remote repos that a path or a bare repo name
# names, ignoring case, all from the first source in remote_sources having any
find_remote_repos() {
    local requested_project
    local cache_file

    requested_project="${1}"
    cache_file="$(remote_listing_cache_file)"
    [ -f "${cache_file}" ] && [ -n "${requested_project}" ] || return 1
    awk -F '\t' -v requested="${requested_project,,}" '
        {
            path = tolower($2)
            if (requested ~ /\//) {
                if (path != requested) next
            } else {
                name = path
                sub(/^.*\//, "", name)
                if (name != requested) next
            }
            if (source == "") source = $1
            if ($1 == source) { print; found = 1 }
        }
        END { exit !found }
    ' "${cache_file}"
}

# the <source>\t<path> of the one remote repo a path or bare name names, picked
# when the first source has several
pick_remote_repo() {
    local found
    local choice

    found="$(find_remote_repos "${1}")" || return 1
    if [ "$(wc -l <<< "${found}")" -gt 1 ]; then
        choice="$(awk -F '\t' '{ host = $1; sub(/\/.*/, "", host); print NR "\t" host "/" $2 }' <<< "${found}" \
            | prompt-select --prompt "Choose repository:" --delimiter '\t')" || return 1
        found="$(sed -n "${choice}p" <<< "${found}")"
    fi
    printf '%s\n' "${found}"
}

remote_repo_url() {
    local source

    source="${1%%$'\t'*}"
    printf 'git@%s:%s.git\n' "${source%%/*}" "${1#*$'\t'}"
}

# whether a <source>\t<path> repo still exists; only an API answering 404
# counts as gone, so being offline or the like does not refetch the listing
remote_repo_exists() {
    local source
    local path
    local host
    local output

    source="${1%%$'\t'*}"
    path="${1#*$'\t'}"
    host="${source%%/*}"
    if [ "${host}" = "github.com" ]; then
        output="$(gh api "repos/${path}" --silent 2>&1)"
    else
        output="$(GITLAB_HOST="${host}" glab api "projects/${path//\//%2F}" 2>&1 >/dev/null)"
    fi
    [[ "${output}" != *"HTTP 404"* ]]
}

# drops a <source>\t<path> line from the cached remote listing
forget_remote_repo() {
    local cache_file
    local temp_file

    cache_file="$(remote_listing_cache_file)"
    temp_file="$(mktemp "${cache_file}.tmp.XXXXXX")" || return 1
    grep -vxF -- "${1}" "${cache_file}" > "${temp_file}"
    mv "${temp_file}" "${cache_file}" || rm -f "${temp_file}"
}

# like pick_remote_repo, but a repo that no longer exists is dropped from the
# cached listing and left to the usual lookup, as is one missing from it; the
# listing is only fetched here when there is none yet
resolve_remote_repo() {
    local remote_repo

    [ -s "$(remote_listing_cache_file)" ] || update_remote_listing || return 1
    remote_repo="$(pick_remote_repo "${1}")" || return 1
    remote_repo_exists "${remote_repo}" && {
        printf '%s\n' "${remote_repo}"
        return 0
    }
    note "$(remote_repo_url "${remote_repo}") no longer exists, removing it from the remote listing"
    forget_remote_repo "${remote_repo}"
    return 1
}

update_listing() {
    local cache_file
    local cache_dir
    local temp_file

    cache_file="$(listing_cache_file)"
    cache_dir="$(dirname "${cache_file}")"
    mkdir -p "${cache_dir}" || fail "Could not create cache dir ${cache_dir}"
    temp_file="$(mktemp "${cache_file}.tmp.XXXXXX")" || fail "Could not create temp listing cache ${cache_file}.tmp.XXXXXX"
    generate_listing > "${temp_file}" || {
        rm -f "${temp_file}"
        fail "Could not write listing cache ${cache_file}"
    }
    if [ ! -s "${temp_file}" ]; then
        rm -f "${temp_file}"
        fail "Refusing to replace listing cache ${cache_file} with an empty listing"
    fi
    mv "${temp_file}" "${cache_file}" || {
        rm -f "${temp_file}"
        fail "Could not replace listing cache ${cache_file}"
    }
}

checkout_requested_ref() {
    local repo_path
    local branch
    local info

    repo_path="${1}"
    [ "${no_checkout}" -eq 1 ] && return 0
    [ -z "${checkout_mr_id}" ] && [ -z "${checkout_pr_id}" ] && [ -z "${checkout_source_branch}" ] && return 0

    (
        cd "${repo_path}" || fail "Unable to change directory to: ${repo_path}"
        git-checkout 1>&2 || fail "Unable to checkout default branch"
        git-color pull 1>&2 || fail "Unable to pull default branch"
        branch="${checkout_source_branch}"
        if [ -n "${checkout_mr_id}" ]; then
            info="$(glab mr view "${checkout_mr_id}" -F json)" || fail "Unable to get MR: ${checkout_mr_id}"
            branch="$(jq -r '.source_branch' <<< "${info}")"
            { [ -n "${branch}" ] && [ "${branch}" != "null" ]; } || fail "Unable to get source branch for MR: ${checkout_mr_id}"
            # the source branch of a fork MR does not exist on origin; prefix the
            # local branch with the fork owner so it cannot clash with ours
            if [ "$(jq -r '.source_project_id != .target_project_id' <<< "${info}")" = "true" ]; then
                branch="$(jq -r '.author.username' <<< "${info}")/${branch}"
                note "MR ${checkout_mr_id} is from a fork, checking out as: ${branch}"
                glab mr checkout "${checkout_mr_id}" --branch "${branch}" 1>&2 || fail "Unable to checkout fork MR: ${checkout_mr_id}"
                exit 0
            fi
        elif [ -n "${checkout_pr_id}" ]; then
            info="$(gh pr view "${checkout_pr_id}" --json headRefName,isCrossRepository,headRepositoryOwner)" || fail "Unable to get PR: ${checkout_pr_id}"
            branch="$(jq -r '.headRefName' <<< "${info}")"
            { [ -n "${branch}" ] && [ "${branch}" != "null" ]; } || fail "Unable to get source branch for PR: ${checkout_pr_id}"
            # see fork MR handling above
            if [ "$(jq -r '.isCrossRepository' <<< "${info}")" = "true" ]; then
                branch="$(jq -r '.headRepositoryOwner.login' <<< "${info}")/${branch}"
                note "PR ${checkout_pr_id} is from a fork, checking out as: ${branch}"
                gh pr checkout "${checkout_pr_id}" --branch "${branch}" 1>&2 || fail "Unable to checkout fork PR: ${checkout_pr_id}"
                exit 0
            fi
        else
            note "Switching to source branch: ${branch}"
        fi
        git-checkout "${branch}" 1>&2 || fail "Unable to switch to source branch: ${branch}"
        git-color pull 1>&2 || fail "Unable to pull source branch: ${branch}"
    ) || exit 1
}

project=""
workspace="${WORKSPACE}"
vc_folder="${VC_FOLDER}"
update_listing_only=0
update_remote_listing_only=0
list_only=0
list_remote_only=0
print_history_only=0
no_git_clone=0
no_history=0
no_checkout=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        --no-git-clone)
            no_git_clone=1
            ;;
        --no-history)
            no_history=1
            ;;
        --no-checkout)
            no_checkout=1
            ;;
        --update-listing|-U)
            update_listing_only=1
            ;;
        --update-remote-listing)
            update_remote_listing_only=1
            ;;
        --list|-L)
            list_only=1
            ;;
        --list-remote|-R)
            list_remote_only=1
            ;;
        --print-history|--history|-H)
            print_history_only=1
            ;;
        --workspace|-W)
            shift
            [ -z "${1}" ] && usage
            workspace="${1}"
            ;;
        --vc-folder|-F)
            shift
            [ -z "${1}" ] && usage
            vc_folder="${1}"
            ;;
        *)
            [ -z "${project}" ] || usage
            project="${1}"
            ;;
    esac
    shift
done

[ -z "${workspace}" ] && fail "WORKSPACE is not set"
[ -z "${vc_folder}" ] && fail "VC_FOLDER is not set"
# a trailing slash breaks prefix stripping and the traverse-up workspace check
workspace="${workspace%/}"
[ -z "${workspace}" ] && fail "WORKSPACE must not be /"

# migrate cache from the old script name (dev-find-project)
if [ -d "${HOME}/.cache/dev-find-project" ] && [ ! -e "${HOME}/.cache/git-find-repo" ]; then
    mv "${HOME}/.cache/dev-find-project" "${HOME}/.cache/git-find-repo" \
        || warning "Could not migrate cache from ${HOME}/.cache/dev-find-project"
fi
[ "${list_remote_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "${update_remote_listing_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "$((update_listing_only + update_remote_listing_only + list_only + list_remote_only + print_history_only))" -gt 1 ] && usage
[ "${update_listing_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "${list_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "${print_history_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "$((update_listing_only + update_remote_listing_only + list_only + list_remote_only + print_history_only))" -eq 0 ] && [ -z "${project}" ] && usage

if [ "${update_listing_only}" -eq 1 ]; then
    update_listing
    exit 0
fi

if [ "${update_remote_listing_only}" -eq 1 ]; then
    update_remote_listing || fail "Could not update remote listing $(remote_listing_cache_file)"
    exit 0
fi

if [ "${list_only}" -eq 1 ]; then
    cache_file="$(listing_cache_file)"
    if [ -f "${cache_file}" ] && [ -s "${cache_file}" ]; then
        listing="$(cat "${cache_file}")"
    else
        update_listing
        listing="$(cat "${cache_file}")"
    fi

    printf '%s\n' "${listing}"
    exit 0
fi

if [ "${list_remote_only}" -eq 1 ]; then
    list_remote_repos
    exit 0
fi

if [ "${print_history_only}" -eq 1 ]; then
    print_history
    exit 0
fi

# taken before anything changes directory
current_dir="$(current_project_dir)"

if [ "${project}" = "-" ]; then
    history_entries="$(recent_history_entries "${current_dir}")"
    [ -n "${history_entries}" ] || fail "No project history found"
    project="$(choose_history_entry "${history_entries}")" || exit 1
fi

checkout_mr_id=""
checkout_pr_id=""
checkout_source_branch=""

# a bare or !-prefixed MR number refers to the current repo, not a project name
if [[ "${project}" =~ ^!?[0-9]+$ ]]; then
    checkout_mr_id="${project#!}"
    git_root_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "Not inside a Git repository"
    checkout_requested_ref "${git_root_dir}"
    record_switch "${git_root_dir}"
    echo "${git_root_dir}"
    exit 0
fi

url=""

# a scheme-less URL (host/owner/repo...) is treated as https
if [[ "${project}" != *":"* ]] && [[ "${project}" =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}/ ]]; then
    project="https://${project}"
fi

if [[ "${project}" == *":/"* ]]; then
    url="${project}"
    if [[ "${url}" == *"/-/"* ]]; then
        url_ref="${url#*/-/}"
        case "${url_ref}" in
            merge_requests/*)
                checkout_mr_id="$(echo "${url_ref}" | grep -oE '^merge_requests/[0-9]+' | grep -oE '[0-9]+$')"
                ;;
            tree/*)
                checkout_source_branch="$(echo "${url_ref}" | sed -E 's|^tree/([^?#]+).*$|\1|')"
                ;;
        esac
        url="${url%%/-/*}"
    elif [[ "${url}" =~ ^[^:/]+://[^/]+/[^/]+/[^/]+/(pull|tree)/ ]]; then
        # GitHub style: https://github.com/<owner>/<repo>/pull/<id> or .../tree/<branch>
        url_base="$(echo "${url}" | sed -E 's|^([^:/]+://[^/]+/[^/]+/[^/]+)/.*$|\1|')"
        url_ref="${url#${url_base}/}"
        case "${url_ref}" in
            pull/*)
                checkout_pr_id="$(echo "${url_ref}" | grep -oE '^pull/[0-9]+' | grep -oE '[0-9]+$')"
                ;;
            tree/*)
                checkout_source_branch="$(echo "${url_ref}" | sed -E 's|^tree/([^?#]+).*$|\1|')"
                ;;
        esac
        url="${url_base}"
    fi
    project="$(echo "${url}" | sed -E 's|^[^:/]+:/{1,2}[^/]*||; s|[?#].*$||; s|\.git$||')"
elif [[ "${project}" == *":"* ]]; then
    [[ "${project}" == "git@"* ]] && url="${project}"
    project="$(echo "${project}" | sed -E 's|^[^:]+:||; s|[?#].*$||; s|\.git$||')"
fi

# remove leading slash
project="${project#/}"

if [[ "${project}" == *"/"* ]]; then
    # traverse up to find a git folder
    prj_git=""
    prj_candidate=""
    folder="${workspace}/${project}"
    while [ -z "${prj_git}" ]; do
        prj_git=$(find "${folder}" -maxdepth 1 -type d -name "${vc_folder}" 2> /dev/null | head -n 1)
        if [ -n "${prj_git}" ]; then
            prj_candidate=$(dirname "${prj_git}")
            prj_candidate="${prj_candidate#*${workspace}}"
            prj_candidate="${prj_candidate#/}"
            break
        fi
        parent=$(dirname "${folder}")
        if [ "${workspace}" == "${parent}" ] || [ "${parent}" == "${folder}" ]; then
            break
        fi
        folder="${parent}"
    done
    if [ -n "${prj_candidate}" ]; then
        folder="${workspace}/${prj_candidate}"
        if cd "${folder}"; then
            checkout_requested_ref "${folder}"
            record_switch "${folder}"
            echo "${folder}"
            exit 0
        fi
    fi
fi

# list all repos, trim .git, de-duplicate,
# match the project name or relative path
cache_file="$(listing_cache_file)"
listing_refreshed=0
if [ -f "${cache_file}" ]; then
    listing="$(cat "${cache_file}")"
    matches="$(find_matching_repos "${project}" "${listing}")"
else
    update_listing
    listing_refreshed=1
    listing="$(cat "${cache_file}")"
    matches="$(find_matching_repos "${project}" "${listing}")"
fi

if [ -z "${matches}" ] && [ "${listing_refreshed}" -eq 0 ]; then
    update_listing
    listing="$(cat "${cache_file}")"
    matches="$(find_matching_repos "${project}" "${listing}")"
fi

# a repo of a remote source, named by its path or by its name alone, is cloned
# from there right away, without offering similar repos or searching for it
if [ -z "${matches}" ] && [ -z "${url}" ] && [ "${no_git_clone}" -eq 0 ] \
    && remote_repo="$(resolve_remote_repo "${project}")" && [ -n "${remote_repo}" ]; then
    project="${remote_repo#*$'\t'}"
    url="$(remote_repo_url "${remote_repo}")"
fi

# without an exact match the repos containing the name are offered before going
# online; a URL names one repo exactly and goes online right away
not_found_warned=0
if [ -z "${matches}" ] && [ -z "${url}" ]; then
    similar="$(find_similar_repos "${project}" "${listing}")"
    if [ -n "${similar}" ]; then
        warning "${project} was not found locally."
        not_found_warned=1
        echo 1>&2
        choice="$(choose_similar_repo "${similar}")" || exit 1
        [ "${choice}" = "online" ] || matches="${choice}"
    fi
fi

match="$(printf '%s\n' "${matches}" | sed -n '1p')"
match_count="$(printf '%s\n' "${matches}" | sed '/^$/d' | wc -l)"

if [ "${match_count}" -gt 1 ]; then
    warning "${project} is ambiguous:"
    note "$(printf '%s\n' "${matches}" | sed '/^$/d' | sed 's/^/  • /')"
    note
    note "cd ${match}"
fi

if [ -z "${match}" ] && [ "${no_git_clone}" -eq 0 ]; then
    [ "${not_found_warned}" -eq 1 ] || warning "${project} was not found locally."
    clone_url="${url:-${project}}"
    note "Attempting to clone ${clone_url} ..."
    echo 1>&2
    folder="$(git-clone "${clone_url}")" || fail "Could not clone ${clone_url}"
    checkout_requested_ref "${folder}"
    record_switch "${folder}"
    echo "${folder}"
    exit 0
fi

[ -z "${match}" ] && fail "${project} was not found locally."
checkout_requested_ref "${match}"
record_switch "${match}"
echo "${match}"
