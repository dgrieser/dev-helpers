#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }
git-color() { command git-color --color=always "$@"; }

usage() {
    cat <<EOF 1>&2
usage: $(basename "${0}") [--workspace|-W <path, default \$WORKSPACE>] [--vc-folder|-F <folder, default \$VC_FOLDER>] [--update-listing|-U] [--update-remote-listing] [--list|-L] [--list-remote|-R] [--print-history|--history|-H] [--no-git-clone] [--no-history] [--no-checkout] <project|url|mr-url|pr-url|mr-id|->
EOF
    exit 1
}

error() {
    print-text-error "ERROR: ${1}" 1>&2
}

warning() {
    print-text-warning "WARNING: ${1}" 1>&2
}

note() {
    print-text-muted "${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

listing_cache_file() {
    local workspace_key

    workspace_key="${workspace}"
    if [ -n "${HOME}" ]; then
        workspace_key="${workspace_key#${HOME}/}"
        [ "${workspace_key}" = "${workspace}" ] && workspace_key="${workspace_key#${HOME}}"
    fi
    workspace_key="${workspace_key#/}"

    echo "${HOME}/.cache/git-find-repo/${workspace_key}/${vc_folder}-listing"
}

history_cache_file() {
    local workspace_key

    workspace_key="${workspace}"
    if [ -n "${HOME}" ]; then
        workspace_key="${workspace_key#${HOME}/}"
        [ "${workspace_key}" = "${workspace}" ] && workspace_key="${workspace_key#${HOME}}"
    fi
    workspace_key="${workspace_key#/}"

    echo "${HOME}/.cache/git-find-repo/${workspace_key}/${vc_folder}-history"
}

record_history() {
    [ "${no_history}" -eq 1 ] && return 0
    local history_file
    local history_dir
    local history_entry
    local history_path
    local timestamp

    history_entry="${1}"
    [ -z "${history_entry}" ] && return 0

    history_file="$(history_cache_file)"
    history_dir="$(dirname "${history_file}")"
    mkdir -p "${history_dir}" || fail "Could not create cache dir ${history_dir}"
    history_path="${history_entry}"

    timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
    history_entry="${timestamp}"$'\t'"${history_path}"
    printf '%s\n' "${history_entry}" >> "${history_file}" || fail "Could not update history cache ${history_file}"
}

record_switch() {
    local target_dir

    target_dir="${1}"
    # the repo being left goes in first, so that "-" can go back to it even
    # when it was not entered through here
    [ -n "${current_dir}" ] && [ "${current_dir}" != "${target_dir}" ] && record_history "${current_dir}"
    record_history "${target_dir}"
}

print_history() {
    local history_file

    history_file="$(history_cache_file)"
    [ -f "${history_file}" ] && cat "${history_file}"
}

current_project_dir() {
    local dir
    local parent

    dir="${PWD}"
    case "${dir}" in
        "${workspace}"|"${workspace}"/*)
            ;;
        *)
            return 0
            ;;
    esac

    while :; do
        [ -d "${dir}/${vc_folder}" ] && {
            printf '%s\n' "${dir}"
            return 0
        }

        [ "${dir}" = "${workspace}" ] && break
        parent="$(dirname "${dir}")"
        [ "${parent}" = "${dir}" ] && break
        dir="${parent}"
    done
}

recent_history_entries() {
    local history_file
    local excluded_path
    local timestamp
    local history_path
    local count

    history_file="$(history_cache_file)"
    excluded_path="${1}"
    count=0
    [ -f "${history_file}" ] || return 0

    # newest first, each repo once with the time of its last visit, skipping
    # the ones deleted since
    tac "${history_file}" | awk -F '\t' -v excluded_path="${excluded_path}" '
        NF >= 2 && $2 != excluded_path && !seen[$2]++ { print $1 "\t" $2 }
    ' | while IFS=$'\t' read -r timestamp history_path; do
        [ -d "${history_path}" ] || continue
        printf '%s\t%s\n' "${timestamp}" "${history_path}"
        count=$((count + 1))
        [ "${count}" -ge 10 ] && break
    done
}

choose_history_entry() {
    local entries
    local timestamp
    local history_path
    local width

    entries="${1}"
    width=0
    while IFS=$'\t' read -r timestamp history_path; do
        history_path="$(relative_repo_path "${history_path}")"
        [ "${#history_path}" -gt "${width}" ] && width="${#history_path}"
    done <<< "${entries}"

    while IFS=$'\t' read -r timestamp history_path; do
        printf '%s\t%-*s  %s\n' "${history_path}" "${width}" "$(relative_repo_path "${history_path}")" \
            "${timestamp:0:10} ${timestamp:11:5}"
    done <<< "${entries}" | prompt-select --prompt "Go to:" --delimiter '\t'
}

generate_listing() {
    local repo_paths
    local repo_path

    repo_paths="$(
        find "${workspace}" -type d -name "${vc_folder}" -prune -print 2>/dev/null \
        | sed "s:/${vc_folder}\$::" \
        | LC_ALL=C sort -u \
        | awk 'NR==1{keep=$0; print; next} { if (index($0, keep"/")!=1) {keep=$0; print} }'
    )"

    while IFS= read -r repo_path; do
        [ -z "${repo_path}" ] && continue
        printf '%s\t%s\n' "$(format_repo_name "${repo_path}" "${repo_paths}")" "${repo_path}"
    done <<< "${repo_paths}"
}

relative_repo_path() {
    local repo_path

    repo_path="${1#${workspace}/}"
    repo_path="${repo_path#${workspace}}"
    repo_path="${repo_path#/}"
    printf '%s\n' "${repo_path}"
}

repo_parent_path() {
    local relative_path

    relative_path="$(relative_repo_path "${1}")"
    dirname "${relative_path}"
}

repo_disambiguator() {
    local repo_path
    local listing

    repo_path="${1}"
    listing="${2}"

    awk -v target="${repo_path}" -v workspace="${workspace}" -v workspace_name="$(basename -- "${workspace}")" '
        function rel(path) {
            sub("^" workspace "/?", "", path)
            sub("^/", "", path)
            return path
        }
        function dirname_of(path,   copy) {
            copy = path
            if (copy !~ /\//) {
                return "."
            }
            sub("/[^/]+$", "", copy)
            return copy == "" ? "." : copy
        }
        function basename_of(path,   copy) {
            copy = path
            sub("^.*/", "", copy)
            return copy
        }
        function count_parts(path,   n, copy) {
            copy = path
            if (copy == "." || copy == "") {
                return 0
            }
            n = split(copy, _, "/")
            return n
        }
        function suffix_parts(path, count,   n, parts, start, out, i) {
            if (count <= 0 || path == "." || path == "") {
                return ""
            }
            n = split(path, parts, "/")
            start = n - count + 1
            if (start < 1) {
                start = 1
            }
            out = parts[start]
            for (i = start + 1; i <= n; i++) {
                out = out "/" parts[i]
            }
            return out
        }
        BEGIN {
            target_rel = rel(target)
            target_name = basename_of(target_rel)
            target_parent = dirname_of(target_rel)
        }
        {
            current_rel = rel($0)
            current_name = basename_of(current_rel)
            if (current_name != target_name) {
                next
            }
            current_parent = dirname_of(current_rel)
            parents[++count] = current_parent
            if (current_rel == target_rel) {
                target_index = count
            }
        }
        END {
            if (count <= 1 || target_index == 0) {
                exit
            }

            max_parts = count_parts(target_parent)
            for (parts = 1; parts <= max_parts; parts++) {
                target_suffix = suffix_parts(target_parent, parts)
                unique = 1
                for (i = 1; i <= count; i++) {
                    if (i == target_index) {
                        continue
                    }
                    if (suffix_parts(parents[i], parts) == target_suffix) {
                        unique = 0
                        break
                    }
                }
                if (unique) {
                    if (target_suffix == ".") {
                        print "#" workspace_name
                    } else {
                        print "#" target_suffix
                    }
                    exit
                }
            }

            if (target_parent == ".") {
                print "#" workspace_name
            } else {
                print "#" target_parent
            }
        }
    ' <<< "${listing}"
}

format_repo_name() {
    local repo_path
    local listing
    local repo_name
    local disambiguator

    repo_path="${1}"
    listing="${2}"
    repo_name="$(basename -- "${repo_path}")"
    disambiguator="$(repo_disambiguator "${repo_path}" "${listing}")"
    printf '%s%s\n' "${repo_name}" "${disambiguator}"
}

listing_repo_path() {
    local listing_entry

    listing_entry="${1}"
    case "${listing_entry}" in
        *$'\t'*)
            printf '%s\n' "${listing_entry#*$'\t'}"
            ;;
        *)
            printf '%s\n' "${listing_entry}"
            ;;
    esac
}

project_matches_repo() {
    local requested_project
    local listing_entry
    local repo_path
    local repo_name
    local repo_parent
    local requested_name
    local qualifier

    requested_project="${1}"
    listing_entry="${2}"
    repo_path="$(listing_repo_path "${listing_entry}")"
    repo_name="$(basename -- "${repo_path}")"
    repo_parent="$(repo_parent_path "${repo_path}")"

    case "${requested_project}" in
        *"#"*)
            requested_name="${requested_project%%#*}"
            qualifier="${requested_project#*#}"
            [ "${requested_name}" = "${repo_name}" ] || return 1
            case "${repo_parent}" in
                "${qualifier}"|*/"${qualifier}")
                    return 0
                    ;;
                ".")
                    [ "${qualifier}" = "$(basename -- "${workspace}")" ] && return 0
                    ;;
            esac
            return 1
            ;;
        *)
            case "${repo_path}" in
                */"${requested_project}")
                    return 0
                    ;;
            esac
            return 1
            ;;
    esac
}

find_matching_repos() {
    local requested_project
    local listing
    local listing_entry
    local matched_paths

    requested_project="${1}"
    listing="${2}"
    matched_paths=""

    while IFS= read -r listing_entry; do
        [ -z "${listing_entry}" ] && continue
        if project_matches_repo "${requested_project}" "${listing_entry}"; then
            matched_paths="${matched_paths}$(listing_repo_path "${listing_entry}")"$'\n'
        fi
    done <<< "${listing}"

    printf '%s' "${matched_paths}"
}

find_similar_repos() {
    local requested_project
    local listing
    local listing_entry
    local repo_path
    local candidate
    local similar_paths

    # a qualifier only narrows exact matches, the name alone is looked for here
    requested_project="${1%%#*}"
    requested_project="${requested_project,,}"
    listing="${2}"
    similar_paths=""
    [ -z "${requested_project}" ] && return 0

    while IFS= read -r listing_entry; do
        [ -z "${listing_entry}" ] && continue
        repo_path="${listing_entry#*$'\t'}"
        # a name is looked for in the repo name, a path in the relative path
        case "${requested_project}" in
            */*)
                candidate="${repo_path#"${workspace}"/}"
                ;;
            *)
                candidate="${repo_path##*/}"
                ;;
        esac
        [[ "${candidate,,}" == *"${requested_project}"* ]] && similar_paths="${similar_paths}${repo_path}"$'\n'
    done <<< "${listing}"

    printf '%s' "${similar_paths}"
}

choose_similar_repo() {
    local similar_paths
    local repo_path

    similar_paths="${1}"
    {
        while IFS= read -r repo_path; do
            [ -z "${repo_path}" ] && continue
            printf '%s\t%s\n' "${repo_path}" "$(relative_repo_path "${repo_path}")"
        done <<< "${similar_paths}"
        # the key cannot clash with a repo, those are absolute paths
        [ "${no_git_clone}" -eq 0 ] && printf '%s\t%s\n' "online" "Find ${project} online"
    } | prompt-select --prompt "Choose repository:" --delimiter '\t'
}

# the sources whose repos are completed and cloned even when not cloned yet, in
# the order a bare repo name is looked up in: github.com/<owner> lists the
# repos of a GitHub owner with gh, <host>/<group> the projects of a GitLab group
# and its subgroups with glab, and a bare <host> all GitLab projects of the
# groups and namespaces one is a member of
remote_sources() {
    printf '%s\n' ${GIT_FIND_REPO_REMOTES:-github.com/dgrieser github.com/mittwald gitlab.mittwald.it}
}

remote_listing_cache_file() {
    echo "${HOME}/.cache/git-find-repo/remote-listing"
}

# the repo paths of one source, one per line
list_source_repos() {
    local host
    local group
    local endpoint
    local pages
    local page_dir
    local status

    host="${1%%/*}"
    group="${1#*/}"
    [ "${group}" = "${1}" ] && group=""
    case "${host}" in
        github.com)
            command -v gh &>/dev/null || return 1
            gh repo list "${group}" --limit 10000 --json nameWithOwner -q '.[].nameWithOwner'
            return
            ;;
    esac

    command -v glab &>/dev/null || return 1
    if [ -n "${group}" ]; then
        endpoint="groups/${group//\//%2F}/projects?include_subgroups=true&simple=true&per_page=100"
    else
        endpoint="projects?membership=true&simple=true&per_page=100"
    fi
    export GITLAB_HOST="${host}"
    # the pages are fetched side by side, which takes a second or two instead of
    # many; GitLab leaves out the page count for very large results, which are
    # then paged through one after the other
    pages="$(glab api -i "${endpoint}&page=1" 2>/dev/null | tr -d '\r' | awk -F ': ' 'tolower($1) == "x-total-pages" { print $2; exit }')"
    if [[ "${pages}" =~ ^[0-9]+$ ]]; then
        [ "${pages}" -eq 0 ] && return 0
        # each page goes to a file of its own, their output would interleave
        page_dir="$(mktemp -d)" || return 1
        seq 1 "${pages}" | xargs -P 8 -I '{}' sh -c 'glab api "${1}&page=${2}" > "${3}/${2}"' _ "${endpoint}" '{}' "${page_dir}" \
            && cat "${page_dir}"/* | jq -r '.[].path_with_namespace'
        status=$?
        rm -rf "${page_dir}"
        return "${status}"
    else
        glab api --paginate "${endpoint}" | jq -r '.[].path_with_namespace'
    fi
}

# <source>\t<path> per line for all repos of the remote sources, in source
# order; the sources are fetched side by side
update_remote_listing() {
    local cache_file
    local temp_dir
    local source
    local index
    local failed

    cache_file="$(remote_listing_cache_file)"
    mkdir -p "$(dirname "${cache_file}")" || return 1
    temp_dir="$(mktemp -d "${cache_file}.tmp.XXXXXX")" || return 1
    index=0
    for source in $(remote_sources); do
        index=$((index + 1))
        (
            set -o pipefail
            list_source_repos "${source}" 2>/dev/null | LC_ALL=C sort -u \
                | awk -v source="${source}" '{ print source "\t" $0 }' > "${temp_dir}/${index}" \
                || rm -f "${temp_dir}/${index}"
        ) &
    done
    wait
    # a failing source keeps the old listing rather than dropping its repos
    failed=0
    for (( ; index > 0; index-- )); do
        [ -f "${temp_dir}/${index}" ] || failed=1
    done
    if [ "${failed}" -eq 0 ]; then
        cat $(ls "${temp_dir}" | sort -n | sed "s|^|${temp_dir}/|") > "${temp_dir}/listing" \
            && mv "${temp_dir}/listing" "${cache_file}" || failed=1
    fi
    rm -rf "${temp_dir}"
    [ "${failed}" -eq 0 ]
}

# the names of the remote repos not cloned to ${workspace}/<path>, made unique
# the way the local listing is: a name shared with another remote or local repo
# gets the shortest #<parent suffix> telling it apart; the listing is kept for
# good and only fetched when missing
list_remote_repos() {
    local cache_file
    local local_cache_file
    local source
    local remote_repo

    cache_file="$(remote_listing_cache_file)"
    if [ ! -s "${cache_file}" ]; then
        update_remote_listing || return 0
    fi
    local_cache_file="$(listing_cache_file)"

    {
        [ -f "${local_cache_file}" ] && awk -F '\t' -v workspace="${workspace}" '
            NF >= 2 {
                path = $2
                if (index(path, workspace "/") == 1) path = substr(path, length(workspace) + 2)
                else if (path == workspace) path = "."
                print "L\t" path
            }
        ' "${local_cache_file}"
        while IFS=$'\t' read -r source remote_repo; do
            [ -z "${remote_repo}" ] && continue
            [ -d "${workspace}/${remote_repo}" ] && continue
            printf 'R\t%s\n' "${remote_repo}"
        done < "${cache_file}"
    } | awk -F '\t' '
        function parent_of(path,   copy) {
            copy = path
            if (copy !~ /\//) return "."
            sub(/\/[^\/]+$/, "", copy)
            return copy
        }
        function suffix_of(path, count,   n, parts, out, i) {
            n = split(path, parts, "/")
            if (count > n) return ""
            out = parts[n - count + 1]
            for (i = n - count + 2; i <= n; i++) out = out "/" parts[i]
            return out
        }
        seen[$2]++ { next }
        {
            total++
            kind[total] = $1
            name[total] = $2
            sub(/^.*\//, "", name[total])
            parent[total] = parent_of($2)
            members[name[total]] = members[name[total]] " " total
        }
        END {
            for (i = 1; i <= total; i++) {
                if (kind[i] != "R") continue
                split(substr(members[name[i]], 2), group, " ")
                if (length(group) == 1) { print name[i]; continue }
                qualifier = parent[i]
                parts = split(parent[i], _, "/")
                for (count = 1; count <= parts; count++) {
                    suffix = suffix_of(parent[i], count)
                    unique = 1
                    for (j in group) {
                        other = group[j]
                        if (other != i && suffix_of(parent[other], count) == suffix) { unique = 0; break }
                    }
                    if (unique) { qualifier = suffix; break }
                }
                print name[i] "#" qualifier
            }
        }
    '
}

# the <source>\t<path> lines of the remote repos that a path, a bare repo name
# or a name#<parent suffix> as list_remote_repos prints it names, ignoring case,
# all from the first source in remote_sources having any
find_remote_repos() {
    local requested_project
    local cache_file

    requested_project="${1}"
    cache_file="$(remote_listing_cache_file)"
    [ -f "${cache_file}" ] && [ -n "${requested_project}" ] || return 1
    awk -F '\t' -v requested="${requested_project,,}" '
        BEGIN {
            qualifier = ""
            if (index(requested, "#")) {
                qualifier = substr(requested, index(requested, "#") + 1)
                requested = substr(requested, 1, index(requested, "#") - 1)
            }
        }
        {
            path = tolower($2)
            name = path
            sub(/^.*\//, "", name)
            parent = path
            sub(/\/[^\/]+$/, "", parent)
            if (qualifier != "") {
                if (name != requested) next
                if (parent != qualifier && substr(parent, length(parent) - length(qualifier)) != "/" qualifier) next
            } else if (requested ~ /\//) {
                if (path != requested) next
            } else if (name != requested) {
                next
            }
            if (source == "") source = $1
            if ($1 == source) { print; found = 1 }
        }
        END { exit !found }
    ' "${cache_file}"
}

# the <source>\t<path> of the one remote repo a path or bare name names, picked
# when the first source has several
pick_remote_repo() {
    local found
    local choice

    found="$(find_remote_repos "${1}")" || return 1
    if [ "$(wc -l <<< "${found}")" -gt 1 ]; then
        choice="$(awk -F '\t' '{ host = $1; sub(/\/.*/, "", host); print NR "\t" host "/" $2 }' <<< "${found}" \
            | prompt-select --prompt "Choose repository:" --delimiter '\t')" || return 1
        found="$(sed -n "${choice}p" <<< "${found}")"
    fi
    printf '%s\n' "${found}"
}

remote_ssh_prefix_cache_file() {
    echo "${HOME}/.cache/git-find-repo/remote-ssh-prefixes"
}

# the SSH clone URL of a <source>\t<path> repo; a GitLab host is asked for it,
# as its SSH may listen on another port than 22 (ssh://git@<host>:<port>/...),
# falling back to the scp-like git@<host>:<path>.git when that fails; the part
# before <path>.git is the same for all repos of a host and is cached per host
remote_repo_url() {
    local source
    local path
    local host
    local url
    local prefix
    local cache_file

    source="${1%%$'\t'*}"
    path="${1#*$'\t'}"
    host="${source%%/*}"
    if [ "${host}" != "github.com" ]; then
        cache_file="$(remote_ssh_prefix_cache_file)"
        prefix="$([ -f "${cache_file}" ] && awk -F '\t' -v host="${host}" '$1 == host { print $2; exit }' "${cache_file}")"
        [ -n "${prefix}" ] && {
            printf '%s%s.git\n' "${prefix}" "${path}"
            return 0
        }
        command -v glab &>/dev/null \
            && url="$(GITLAB_HOST="${host}" glab api "projects/${path//\//%2F}" 2>/dev/null | jq -r '.ssh_url_to_repo // empty' 2>/dev/null)"
        [ -n "${url}" ] && {
            prefix="${url%"${path}.git"}"
            if [ "${prefix}" != "${url}" ] && mkdir -p "$(dirname "${cache_file}")"; then
                printf '%s\t%s\n' "${host}" "${prefix}" >> "${cache_file}"
            fi
            printf '%s\n' "${url}"
            return 0
        }
    fi
    printf 'git@%s:%s.git\n' "${host}" "${path}"
}

# whether a <source>\t<path> repo still exists; only an API answering 404
# counts as gone, so being offline or the like does not refetch the listing
remote_repo_exists() {
    local source
    local path
    local host
    local output

    source="${1%%$'\t'*}"
    path="${1#*$'\t'}"
    host="${source%%/*}"
    if [ "${host}" = "github.com" ]; then
        output="$(gh api "repos/${path}" --silent 2>&1)"
    else
        output="$(GITLAB_HOST="${host}" glab api "projects/${path//\//%2F}" 2>&1 >/dev/null)"
    fi
    [[ "${output}" != *"HTTP 404"* ]]
}

# drops a <source>\t<path> line from the cached remote listing
forget_remote_repo() {
    local cache_file
    local temp_file

    cache_file="$(remote_listing_cache_file)"
    temp_file="$(mktemp "${cache_file}.tmp.XXXXXX")" || return 1
    grep -vxF -- "${1}" "${cache_file}" > "${temp_file}"
    mv "${temp_file}" "${cache_file}" || rm -f "${temp_file}"
}

# like pick_remote_repo, but a repo that no longer exists is dropped from the
# cached listing and left to the usual lookup, as is one missing from it; the
# listing is only fetched here when there is none yet
resolve_remote_repo() {
    local remote_repo

    [ -s "$(remote_listing_cache_file)" ] || update_remote_listing || return 1
    remote_repo="$(pick_remote_repo "${1}")" || return 1
    remote_repo_exists "${remote_repo}" && {
        printf '%s\n' "${remote_repo}"
        return 0
    }
    note "$(remote_repo_url "${remote_repo}") no longer exists, removing it from the remote listing"
    forget_remote_repo "${remote_repo}"
    return 1
}

update_listing() {
    local cache_file
    local cache_dir
    local temp_file

    cache_file="$(listing_cache_file)"
    cache_dir="$(dirname "${cache_file}")"
    mkdir -p "${cache_dir}" || fail "Could not create cache dir ${cache_dir}"
    temp_file="$(mktemp "${cache_file}.tmp.XXXXXX")" || fail "Could not create temp listing cache ${cache_file}.tmp.XXXXXX"
    generate_listing > "${temp_file}" || {
        rm -f "${temp_file}"
        fail "Could not write listing cache ${cache_file}"
    }
    if [ ! -s "${temp_file}" ]; then
        rm -f "${temp_file}"
        fail "Refusing to replace listing cache ${cache_file} with an empty listing"
    fi
    mv "${temp_file}" "${cache_file}" || {
        rm -f "${temp_file}"
        fail "Could not replace listing cache ${cache_file}"
    }
}

# prints the worktree of the repo that has the branch checked out, if any,
# including one rebasing or bisecting it, where HEAD is detached but Git still
# holds the branch for that work tree
worktree_of_branch() {
    local path
    local line
    local file
    local held

    while IFS= read -r line; do
        case "${line}" in
            "worktree "*)
                path="${line#worktree }"
                ;;
            "branch refs/heads/${2}")
                echo "${path}"
                return 0
                ;;
            "detached")
                for file in rebase-merge/head-name rebase-apply/head-name BISECT_START; do
                    file="$(git -C "${path}" rev-parse --path-format=absolute --git-path "${file}" 2>/dev/null)" || continue
                    [ -f "${file}" ] || continue
                    held="$(cat "${file}")"
                    if [ "${held#refs/heads/}" = "${2}" ]; then
                        echo "${path}"
                        return 0
                    fi
                done
                ;;
        esac
    done < <(git -C "${1}" worktree list --porcelain)
}

# prints why the work tree at ${1} must not be switched to another branch, if
# it must not: uncommitted changes (untracked files included) would be carried
# over, and a rebase, merge, cherry-pick, revert or bisect would be disrupted,
# including a cherry-pick or revert sequence paused between commits
busy_reason() {
    local reasons=()
    local count
    local state
    local path

    count="$(git -C "${1}" status --porcelain --untracked-files=normal 2>/dev/null | wc -l)"
    [ "${count}" -gt 0 ] && reasons+=("${count} uncommitted changes")
    for state in rebase-merge:rebase rebase-apply:rebase MERGE_HEAD:merge CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert sequencer/todo:cherry-pick/revert BISECT_LOG:bisect; do
        path="$(git -C "${1}" rev-parse --path-format=absolute --git-path "${state%%:*}" 2>/dev/null)" || continue
        [ -e "${path}" ] || continue
        # a sequence stopped on a conflict is reported by its state file above
        case "${state} ${reasons[*]}" in
            "sequencer/todo:"*"cherry-pick in progress"*|"sequencer/todo:"*"revert in progress"*) continue ;;
        esac
        reasons+=("${state#*:} in progress")
    done
    [ "${#reasons[@]}" -gt 0 ] || return 1
    (IFS=","; echo "${reasons[*]}" | sed 's/,/, /g')
}

# prints the remote of the repo at ${1} that has the branch ${2}, origin first;
# without a branch, the remote the MR/PR refs live on: origin, or else the
# only remote
remote_of() {
    local remote
    local remotes

    remotes="$(git -C "${1}" remote | grep -vFx origin)"
    git -C "${1}" remote | grep -qFx origin && remotes="$(printf 'origin\n%s' "${remotes}")"
    if [ -z "${2}" ]; then
        [ "$(grep -c . <<< "${remotes}")" -eq 1 ] || remotes="$(grep -Fx origin <<< "${remotes}")"
        [ -n "${remotes}" ] && head -n 1 <<< "${remotes}"
        return
    fi
    while IFS= read -r remote; do
        [ -n "${remote}" ] || continue
        if git -C "${1}" ls-remote --exit-code --heads "${remote}" "refs/heads/${2}" >/dev/null 2>&1; then
            echo "${remote}"
            return 0
        fi
    done <<< "${remotes}"
    return 1
}

# prints the remote of the repo at ${1} whose URL points to the repository of
# the MR/PR web URL ${2}, which holds its refs/merge-requests or refs/pull
remote_of_web_url() {
    local repo
    local remote
    local url

    repo="$(sed -E 's|^[a-z]+://||; s|/-/merge_requests/[0-9]+.*$||; s|/pull/[0-9]+.*$||' <<< "${2}")"
    [ -n "${repo}" ] || return 1
    while IFS= read -r remote; do
        url="$(git -C "${1}" remote get-url "${remote}" 2>/dev/null)" || continue
        url="$(sed -E 's|^[a-z+]+://||; s|^[^@/]+@||; s|:[0-9]*/|/|; s|^([^/:]+):|\1/|; s|\.git/?$||; s|/$||' <<< "${url}")"
        if [ "${url,,}" = "${repo,,}" ]; then
            echo "${remote}"
            return 0
        fi
    done < <(git -C "${1}" remote)
    return 1
}

# prints "<patch id> <commit>" for each non-merge commit of the range ${1},
# the patch id taken verbatim from the stored changes, whitespace and binary
# content and submodule commits included, whatever the diff configuration,
# never from a textconv or external diff; fails when git does
patch_ids() {
    local -
    set -o pipefail
    git log --no-merges --no-color --no-ext-diff --no-textconv --no-relative --submodule=short --ignore-submodules=none --binary --full-index -p --format='commit %H' "${1}" | git patch-id --verbatim
}

# brings the branch checked out in the current dir up to date with its
# upstream, which a plain pull cannot do once the MR branch was rebased and
# force-pushed after an earlier checkout: fast-forwards when behind, keeps local
# commits when only ahead, resets to the upstream when every local commit is in
# it already as the very same patch, and fails on local commits found nowhere else,
# local merges included
update_branch() {
    local upstream
    local branch
    local unique
    local busy
    local local_commits
    local local_ids
    local upstream_ids

    branch="$(git branch --show-current)"
    if ! upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; then
        git-color pull 1>&2
        return
    fi
    git-color fetch 1>&2 || return 1
    if git merge-base --is-ancestor HEAD "${upstream}"; then
        # pull, unlike merge, updates submodules with submodule.recurse set
        git-color pull --ff-only 1>&2
    elif git merge-base --is-ancestor "${upstream}" HEAD; then
        note "${branch} is ahead of ${upstream}, keeping its local commits"
    else
        # a local commit is covered when its patch is upstream; unlike git
        # cherry, patches are compared whitespace included, as that can
        # matter, and merges and empty commits, having no patch to compare,
        # are never covered; any failure here stops before the reset
        local_commits="$(git rev-list "${upstream}..HEAD")" &&
            local_ids="$(patch_ids "${upstream}..HEAD")" &&
            upstream_ids="$(patch_ids "HEAD..${upstream}")" ||
            { error "Unable to compare ${branch} with ${upstream}"; return 1; }
        # each upstream patch covers one local commit only, so a patch applied
        # twice locally needs two upstream copies; each input has one line at
        # least, so the file counter sees all three
        unique="$(awk '
            FNR == 1 { file++ }
            $0 == "" { next }
            file == 1 { count[$1]++ }
            file == 2 && count[$1] > 0 { count[$1]--; covered[$2] = 1 }
            file == 3 && !covered[$1] { print }
        ' <(printf '%s\n' "${upstream_ids}") <(printf '%s\n' "${local_ids}") <(printf '%s\n' "${local_commits}"))" ||
            { error "Unable to compare ${branch} with ${upstream}"; return 1; }
        if [ -n "${unique}" ]; then
            error "${branch} and ${upstream} have diverged, with local commits not in ${upstream}:"
            git log --no-walk --format='  %h %s' ${unique} 1>&2
            error "Rebase them onto ${upstream}, or drop them with: git reset --hard ${upstream}"
            return 1
        fi
        busy="$(busy_reason .)" && {
            error "${branch} was rewritten on ${upstream}, not resetting as the work tree is busy (${busy})"
            return 1
        }
        note "${branch} was rewritten on ${upstream} and has no local commits of its own, resetting to it"
        git-color reset --hard "${upstream}" 1>&2
    fi
}

# checks out the requested ref in a new worktree added by git-worktree, leaving
# the busy work tree at ${1} alone, and prints the worktree path; ${2} is the
# branch, ${3} 1 for a fork MR/PR
checkout_in_worktree() {
    local repo_path
    local branch
    local fork
    local worktree
    local base
    local head_ref
    local head
    local remote

    repo_path="${1}"
    branch="${2}"
    fork="${3}"
    if [ "${fork}" -eq 1 ]; then
        # glab/gh fetch the fork into the branch and check it out, which Git
        # refuses for a branch checked out anywhere: add the worktree on the
        # branch, created from the fetched MR/PR head if missing so glab/gh
        # can update it, then detach it
        base=()
        if ! git -C "${repo_path}" show-ref --verify --quiet "refs/heads/${branch}"; then
            if [ -n "${checkout_mr_id}" ]; then
                head_ref="refs/merge-requests/${checkout_mr_id}/head"
            else
                head_ref="refs/pull/${checkout_pr_id}/head"
            fi
            remote="$(remote_of_web_url "${repo_path}" "${checkout_web_url}")" ||
                remote="$(remote_of "${repo_path}")" ||
                fail "Unable to find the remote of: ${head_ref}"
            git-color -C "${repo_path}" fetch "${remote}" "${head_ref}" 1>&2 ||
                fail "Unable to fetch: ${head_ref}"
            head="$(git -C "${repo_path}" rev-parse --verify --quiet FETCH_HEAD)" ||
                fail "Unable to resolve fetched: ${head_ref}"
            base=(-B "${head}" --no-fetch)
        fi
        worktree="$(WORKSPACE="${workspace}" git-worktree add -w "${repo_path}" -b "${branch}" -c "${base[@]}")" ||
            fail "Unable to add worktree for: ${branch}"
        cd "${worktree}" || fail "Unable to change directory to: ${worktree}"
        git checkout --quiet --detach || fail "Unable to detach HEAD in worktree: ${worktree}"
        if [ -n "${checkout_mr_id}" ]; then
            note "MR ${checkout_mr_id} is from a fork, checking out as: ${branch}"
            glab mr checkout "${checkout_mr_id}" --branch "${branch}" 1>&2 ||
                fail "Unable to checkout fork MR ${checkout_mr_id} in worktree: ${worktree}"
        else
            note "PR ${checkout_pr_id} is from a fork, checking out as: ${branch}"
            gh pr checkout "${checkout_pr_id}" --branch "${branch}" 1>&2 ||
                fail "Unable to checkout fork PR ${checkout_pr_id} in worktree: ${worktree}"
        fi
    else
        # a missing branch is created from the fetched remote branch, which
        # also sets it up to track that
        base=()
        if ! git -C "${repo_path}" show-ref --verify --quiet "refs/heads/${branch}"; then
            remote="$(remote_of "${repo_path}" "${branch}")" || fail "No remote has branch: ${branch}"
            base=(-B "${remote}/${branch}")
        fi
        worktree="$(WORKSPACE="${workspace}" git-worktree add -w "${repo_path}" -b "${branch}" -c "${base[@]}")" ||
            fail "Unable to add worktree for: ${branch}"
        cd "${worktree}" || fail "Unable to change directory to: ${worktree}"
        update_branch || fail "Unable to update source branch ${branch} in worktree: ${worktree}"
    fi
    echo "${worktree}"
}

# checks out the requested MR, PR or branch and prints the directory to go to:
# the repo itself, the linked worktree that already has the branch checked out,
# since Git refuses to check out a branch in two places, or a new worktree when
# the repo is busy with uncommitted changes or an operation in progress
checkout_requested_ref() {
    local repo_path
    local branch
    local info
    local fork
    local worktree
    local busy

    repo_path="${1}"
    if [ "${no_checkout}" -eq 1 ] || { [ -z "${checkout_mr_id}" ] && [ -z "${checkout_pr_id}" ] && [ -z "${checkout_source_branch}" ]; }; then
        echo "${repo_path}"
        return 0
    fi

    (
        cd "${repo_path}" || fail "Unable to change directory to: ${repo_path}"
        branch="${checkout_source_branch}"
        fork=0
        if [ -n "${checkout_mr_id}" ]; then
            info="$(glab mr view "${checkout_mr_id}" -F json)" || fail "Unable to get MR: ${checkout_mr_id}"
            branch="$(jq -r '.source_branch' <<< "${info}")"
            checkout_web_url="$(jq -r '.web_url // empty' <<< "${info}")"
            { [ -n "${branch}" ] && [ "${branch}" != "null" ]; } || fail "Unable to get source branch for MR: ${checkout_mr_id}"
            # the source branch of a fork MR does not exist on origin; prefix the
            # local branch with the fork owner so it cannot clash with ours
            if [ "$(jq -r '.source_project_id != .target_project_id' <<< "${info}")" = "true" ]; then
                branch="$(jq -r '.author.username' <<< "${info}")/${branch}"
                fork=1
            fi
        elif [ -n "${checkout_pr_id}" ]; then
            info="$(gh pr view "${checkout_pr_id}" --json headRefName,isCrossRepository,headRepositoryOwner,url)" || fail "Unable to get PR: ${checkout_pr_id}"
            branch="$(jq -r '.headRefName' <<< "${info}")"
            checkout_web_url="$(jq -r '.url // empty' <<< "${info}")"
            { [ -n "${branch}" ] && [ "${branch}" != "null" ]; } || fail "Unable to get source branch for PR: ${checkout_pr_id}"
            # see fork MR handling above
            if [ "$(jq -r '.isCrossRepository' <<< "${info}")" = "true" ]; then
                branch="$(jq -r '.headRepositoryOwner.login' <<< "${info}")/${branch}"
                fork=1
            fi
        fi

        worktree="$(worktree_of_branch "${repo_path}" "${branch}")"
        if [ -n "${worktree}" ]; then
            # the branch can be checked out only once; pulling would disrupt
            # the work in progress on it, so leave a busy work tree as it is
            if busy="$(busy_reason "${worktree}")"; then
                note "${branch} is checked out in ${worktree}, not pulling as it is busy (${busy})"
                echo "${worktree}"
                exit 0
            fi
            if [ "${worktree}" != "${repo_path}" ]; then
                note "${branch} is checked out in worktree: ${worktree}"
                cd "${worktree}" || fail "Unable to change directory to: ${worktree}"
                update_branch || fail "Unable to update source branch: ${branch}"
                echo "${worktree}"
                exit 0
            fi
        fi

        if busy="$(busy_reason "${repo_path}")"; then
            note "${repo_path} is busy (${busy}), checking out ${branch} in a worktree"
            checkout_in_worktree "${repo_path}" "${branch}" "${fork}"
            exit
        fi

        git-checkout 1>&2 || fail "Unable to checkout default branch"
        git-color pull 1>&2 || fail "Unable to pull default branch"
        if [ "${fork}" -eq 1 ] && [ -n "${checkout_mr_id}" ]; then
            note "MR ${checkout_mr_id} is from a fork, checking out as: ${branch}"
            glab mr checkout "${checkout_mr_id}" --branch "${branch}" 1>&2 || fail "Unable to checkout fork MR: ${checkout_mr_id}"
        elif [ "${fork}" -eq 1 ]; then
            note "PR ${checkout_pr_id} is from a fork, checking out as: ${branch}"
            gh pr checkout "${checkout_pr_id}" --branch "${branch}" 1>&2 || fail "Unable to checkout fork PR: ${checkout_pr_id}"
        else
            [ -n "${checkout_source_branch}" ] && note "Switching to source branch: ${branch}"
            git-checkout "${branch}" 1>&2 || fail "Unable to switch to source branch: ${branch}"
            update_branch || fail "Unable to update source branch: ${branch}"
        fi
        echo "${repo_path}"
    ) || exit 1
}

project=""
workspace="${WORKSPACE}"
vc_folder="${VC_FOLDER}"
update_listing_only=0
update_remote_listing_only=0
list_only=0
list_remote_only=0
print_history_only=0
no_git_clone=0
no_history=0
no_checkout=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        --no-git-clone)
            no_git_clone=1
            ;;
        --no-history)
            no_history=1
            ;;
        --no-checkout)
            no_checkout=1
            ;;
        --update-listing|-U)
            update_listing_only=1
            ;;
        --update-remote-listing)
            update_remote_listing_only=1
            ;;
        --list|-L)
            list_only=1
            ;;
        --list-remote|-R)
            list_remote_only=1
            ;;
        --print-history|--history|-H)
            print_history_only=1
            ;;
        --workspace|-W)
            shift
            [ -z "${1}" ] && usage
            workspace="${1}"
            ;;
        --vc-folder|-F)
            shift
            [ -z "${1}" ] && usage
            vc_folder="${1}"
            ;;
        *)
            [ -z "${project}" ] || usage
            project="${1}"
            ;;
    esac
    shift
done

[ -z "${workspace}" ] && fail "WORKSPACE is not set"
[ -z "${vc_folder}" ] && fail "VC_FOLDER is not set"
# a trailing slash breaks prefix stripping and the traverse-up workspace check
workspace="${workspace%/}"
[ -z "${workspace}" ] && fail "WORKSPACE must not be /"

# migrate cache from the old script name (dev-find-project)
if [ -d "${HOME}/.cache/dev-find-project" ] && [ ! -e "${HOME}/.cache/git-find-repo" ]; then
    mv "${HOME}/.cache/dev-find-project" "${HOME}/.cache/git-find-repo" \
        || warning "Could not migrate cache from ${HOME}/.cache/dev-find-project"
fi
[ "${list_remote_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "${update_remote_listing_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "$((update_listing_only + update_remote_listing_only + list_only + list_remote_only + print_history_only))" -gt 1 ] && usage
[ "${update_listing_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "${list_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "${print_history_only}" -eq 1 ] && [ -n "${project}" ] && usage
[ "$((update_listing_only + update_remote_listing_only + list_only + list_remote_only + print_history_only))" -eq 0 ] && [ -z "${project}" ] && usage

if [ "${update_listing_only}" -eq 1 ]; then
    update_listing
    exit 0
fi

if [ "${update_remote_listing_only}" -eq 1 ]; then
    update_remote_listing || fail "Could not update remote listing $(remote_listing_cache_file)"
    exit 0
fi

if [ "${list_only}" -eq 1 ]; then
    cache_file="$(listing_cache_file)"
    if [ -f "${cache_file}" ] && [ -s "${cache_file}" ]; then
        listing="$(cat "${cache_file}")"
    else
        update_listing
        listing="$(cat "${cache_file}")"
    fi

    printf '%s\n' "${listing}"
    exit 0
fi

if [ "${list_remote_only}" -eq 1 ]; then
    list_remote_repos
    exit 0
fi

if [ "${print_history_only}" -eq 1 ]; then
    print_history
    exit 0
fi

# taken before anything changes directory
current_dir="$(current_project_dir)"

if [ "${project}" = "-" ]; then
    history_entries="$(recent_history_entries "${current_dir}")"
    [ -n "${history_entries}" ] || fail "No project history found"
    project="$(choose_history_entry "${history_entries}")" || exit 1
fi

checkout_mr_id=""
checkout_web_url=""
checkout_pr_id=""
checkout_source_branch=""

# a bare or !-prefixed MR number refers to the current repo, not a project name
if [[ "${project}" =~ ^!?[0-9]+$ ]]; then
    checkout_mr_id="${project#!}"
    git_root_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "Not inside a Git repository"
    target_dir="$(checkout_requested_ref "${git_root_dir}")" || exit 1
    record_switch "${target_dir}"
    echo "${target_dir}"
    exit 0
fi

url=""

# a scheme-less URL (host/owner/repo...) is treated as https
if [[ "${project}" != *":"* ]] && [[ "${project}" =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}/ ]]; then
    project="https://${project}"
fi

if [[ "${project}" == *":/"* ]]; then
    url="${project}"
    if [[ "${url}" == *"/-/"* ]]; then
        url_ref="${url#*/-/}"
        case "${url_ref}" in
            merge_requests/*)
                checkout_mr_id="$(echo "${url_ref}" | grep -oE '^merge_requests/[0-9]+' | grep -oE '[0-9]+$')"
                ;;
            tree/*)
                checkout_source_branch="$(echo "${url_ref}" | sed -E 's|^tree/([^?#]+).*$|\1|')"
                ;;
        esac
        url="${url%%/-/*}"
    elif [[ "${url}" =~ ^[^:/]+://[^/]+/[^/]+/[^/]+/(pull|tree)/ ]]; then
        # GitHub style: https://github.com/<owner>/<repo>/pull/<id> or .../tree/<branch>
        url_base="$(echo "${url}" | sed -E 's|^([^:/]+://[^/]+/[^/]+/[^/]+)/.*$|\1|')"
        url_ref="${url#${url_base}/}"
        case "${url_ref}" in
            pull/*)
                checkout_pr_id="$(echo "${url_ref}" | grep -oE '^pull/[0-9]+' | grep -oE '[0-9]+$')"
                ;;
            tree/*)
                checkout_source_branch="$(echo "${url_ref}" | sed -E 's|^tree/([^?#]+).*$|\1|')"
                ;;
        esac
        url="${url_base}"
    fi
    project="$(echo "${url}" | sed -E 's|^[^:/]+:/{1,2}[^/]*||; s|[?#].*$||; s|\.git$||')"
elif [[ "${project}" == *":"* ]]; then
    [[ "${project}" == "git@"* ]] && url="${project}"
    project="$(echo "${project}" | sed -E 's|^[^:]+:||; s|[?#].*$||; s|\.git$||')"
fi

# remove leading slash
project="${project#/}"

if [[ "${project}" == *"/"* ]]; then
    # traverse up to find a git folder
    prj_git=""
    prj_candidate=""
    folder="${workspace}/${project}"
    while [ -z "${prj_git}" ]; do
        prj_git=$(find "${folder}" -maxdepth 1 -type d -name "${vc_folder}" 2> /dev/null | head -n 1)
        if [ -n "${prj_git}" ]; then
            prj_candidate=$(dirname "${prj_git}")
            prj_candidate="${prj_candidate#*${workspace}}"
            prj_candidate="${prj_candidate#/}"
            break
        fi
        parent=$(dirname "${folder}")
        if [ "${workspace}" == "${parent}" ] || [ "${parent}" == "${folder}" ]; then
            break
        fi
        folder="${parent}"
    done
    if [ -n "${prj_candidate}" ]; then
        folder="${workspace}/${prj_candidate}"
        if cd "${folder}"; then
            target_dir="$(checkout_requested_ref "${folder}")" || exit 1
            record_switch "${target_dir}"
            echo "${target_dir}"
            exit 0
        fi
    fi
fi

# list all repos, trim .git, de-duplicate,
# match the project name or relative path
cache_file="$(listing_cache_file)"
listing_refreshed=0
if [ -f "${cache_file}" ]; then
    listing="$(cat "${cache_file}")"
    matches="$(find_matching_repos "${project}" "${listing}")"
else
    update_listing
    listing_refreshed=1
    listing="$(cat "${cache_file}")"
    matches="$(find_matching_repos "${project}" "${listing}")"
fi

if [ -z "${matches}" ] && [ "${listing_refreshed}" -eq 0 ]; then
    update_listing
    listing="$(cat "${cache_file}")"
    matches="$(find_matching_repos "${project}" "${listing}")"
fi

# a repo of a remote source, named by its path or by its name alone, is cloned
# from there right away, without offering similar repos or searching for it
if [ -z "${matches}" ] && [ -z "${url}" ] && [ "${no_git_clone}" -eq 0 ] \
    && remote_repo="$(resolve_remote_repo "${project}")" && [ -n "${remote_repo}" ]; then
    project="${remote_repo#*$'\t'}"
    url="$(remote_repo_url "${remote_repo}")"
fi

# without an exact match the repos containing the name are offered before going
# online; a URL names one repo exactly and goes online right away
not_found_warned=0
if [ -z "${matches}" ] && [ -z "${url}" ]; then
    similar="$(find_similar_repos "${project}" "${listing}")"
    if [ -n "${similar}" ]; then
        warning "${project} was not found locally."
        not_found_warned=1
        echo 1>&2
        choice="$(choose_similar_repo "${similar}")" || exit 1
        [ "${choice}" = "online" ] || matches="${choice}"
    fi
fi

match="$(printf '%s\n' "${matches}" | sed -n '1p')"
match_count="$(printf '%s\n' "${matches}" | sed '/^$/d' | wc -l)"

if [ "${match_count}" -gt 1 ]; then
    warning "${project} is ambiguous:"
    note "$(printf '%s\n' "${matches}" | sed '/^$/d' | sed 's/^/  • /')"
    note
    note "cd ${match}"
fi

if [ -z "${match}" ] && [ "${no_git_clone}" -eq 0 ]; then
    [ "${not_found_warned}" -eq 1 ] || warning "${project} was not found locally."
    clone_url="${url:-${project}}"
    note "Attempting to clone ${clone_url} ..."
    echo 1>&2
    folder="$(git-clone "${clone_url}")" || fail "Could not clone ${clone_url}"
    target_dir="$(checkout_requested_ref "${folder}")" || exit 1
    record_switch "${target_dir}"
    echo "${target_dir}"
    exit 0
fi

[ -z "${match}" ] && fail "${project} was not found locally."
target_dir="$(checkout_requested_ref "${match}")" || exit 1
record_switch "${target_dir}"
echo "${target_dir}"
