#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }

APP="$(basename "${0}")"

usage() {
    cat <<EOF 1>&2
usage: ${APP} [-h|--help] [-p|--print] [-q|--query <query>] [<path ...>]
       ${APP} [-s|--stage <path>] [-u|--unstage <path>] [-d|--delete <path>] [-r|--reset <path>] [-i|--ignore <path>]
       ${APP} [-S|--stage-all] [-U|--unstage-all]

Interactively stage, unstage, delete, reset, or ignore git changes.

Options:
  -p, --print             Print the change list instead of opening the picker
  -q, --query <query>     Start the picker with a search query
  -s, --stage <path>      Stage one path
  -u, --unstage <path>    Unstage one path
  -d, --delete <path>     Delete one path
  -r, --reset <path>      Reset one path
  -i, --ignore <path>     Ignore one path
  -S, --stage-all         Stage all untracked and unstaged paths
  -U, --unstage-all       Unstage all staged paths
  -h, --help              Show this help message
EOF
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

fail() {
    error "${1}"
    exit 1
}

# the picker comes back the moment a key that was handed the terminal is through,
# so a message of one of them is only read if it is waited for
notify() {
    error "${1}"
    read -rsn 1 -p "Press any key to continue"
    echo 1>&2
}

RED='\e[31m'
GREEN='\e[32m'
YELLOW='\e[33m'
MAGENTA='\e[35m'
NC='\e[0m'

HEADER="KEY\tTYPE\tPATH"
# all keys but the ones that end the picker run inside it: the ones that change
# the working tree silently, the editor and vimdiff with the terminal handed over
# + and - act on one path, alt-+ and alt-- on all of them; shift-delete is the
# "all" variant of del
RELOAD_KEYS="alt-+,alt--,alt-d,alt-r,alt-i,del,shift-delete,insert,+,-"
EXEC_RELOAD_KEYS="ctrl-e,alt-v"
EXPECT_KEYS="ctrl-d,esc,ctrl-c,enter"
KEY_DESCS="+:stage,-:unstage,alt-d:delete,alt-r:reset,alt-i:ignore,alt-v:vimdiff,ctrl-d:diff,ctrl-e:edit,del:unstage,insert:stage,alt-+:stage all,alt--:unstage all,shift-delete:unstage all"

print_diff() {
    local current_state="${1}"; shift
    local path="${1}"; shift
    local color=1
    [ "${1}" == "0" ] && color=0
    local diff_cmd=""
    case ${current_state} in
        untracked) diff_cmd="${UNTRACKED_DIFF_CMD}" ;;
        unstaged) diff_cmd="${UNSTAGED_DIFF_CMD}" ;;
        staged) diff_cmd="${STAGED_DIFF_CMD}" ;;
        conflict) diff_cmd="${CONFLICT_DIFF_CMD}" ;;
        *) fail "Unknown state: ${current_state}" ;;
    esac
    if [ "${color}" -eq 0 ]; then
        # remove "--color=always" from diff command
        diff_cmd="$(echo "${diff_cmd}" | sed 's/ --color=always//g')"
    fi
    ${diff_cmd} "${path}"
}

edit_file() {
    local current_state="${1}"; shift
    local path="${1}"; shift
    local lineno="$(print_diff "${current_state}" "${path}" 0 | awk '/^@@/ {if (match($0, /\+[0-9]+/)) {print substr($0, RSTART+1, RLENGTH-1); exit}}')"
    if [[ "${lineno}" =~ ^[0-9]+$ ]]; then
        # add the regular 3 lines of context
        lineno=$((lineno+3))
    else
        lineno=1
    fi
    # git reports repo-relative paths, but the picker may have been started in a
    # subdirectory of the repo, so the editor gets an absolute one
    vim "+${lineno}" "${GIT_DIR}/${path}"
}

vimdiff_file() {
    local path="${1}"; shift
    # git-diff handles the readonly side (HEAD version, or an empty file for
    # untracked files)
    git-diff --vim --untracked --path "${GIT_DIR}/${path}" uncommitted
}

contains_path() {
    local path="${1}"; shift
    local cmd="${1}"; shift
    local paths
    mapfile -d '' -t paths < <(${cmd})
    local p
    for p in "${paths[@]}"; do
        [[ "${p}" == "${path}" ]] && return 0
    done
    return 1
}

list_untracked() {
    ${UNTRACKED_LIST_CMD}
}

is_untracked() {
    local path="${1}"; shift
    contains_path "${path}" "${UNTRACKED_LIST_CMD}"; exit_code=$?
    return ${exit_code}
}

list_unstaged() {
    ${UNSTAGED_LIST_CMD}
}

is_unstaged() {
    local path="${1}"; shift
    contains_path "${path}" "${UNSTAGED_LIST_CMD}"; exit_code=$?
    return ${exit_code}
}

list_staged() {
    ${STAGED_LIST_CMD}
}

is_staged() {
    local path="${1}"; shift
    contains_path "${path}" "${STAGED_LIST_CMD}"; exit_code=$?
    return ${exit_code}
}

list_conflict() {
    ${CONFLICT_LIST_CMD}
}

is_conflict() {
    local path="${1}"; shift
    contains_path "${path}" "${CONFLICT_LIST_CMD}"; exit_code=$?
    return ${exit_code}
}

# a submodule is a gitlink in the index, and that is what tells it apart from the
# files the picker edits, diffs and deletes: git lists it as a single path like
# any other change
is_submodule() {
    local path="${1}"; shift
    local entry=""
    # the entry of the path itself decides it, so the lookup is scoped to it
    # instead of walking the index of the whole repo
    IFS= read -r -d '' entry < <(${SUBMODULE_LIST_CMD} -- "${path}")
    [[ "${entry}" == 160000\ * ]] && [[ "${entry#*$'\t'}" == "${path}" ]]
}

has_conflict_markers() {
    local path="${1}"; shift
    git -C "${GIT_DIR}" diff --no-color --check -- "${path}" | grep -q 'leftover conflict marker'
}

paths=()
stage_path=""
unstage_path=""
delete_path=""
reset_path=""
ignore_path=""
stage_all=0
unstage_all=0
mode="list"
key_result=""
query=""
id=$$

while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        -p|--print)
            mode="print"
            ;;
        -q|--query)
            shift
            [ -z "${1}" ] && fail "Missing argument for query"
            query="${1}"
            ;;
        -s|--stage)
            shift
            [ -z "${1}" ] && fail "Missing argument for stage"
            [ -n "${stage_path}" ] && fail "Only one path can be staged at a time"
            stage_path="${1}"
            mode="update"
            ;;
        -u|--unstage)
            shift
            [ -z "${1}" ] && fail "Missing argument for unstage"
            [ -n "${unstage_path}" ] && fail "Only one path can be unstaged at a time"
            unstage_path="${1}"
            mode="update"
            ;;
        -d|--delete)
            shift
            [ -z "${1}" ] && fail "Missing argument for delete"
            [ -n "${delete_path}" ] && fail "Only one path can be deleted at a time"
            delete_path="${1}"
            mode="update"
            ;;
        -r|--reset)
            shift
            [ -z "${1}" ] && fail "Missing argument for reset"
            reset_path="${1}"
            mode="update"
            ;;
        -i|--ignore)
            shift
            [ -z "${1}" ] && fail "Missing argument for ignore"
            ignore_path="${1}"
            mode="update"
            ;;
        -S|--stage-all)
            stage_all=1
            mode="update"
            ;;
        -U|--unstage-all)
            unstage_all=1
            mode="update"
            ;;
        --key)
            shift
            [ -z "${1}" ] && fail "Missing argument for key"
            key_result="${1}"
            mode="update"
            ;;
        --id)
            shift
            [ -n "${1}" ] && id="${1}"
            ;;
        --)
            shift
            paths+=("${@}")
            break
            ;;
        -*)
            fail "Unknown option: ${1}"
            ;;
        *)
            paths+=("${1}")
            ;;
    esac
    shift
done

GIT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || fail "Not a git repo?"

RM_CMD="$(command -v trash &>/dev/null && echo 'trash' || echo 'rm')"

UNTRACKED_LIST_CMD='git -C '"${GIT_DIR}"' ls-files --others --exclude-standard -z'
UNTRACKED_DIFF_CMD='git --no-pager -C '"${GIT_DIR}"' diff --color=always --no-index /dev/null -- '

UNSTAGED_LIST_CMD='git -C '"${GIT_DIR}"' diff --name-only -z'
UNSTAGED_DIFF_CMD='git --no-pager -C '"${GIT_DIR}"' diff --color=always --'

STAGED_LIST_CMD='git --no-pager -C '"${GIT_DIR}"' diff --cached --name-only -z'
STAGED_DIFF_CMD='git --no-pager -C '"${GIT_DIR}"' diff --color=always --cached --'

SUBMODULE_LIST_CMD='git -C '"${GIT_DIR}"' ls-files --stage -z'

CONFLICT_LIST_CMD='git -C '"${GIT_DIR}"' diff --name-only --diff-filter=U -z'
CONFLICT_DIFF_CMD='git --no-pager -C '"${GIT_DIR}"' diff --color=always --'

STAGE_CMD='git -C '"${GIT_DIR}"' add --'
UNSTAGE_CMD='git -C '"${GIT_DIR}"' restore --staged --'
# without --recurse-submodules git-restore leaves a submodule alone and says
# nothing about it: neither the commit it is checked out at nor the changes inside
# it are reverted. For every other path the flag does nothing
RESET_CMD='git -C '"${GIT_DIR}"' restore --recurse-submodules --'
IGNORE_CMD='git-ignore'

PREVIEW_COMMAND='case {2} in'
PREVIEW_COMMAND+=' untracked) '"${UNTRACKED_DIFF_CMD}"' {3} ;;'
PREVIEW_COMMAND+=' unstaged) '"${UNSTAGED_DIFF_CMD}"' {3} ;;'
PREVIEW_COMMAND+=' staged) '"${STAGED_DIFF_CMD}"' {3} ;;'
PREVIEW_COMMAND+=' conflict) '"${CONFLICT_DIFF_CMD}"' {3} ;;'
PREVIEW_COMMAND+='esac'

PREVIOUS_UPDATE_FILE="/tmp/${APP}-${id}.previous_update"

if [ -n "${key_result}" ]; then
    key="$(echo "${key_result}" | head -n 1)"
    line="$(echo "${key_result}" | tail -n 1)"
    read -r _ current_state path <<<"${line}"
    case "${key}" in
        ctrl-d)
            echo -e "${current_state}\t${path}"
            print_diff "${current_state}" "${path}"
            exit 1
            ;;
        ctrl-e)
            if is_submodule "${path}"; then
                notify "Not editing '${path}': is a submodule"
            else
                edit_file "${current_state}" "${path}"
            fi
            exit 0
            ;;
        alt-v)
            if is_submodule "${path}"; then
                notify "Not diffing '${path}': is a submodule"
            else
                vimdiff_file "${path}"
            fi
            exit 0
            ;;
        insert|+)
            stage_path="${path}"
            ;;
        del|-)
            unstage_path="${path}"
            ;;
        alt-+)
            stage_all=1
            ;;
        alt--|shift-delete)
            unstage_all=1
            ;;
        alt-d)
            delete_path="${path}"
            ;;
        alt-r)
            reset_path="${path}"
            ;;
        alt-i)
            ignore_path="${path}"
            ;;
        esc|ctrl-c)
            exit 255
            ;;
        enter)
            echo -e "${current_state}\t${path}"
            exit 1
            ;;
        *)
            fail "Unknown key: ${key}"
            ;;
    esac
fi

if [ -n "${stage_path}" ]; then
    if is_conflict "${stage_path}" && has_conflict_markers "${stage_path}"; then
        error "Not staging '${stage_path}': conflict markers still present"
    # check if already staged, then do nothing
    elif is_unstaged "${stage_path}" || is_untracked "${stage_path}"; then
        ${STAGE_CMD} "${stage_path}"
        [ -n "${key_result}" ] && echo -e "stage\n${stage_path}" > "${PREVIOUS_UPDATE_FILE}"
    fi
fi
if [ "${stage_all}" -eq 1 ]; then
    # the same rules as for a single path: a conflict is only staged once its
    # markers are gone
    # an intent-to-add file can make a rename listed under its new name alone,
    # which would leave the deletion of the old one unstaged
    mapfile -d '' -t candidates < <(${UNSTAGED_LIST_CMD} --no-renames; list_untracked)
    mapfile -d '' -t conflicts < <(list_conflict)
    declare -A is_conflict_path=()
    for f in "${conflicts[@]}"; do
        is_conflict_path["${f}"]=1
    done
    declare -A seen_path=()
    to_stage=()
    for f in "${candidates[@]}"; do
        [[ -n "${seen_path["${f}"]}" ]] && continue
        seen_path["${f}"]=1
        if [[ -n "${is_conflict_path["${f}"]}" ]] && has_conflict_markers "${f}"; then
            error "Not staging '${f}': conflict markers still present"
            continue
        fi
        to_stage+=("${f}")
    done
    if [ "${#to_stage[@]}" -gt 0 ]; then
        # the names are files, not patterns: a "*.txt" would stage the conflicts
        # skipped above as well
        GIT_LITERAL_PATHSPECS=1 ${STAGE_CMD} "${to_stage[@]}"
        [ -n "${key_result}" ] && echo -e "stage\n" > "${PREVIOUS_UPDATE_FILE}"
    fi
fi
if [ "${unstage_all}" -eq 1 ]; then
    # unmerged paths are listed as staged as well, but restoring their index
    # entry would throw away the conflict
    # a staged rename is listed under its new name alone, which would leave the
    # deletion of the old one staged, so both sides are listed
    mapfile -d '' -t staged < <(${STAGED_LIST_CMD} --no-renames)
    mapfile -d '' -t conflicts < <(list_conflict)
    declare -A is_conflict_path=()
    for f in "${conflicts[@]}"; do
        is_conflict_path["${f}"]=1
    done
    to_unstage=()
    for f in "${staged[@]}"; do
        [[ -n "${is_conflict_path["${f}"]}" ]] || to_unstage+=("${f}")
    done
    if [ "${#to_unstage[@]}" -gt 0 ]; then
        GIT_LITERAL_PATHSPECS=1 ${UNSTAGE_CMD} "${to_unstage[@]}"
        [ -n "${key_result}" ] && echo -e "unstage\n" > "${PREVIOUS_UPDATE_FILE}"
    fi
fi
if [ -n "${unstage_path}" ]; then
    # check if actually staged, otherwise do nothing
    if ! is_unstaged "${unstage_path}"; then
        ${UNSTAGE_CMD} "${unstage_path}"
        [ -n "${key_result}" ] && echo -e "unstage\n${unstage_path}" > "${PREVIOUS_UPDATE_FILE}"
    fi
fi
if [ -n "${delete_path}" ]; then
    # if staged, unstage AND delete file; if not staged, delete file only
    if is_submodule "${delete_path}"; then
        error "Not deleting '${delete_path}': is a submodule"
    elif is_untracked "${delete_path}"; then
        (
            cd "${GIT_DIR}"
            ${RM_CMD} "${delete_path}"
            [ -n "${key_result}" ] && echo -e "delete\n${delete_path}" > "${PREVIOUS_UPDATE_FILE}"
        )
    else
        ${UNSTAGE_CMD} "${delete_path}" 2>/dev/null
        (
            cd "${GIT_DIR}"
            ${RM_CMD} "${delete_path}"
            [ -n "${key_result}" ] && echo -e "delete\n${delete_path}" > "${PREVIOUS_UPDATE_FILE}"
        )
    fi
fi
if [ -n "${reset_path}" ]; then
    ${RESET_CMD} "${reset_path}"
    [ -n "${key_result}" ] && echo -e "reset\n${reset_path}" > "${PREVIOUS_UPDATE_FILE}"
fi

if [ -n "${ignore_path}" ]; then
    # .gitignore entries must stay repo-relative, so run in the repo root
    # instead of passing an absolute path.
    (
        cd "${GIT_DIR}"
        ${IGNORE_CMD} "${ignore_path}"
    )
    [ -n "${key_result}" ] && echo -e "ignore\n${ignore_path}" > "${PREVIOUS_UPDATE_FILE}"
fi

[ "${mode}" == "update" ] && exit 0

# the state after the last change decides which end of the list the cursor
# starts on: after staging the unstaged changes stay next to it, after anything
# else the staged ones do, so the same key can be pressed again
print_changes() {
    local previous_update="" f key color
    local sort_args=("-t" $'\t')
    local -A STATUS
    local CONFLICT=() UNTRACKED=() UNSTAGED=() STAGED=()

    if [ -f "${PREVIOUS_UPDATE_FILE}" ]; then
        previous_update="$(head -n 1 "${PREVIOUS_UPDATE_FILE}")"
        rm -f "${PREVIOUS_UPDATE_FILE}"
    fi

    mapfile -d '' -t CONFLICT  < <(list_conflict)
    mapfile -d '' -t UNTRACKED < <(list_untracked)
    mapfile -d '' -t UNSTAGED  < <(list_unstaged)
    mapfile -d '' -t STAGED    < <(list_staged)

    for f in "${CONFLICT[@]}"; do
      STATUS["${f}"]="conflict"
    done
    for f in "${UNTRACKED[@]}"; do
      [[ -n "${STATUS["${f}"]}" ]] || STATUS["${f}"]="untracked"
    done
    for f in "${UNSTAGED[@]}"; do
      [[ -n "${STATUS["${f}"]}" ]] || STATUS["${f}"]="unstaged"
    done
    for f in "${STAGED[@]}"; do
      [[ -n "${STATUS["${f}"]}" ]] || STATUS["${f}"]="staged"
    done

    if [ -z "${previous_update}" ] || [ "${previous_update}" == "stage" ]; then
        sort_args+=("-k1,1nr")
    else
        sort_args+=("-k1,1n")
    fi
    sort_args+=("-k3,3")

    {
        printf '%b\n' "${HEADER}"
        for f in "${!STATUS[@]}"; do
          case "${STATUS[${f}]}" in
            conflict)  key=4; color="${MAGENTA}";;
            unstaged)  key=3; color="${YELLOW}";;
            untracked) key=2; color="${RED}";;
            staged)    key=1; color="${GREEN}";;
          esac
          printf "%s\t%b%s%b\t%b%s%b\n" "${key}" "${color}" "${STATUS[${f}]}" "${NC}" "${color}" "${f}" "${NC}"
        done | sort "${sort_args[@]}"
    } | column -t -s $'\t'
}

column_count=$(echo -e "${HEADER}" | tr $'\t' $'\n' | wc -l)
columns="$(seq -s ',' 2 ${column_count})"

case "${mode}" in
    list)
        # the list comes from --print, which fzf runs itself once the picker is
        # open, so building it here as well would only hold the picker back
        fzf-with-header --key-command "${APP} --id "${id}" --key" \
                        --key-descriptions "${KEY_DESCS}" \
                        --reload-keys "${RELOAD_KEYS}" \
                        --exec-reload-keys "${EXEC_RELOAD_KEYS}" \
                        --columns "${columns}" \
                        --command "${APP} --id "${id}" --print ${paths[@]}" \
                        "${query}" \
                        --preview="${PREVIEW_COMMAND}" \
                        --preview-window=right:70%,nowrap \
                        --expect="${EXPECT_KEYS}"
        ;;
    print)
        print_changes
        ;;
esac
