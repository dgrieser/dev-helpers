# groups and projects change rarely, and listing them is a dozen round trips
CACHE_TTL_SECONDS = 24 * 60 * 60


def gitlab_host() -> str:
    host = os.environ.get("GITLAB_HOST", "").strip()
    if host:
        return host
    proc = subprocess.run(
        ["glab", "config", "get", "host"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return (proc.stdout or "").strip()


def cache_dir() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(
        os.path.expanduser("~"), ".cache"
    )
    host = re.sub(r"[^A-Za-z0-9_.-]", "_", gitlab_host() or "default")
    path = os.path.join(base, "git-activity-to-issue", host)
    try:
        os.makedirs(path, exist_ok=True)
    except OSError:
        return ""
    return path


def cached_list(name: str, build: Any) -> list[Any]:
    directory = cache_dir()
    path = os.path.join(directory, f"{name}.json") if directory else ""
    if path:
        try:
            age = datetime.now().timestamp() - os.path.getmtime(path)
        except OSError:
            age = None
        if age is not None and age < CACHE_TTL_SECONDS:
            data = read_json_file(path, None)
            if isinstance(data, list) and data:
                return data
    data = build()
    if path and data:
        try:
            write_json_file(path, data)
        except OSError:
            pass
    return data


# what GitLab was asked for, and what the user picked out of it: the first is
# thrown away by --issue-refresh, the second is the answer to a question and
# outlives it
CACHE_LISTINGS = ("groups.json", "scope.json")
CACHE_SELECTION = "selection.json"


def clear_cache() -> None:
    directory = cache_dir()
    if not directory:
        return
    for name in CACHE_LISTINGS:
        try:
            os.remove(os.path.join(directory, name))
        except OSError:
            pass


def load_selected_scope() -> dict[str, Any] | None:
    directory = cache_dir()
    if not directory:
        return None
    data = read_json_file(os.path.join(directory, CACHE_SELECTION), None)
    if not isinstance(data, dict):
        return None
    groups = [str(value) for value in (data.get("groups") or [])]
    projects = [str(value) for value in (data.get("projects") or [])]
    if not groups and not projects:
        return None
    return {"picked": True, "groups": groups, "projects": projects}


def save_selected_scope(scope: dict[str, Any]) -> None:
    directory = cache_dir()
    if not directory:
        return
    try:
        write_json_file(
            os.path.join(directory, CACHE_SELECTION),
            {"groups": scope.get("groups") or [], "projects": scope.get("projects") or []},
        )
    except OSError:
        pass


def selected_scope_label(scope: dict[str, Any]) -> str:
    parts = list(scope.get("groups") or []) + list(scope.get("projects") or [])
    return ellipsize(", ".join(parts), 70) or "nothing"


