@dataclass(frozen=True)
class IssueRef:
    project_id: int
    iid: int
    source: str
    title: str | None = None
    web_url: str | None = None

    def key(self) -> tuple[int, int]:
        return (self.project_id, self.iid)

    def as_dict(self) -> dict[str, Any]:
        data: dict[str, Any] = {
            "project_id": self.project_id,
            "iid": self.iid,
            "source": self.source,
        }
        if self.title:
            data["title"] = self.title
        if self.web_url:
            data["web_url"] = self.web_url
        return data


class GitLabApi:
    def __init__(self, *, verbose: bool = False) -> None:
        self.verbose = verbose
        self.cache: dict[str, Any] = {}
        self._current_username: str | None = None

    def get(self, path: str) -> Any:
        if path in self.cache:
            return self.cache[path]

        if self.verbose:
            print(f"glab api {path}", file=sys.stderr)

        proc = subprocess.run(
            ["glab", "api", path],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if self.verbose:
            if proc.stdout:
                print(proc.stdout.rstrip(), file=sys.stderr)
            if proc.stderr:
                print(proc.stderr.rstrip(), file=sys.stderr)
        if proc.returncode != 0:
            raise RuntimeError(proc.stderr.strip() or f"glab api failed: {path}")

        try:
            data = json.loads(proc.stdout or "null")
        except json.JSONDecodeError as exc:
            raise RuntimeError(f"invalid JSON from glab api {path}: {exc}") from exc

        self.cache[path] = data
        return data

    def get_paged(
        self,
        path: str,
        *,
        per_page: int = 100,
        max_pages: int = 20,
        workers: int = 8,
    ) -> list[Any]:
        """Every page of a list endpoint - one page is never the whole list.

        A `glab api` call is a process, a TLS handshake and a round trip, so the
        pages after the first are fetched a batch at a time instead of one after
        the other; a short page ends the walk.
        """
        joiner = "&" if "?" in path else "?"

        def page_items(page: int) -> list[Any] | None:
            try:
                data = self.get(f"{path}{joiner}per_page={per_page}&page={page}")
            except RuntimeError:
                return None
            return data if isinstance(data, list) else None

        first = page_items(1)
        if not first:
            return []
        items: list[Any] = list(first)
        if len(first) < per_page:
            return items

        page = 2
        while page <= max_pages:
            batch = list(range(page, min(page + workers, max_pages + 1)))
            with concurrent.futures.ThreadPoolExecutor(max_workers=len(batch)) as pool:
                pages = list(pool.map(page_items, batch))
            done = False
            for data in pages:
                if not data:
                    done = True
                    break
                items.extend(data)
                if len(data) < per_page:
                    done = True
                    break
            if done:
                break
            page += len(batch)
        return items

    def graphql(self, query: str, variables: dict[str, str]) -> Any:
        cmd = ["glab", "api", "graphql", "--raw-field", f"query={query}"]
        for key, value in variables.items():
            cmd.extend(["--raw-field", f"{key}={value}"])

        if self.verbose:
            print(" ".join(cmd), file=sys.stderr)

        proc = subprocess.run(
            cmd,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if self.verbose:
            if proc.stdout:
                print(proc.stdout.rstrip(), file=sys.stderr)
            if proc.stderr:
                print(proc.stderr.rstrip(), file=sys.stderr)
        if proc.returncode != 0:
            raise RuntimeError(proc.stderr.strip() or "glab api graphql failed")

        try:
            data = json.loads(proc.stdout or "null")
        except json.JSONDecodeError as exc:
            raise RuntimeError(f"invalid JSON from glab api graphql: {exc}") from exc

        if isinstance(data, dict) and data.get("errors"):
            raise RuntimeError(f"GitLab GraphQL errors: {data['errors']}")
        return data


def verbose_log(enabled: bool, message: str) -> None:
    if enabled:
        print(message, file=sys.stderr)


def warning(message: str) -> None:
    print(f"WARNING: {message}", file=sys.stderr)


def project_web_url(api: GitLabApi, project_id: int) -> str | None:
    data = api.get(f"projects/{project_id}")
    if not isinstance(data, dict):
        return None
    web_url = data.get("web_url")
    return web_url if isinstance(web_url, str) and web_url else None


def project_from_path(api: GitLabApi, path_with_namespace: str) -> dict[str, Any] | None:
    encoded = urllib.parse.quote(path_with_namespace, safe="")
    data = api.get(f"projects/{encoded}")
    return data if isinstance(data, dict) else None


def project_namespace_path(api: GitLabApi, project_id: int) -> str | None:
    data = api.get(f"projects/{project_id}")
    if not isinstance(data, dict):
        return None
    namespace = data.get("namespace")
    if isinstance(namespace, dict):
        full_path = namespace.get("full_path")
        if isinstance(full_path, str) and full_path:
            return full_path
    path_with_namespace = data.get("path_with_namespace")
    if isinstance(path_with_namespace, str) and "/" in path_with_namespace:
        return path_with_namespace.rsplit("/", 1)[0]
    return None


def issue_from_project_path(
    api: GitLabApi,
    path_with_namespace: str,
    iid: int,
    source: str,
    *,
    merge_request_refs: bool = True,
) -> list[IssueRef]:
    project = project_from_path(api, path_with_namespace)
    if project is None:
        return []

    project_id = int_or_none(project.get("id"))
    if project_id is None:
        return []

    return issues_from_project_ref(
        api,
        project_id,
        iid,
        source,
        merge_request_refs=merge_request_refs,
    )


def issue_from_project_iid(
    api: GitLabApi, project_id: int, iid: int, source: str
) -> IssueRef | None:
    try:
        data = api.get(f"projects/{project_id}/issues/{iid}")
    except RuntimeError as exc:
        verbose_log(
            api.verbose,
            f"resolve issue project={project_id} iid={iid}: not found: {exc}",
        )
        return None

    if isinstance(data, dict):
        return issue_from_api_item(data, source) or IssueRef(project_id, iid, source)
    return None


def merge_request_exists(api: GitLabApi, project_id: int, iid: int) -> bool:
    try:
        data = api.get(f"projects/{project_id}/merge_requests/{iid}")
    except RuntimeError as exc:
        verbose_log(
            api.verbose,
            f"resolve mr project={project_id} iid={iid}: not found: {exc}",
        )
        return False
    return isinstance(data, dict)


def issues_from_project_ref(
    api: GitLabApi,
    project_id: int,
    iid: int,
    source: str,
    *,
    merge_request_refs: bool = True,
) -> list[IssueRef]:
    issue = issue_from_project_iid(api, project_id, iid, source)
    if issue is not None:
        return [issue]

    if not merge_request_refs or not merge_request_exists(api, project_id, iid):
        return []

    issues: list[IssueRef] = []
    for issue in resolve_mr(api, project_id, iid):
        add_issue(issues, issue)
    return issues


def warning_url(api: GitLabApi, event: dict[str, Any]) -> str | None:
    project_id = int_or_none(event.get("project_id"))
    if project_id is None:
        return None

    try:
        base_url = project_web_url(api, project_id)
    except RuntimeError:
        return None
    if base_url is None:
        return None

    target_type = event.get("target_type")
    target_iid = int_or_none(event.get("target_iid"))
    if target_type == "MergeRequest" and target_iid is not None:
        return f"{base_url}/-/merge_requests/{target_iid}"
    if target_type == "Issue" and target_iid is not None:
        return f"{base_url}/-/issues/{target_iid}"
    if target_type == "WorkItem" and target_iid is not None:
        return f"{base_url}/-/work_items/{target_iid}"

    note = event.get("note")
    if isinstance(note, dict):
        noteable_type = note.get("noteable_type")
        noteable_iid = int_or_none(note.get("noteable_iid"))
        note_id = int_or_none(note.get("id") or event.get("target_id"))
        anchor = f"#note_{note_id}" if note_id is not None else ""
        if noteable_type == "MergeRequest" and noteable_iid is not None:
            return f"{base_url}/-/merge_requests/{noteable_iid}{anchor}"
        if noteable_type in ("Issue", "WorkItem") and noteable_iid is not None:
            path = "issues" if noteable_type == "Issue" else "work_items"
            return f"{base_url}/-/{path}/{noteable_iid}{anchor}"

    push_data = event.get("push_data") or {}
    if isinstance(push_data, dict):
        commit_to = str(push_data.get("commit_to") or "")
        commit_from = str(push_data.get("commit_from") or "")
        ref = str(push_data.get("ref") or "")
        ref_type = str(push_data.get("ref_type") or "")
        action_name = str(event.get("action_name") or "")
        if ref_type == "branch" and "deleted" in action_name:
            return base_url
        if commit_to:
            return f"{base_url}/-/commit/{commit_to}"
        if commit_from:
            return f"{base_url}/-/commit/{commit_from}"
        if ref and ref_type == "branch":
            return f"{base_url}/-/tree/{urllib.parse.quote(ref, safe='')}"

    return base_url


def url_is_filtered(url: str | None, filters: list[str]) -> bool:
    if not url or not filters:
        return False
    for raw_prefix in filters:
        prefix = raw_prefix.rstrip("/")
        if not prefix:
            continue
        if url == prefix or url.startswith(f"{prefix}/"):
            return True
    return False


