def print_scope_rows(rows: list[tuple[str, str, str]]) -> None:
    keys = [f"{kind}:{path}" for kind, path, _ in rows] or ["SCOPE"]
    kinds = [kind for kind, _, _ in rows] or ["TYPE"]
    paths = [ellipsize(path, 60) for _, path, _ in rows] or ["PATH"]

    key_width = min(40, max(len("SCOPE"), *(len(value) for value in keys)))
    kind_width = max(len("TYPE"), *(len(value) for value in kinds))
    path_width = max(len("PATH"), *(len(value) for value in paths))

    print(
        pad_column("SCOPE", key_width)
        + pad_column("TYPE", kind_width)
        + pad_column("PATH", path_width)
        + "NAME"
    )
    for index, (kind, _, name) in enumerate(rows):
        print(
            pad_column(keys[index], key_width)
            + C_MUTED
            + pad_column(kind, kind_width)
            + C_RESET
            + pad_column(paths[index], path_width)
            + name
        )


def pick_scope_print() -> int:
    api = GitLabApi()
