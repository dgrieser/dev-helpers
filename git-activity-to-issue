def pick_state_path(run_id: str, suffix: str) -> str:
    return f"/tmp/git-activity-to-issue-{run_id}.{suffix}.json"


def read_json_file(path: str, default: Any = None) -> Any:
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, json.JSONDecodeError):
        return default


def write_json_file(path: str, data: Any) -> None:
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(data, handle, ensure_ascii=False)


def sweep_pick_state() -> None:
    """Drop run state of processes that are gone - a kill runs no cleanup."""
    prefix = "git-activity-to-issue-"
    try:
        names = os.listdir("/tmp")
    except OSError:
        return
    for name in names:
        if not name.startswith(prefix) or not name.endswith(".json"):
            continue
        run_id = name[len(prefix) :].split(".", 1)[0]
        if not run_id.isdigit():
            continue
        try:
            os.kill(int(run_id), 0)
        except ProcessLookupError:
            pass
        except OSError:
            # somebody else's process, or one we may not signal: leave it alone
            continue
        else:
            continue
        try:
            os.remove(os.path.join("/tmp", name))
        except OSError:
            pass


def remove_pick_state(run_id: str) -> None:
    for suffix in ("state", "candidates", "choice", "scope", "labels"):
        try:
            os.remove(pick_state_path(run_id, suffix))
        except OSError:
            pass


def short_age(value: Any) -> str:
    if not isinstance(value, str) or not value:
        return "-"
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return "-"
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    seconds = (datetime.now(timezone.utc) - parsed).total_seconds()
    if seconds < 0:
        seconds = 0
    minutes = int(seconds // 60)
    if minutes < 60:
        return f"{minutes}m"
    hours = minutes // 60
    if hours < 24:
        return f"{hours}h"
    days = hours // 24
    if days < 14:
        return f"{days}d"
    if days < 60:
        return f"{days // 7}w"
    if days < 730:
        return f"{days // 30}mo"
    return f"{days // 365}y"


def local_datetime(value: Any) -> str:
    if not isinstance(value, str) or not value:
        return ""
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return value
    return parsed.astimezone().strftime("%Y-%m-%d %H:%M")


def activity_kind(event: dict[str, Any]) -> tuple[str, str]:
    """A key grouping activities that deserve the same issue, and its label."""
    target_type = str(event.get("target_type") or "")
    action_name = str(event.get("action_name") or "")
    push_data = event.get("push_data")
    if not isinstance(push_data, dict):
        push_data = {}
    ref_type = str(push_data.get("ref_type") or "")

    if target_type == "Project" and ref_type == "branch":
        if "new" in action_name:
            return ("push:branch:new", "new branch pushes")
        return ("push:branch:commits", "commit pushes")
    if target_type == "Project" and ref_type == "tag":
        return ("push:tag", "tag pushes")
    if target_type == "Project":
        return ("push:other", "pushes")
    if target_type == "MergeRequest":
        action = action_name or "changed"
        return (f"mr:{action}", f"{action} merge requests")
    if target_type in ("Note", "DiffNote", "DiscussionNote"):
        return ("note", "comments")
    if target_type in ("Issue", "WorkItem"):
        action = action_name or "changed"
        return (f"issue:{action}", f"{action} issues")
    kind = f"{target_type or 'activity'}:{action_name or 'changed'}"
    return (kind, f"{kind} activities")


def pick_query_prefill(event: dict[str, Any]) -> str:
    push_data = event.get("push_data")
    if not isinstance(push_data, dict):
        push_data = {}
    note = event.get("note")
    if not isinstance(note, dict):
        note = {}
    text = " ".join(
        dedupe_summary_parts(
            [
                event.get("target_title"),
                push_data.get("commit_title"),
                push_data.get("ref"),
                note.get("body"),
            ]
        )
    )
    words: list[str] = []
    for raw in re.split(r"[^A-Za-z0-9]+", text):
        word = raw.strip().lower()
        if len(word) < 3 or word in PICK_QUERY_STOP_WORDS or word.isdigit():
            continue
        if word in words:
            continue
        words.append(word)
        if len(words) >= 6:
            break
    return " ".join(words)


def scope_from_args(args: argparse.Namespace) -> dict[str, Any]:
    return {
        "groups": list(args.issue_group),
        "projects": list(args.issue_project),
        "limit": args.issue_limit,
        "state": args.issue_state,
        # without a scope of its own the picker leans on what is assigned to the
        # user, which is where an issue worth booking to usually is
        "assigned": not (args.issue_group or args.issue_project),
        "explicit": bool(args.issue_group or args.issue_project),
        # a scope nobody named on the command line is asked for once, the first
        # time an activity actually needs the picker
        "asked": bool(args.issue_group or args.issue_project),
    }


def scope_for_event(api: GitLabApi, event: dict[str, Any], scope: dict[str, Any]) -> dict[str, Any]:
    """The configured scope, widened by the project the activity happened in."""
    result = dict(scope)
    result["groups"] = list(scope.get("groups") or [])
    result["projects"] = list(scope.get("projects") or [])
    project_id = int_or_none(event.get("project_id"))
    if project_id is None:
        return result
    if str(project_id) not in result["projects"]:
        result["projects"].append(str(project_id))
    if not scope.get("explicit"):
        try:
            namespace = project_namespace_path(api, project_id)
        except RuntimeError:
            namespace = None
        if namespace:
            root = namespace.split("/", 1)[0]
            if root not in result["groups"]:
                result["groups"].append(root)
    return result


def scope_label(scope: dict[str, Any]) -> str:
    parts = list(scope.get("groups") or []) + list(scope.get("projects") or [])
    if scope.get("assigned"):
        parts.append("assigned to me")
    return ", ".join(parts) if parts else "none"


def scope_issue_paths(scope: dict[str, Any], *, search: str | None = None) -> list[str]:
    limit = int(scope.get("limit") or 100)
    state = str(scope.get("state") or "opened")
    extra = ""
    if search:
        # a search is meant to find the one issue that was named, closed or not
        state = "all"
        extra = (
            f"&search={urllib.parse.quote(search, safe='')}"
            "&in=title%2Cdescription"
        )
    paths: list[str] = []
    for group in scope.get("groups") or []:
        encoded = urllib.parse.quote(str(group), safe="")
        paths.append(
            f"groups/{encoded}/issues?scope=all&state={state}"
            f"&order_by=updated_at&per_page={limit}{extra}"
        )
    for project in scope.get("projects") or []:
        encoded = urllib.parse.quote(str(project), safe="")
        paths.append(
            f"projects/{encoded}/issues?state={state}"
            f"&order_by=updated_at&per_page={limit}{extra}"
        )
    if scope.get("assigned"):
        paths.append(
            f"issues?scope=assigned_to_me&state={state}"
            f"&order_by=updated_at&per_page={limit}{extra}"
        )
    return paths


def candidate_from_item(item: dict[str, Any]) -> dict[str, Any] | None:
    project_id = int_or_none(item.get("project_id"))
    iid = int_or_none(item.get("iid"))
    if project_id is None or iid is None:
        return None

    project_path = ""
    references = item.get("references")
    if isinstance(references, dict):
        full = references.get("full")
        if isinstance(full, str) and "#" in full:
            project_path = full.rsplit("#", 1)[0]
    if not project_path:
        web_url = item.get("web_url")
        if isinstance(web_url, str) and "/-/" in web_url:
            path = urllib.parse.urlsplit(web_url).path
            project_path = path.split("/-/", 1)[0].strip("/")
    if not project_path:
        project_path = str(project_id)

    epic = item.get("epic")
    epic_title = None
    if isinstance(epic, dict):
        epic_title = epic.get("title")

    milestone = item.get("milestone")
    milestone_title = None
    if isinstance(milestone, dict):
        milestone_title = milestone.get("title")

    assignees = []
    for assignee in item.get("assignees") or []:
        if isinstance(assignee, dict) and assignee.get("username"):
            assignees.append(str(assignee["username"]))

    return {
        "ref": f"{project_id}#{iid}",
        "project_id": project_id,
        "iid": iid,
        "project_path": project_path,
        "full_ref": f"{project_path}#{iid}",
        "title": clean_summary_part(item.get("title")) or "-",
        "state": str(item.get("state") or "-"),
        "updated_at": item.get("updated_at") or item.get("created_at") or "",
        "web_url": item.get("web_url") or "",
        "labels": [str(label) for label in (item.get("labels") or [])],
        "milestone": milestone_title,
        "epic": epic_title,
        "assignees": assignees,
        "description": item.get("description") or "",
    }


def load_candidates(
    api: GitLabApi,
    scope: dict[str, Any],
    *,
    search: str | None = None,
    existing: list[dict[str, Any]] | None = None,
) -> list[dict[str, Any]]:
    merged: dict[str, dict[str, Any]] = {}
    for candidate in existing or []:
        merged[candidate["ref"]] = candidate

    for path in scope_issue_paths(scope, search=search):
        try:
            data = api.get(path)
        except RuntimeError as exc:
            verbose_log(api.verbose, f"candidates {path}: {exc}")
            continue
        if not isinstance(data, list):
            continue
        for item in data:
            if not isinstance(item, dict):
                continue
            candidate = candidate_from_item(item)
            if candidate is not None:
                merged[candidate["ref"]] = candidate

    return sorted(
        merged.values(), key=lambda entry: str(entry.get("updated_at") or ""), reverse=True
    )


def pad_column(value: str, width: int) -> str:
    return value + " " * max(2, width - len(value) + 2)


def print_candidate_rows(candidates: list[dict[str, Any]]) -> None:
    refs = [entry["ref"] for entry in candidates] or ["REF"]
    states = [entry["state"] for entry in candidates] or ["STATE"]
    ages = [short_age(entry.get("updated_at")) for entry in candidates] or ["UPDATED"]
    issues = [
        ellipsize(entry["full_ref"], 46) for entry in candidates
    ] or ["ISSUE"]

    ref_width = max(len("REF"), *(len(value) for value in refs))
    state_width = max(len("STATE"), *(len(value) for value in states))
    age_width = max(len("UPDATED"), *(len(value) for value in ages))
    issue_width = max(len("ISSUE"), *(len(value) for value in issues))

    print(
        pad_column("REF", ref_width)
        + pad_column("STATE", state_width)
        + pad_column("UPDATED", age_width)
        + pad_column("ISSUE", issue_width)
        + "TITLE"
    )
    for index, entry in enumerate(candidates):
        state = entry["state"]
        state_color = C_OPEN if state == "opened" else C_CLOSED
        print(
            C_REF
            + pad_column(entry["ref"], ref_width)
            + C_RESET
            + state_color
            + pad_column(state, state_width)
            + C_RESET
            + C_MUTED
            + pad_column(ages[index], age_width)
            + C_RESET
            + pad_column(issues[index], issue_width)
            + entry["title"]
        )


def print_candidate_preview(candidate: dict[str, Any]) -> None:
    print(f"{C_REF}{candidate['full_ref']}{C_RESET}  {candidate['title']}")
    print()
    rows = [
        ("state", candidate.get("state")),
        ("updated", local_datetime(candidate.get("updated_at"))),
        ("epic", candidate.get("epic")),
        ("milestone", candidate.get("milestone")),
        ("assignees", ", ".join(candidate.get("assignees") or [])),
        ("labels", ", ".join(candidate.get("labels") or [])),
        ("url", candidate.get("web_url")),
    ]
    for label, value in rows:
        if value:
            print(f"{C_MUTED}{label:<10}{C_RESET}{value}")
    description = candidate.get("description") or ""
    if description:
        print()
        rendered = description
        if helper_path("glow"):
            width = int_or_none(os.environ.get("FZF_PREVIEW_COLUMNS")) or 100
            proc = subprocess.run(
                ["glow", "-s", "dark", "-w", str(max(20, width - 2)), "-"],
                check=False,
                text=True,
                input=description,
                stdout=subprocess.PIPE,
            )
            if proc.returncode == 0 and proc.stdout:
                rendered = proc.stdout.rstrip("\n")
        print(rendered)


def tty_width(default: int = 100) -> int:
    for stream in (sys.stderr, sys.stdout):
        try:
            if stream is not None and stream.isatty():
                return os.get_terminal_size(stream.fileno()).columns
        except (OSError, ValueError):
            pass
    try:
        with open("/dev/tty", "w", encoding="utf-8") as handle:
            return os.get_terminal_size(handle.fileno()).columns
    except (OSError, ValueError):
        return default


def preview_width() -> int:
    return int_or_none(os.environ.get("FZF_PREVIEW_COLUMNS")) or tty_width()


def activity_block(state: dict[str, Any], width: int) -> str:
    """The activity an issue is being chosen for, in full, for the preview."""
    width = max(40, width)
    label_width = 9
    lines: list[str] = []

    def row(label: str, value: str, *, color: str = "", wrap: bool = True) -> None:
        if not value:
            return
        room = width - label_width
        # a URL broken over two lines is no longer one a terminal can open, so
        # it stays whole even where it does not fit
        parts = textwrap.wrap(value, room) if wrap else [value]
        for index, part in enumerate(parts or [""]):
            head = f"{label:<{label_width}}" if index == 0 else " " * label_width
            lines.append(f"{C_MUTED}{head}{C_RESET}{color}{part}{C_RESET}")

    row("activity", str(state.get("activity_summary_full") or state.get("activity_summary") or ""))
    row("project", str(state.get("project_path") or ""))
    row("when", str(state.get("activity_when") or ""))
    row("kind", str(state.get("kind_label") or ""))
    row("branch", str(state.get("branch") or ""))
    row("commit", str(state.get("commit_sha") or "")[:12])
    row("url", str(state.get("activity_url") or ""), color=C_REF, wrap=False)
    return "\n".join(lines)


def run_prompt(cmd: list[str]) -> tuple[int, str]:
    """Run a cli-helpers prompt; its UI is on the tty, its answer on stdout."""
    proc = subprocess.run(cmd, check=False, text=True, stdout=subprocess.PIPE)
    return proc.returncode, (proc.stdout or "").strip("\n")


def ask_line(question: str, default: str = "") -> str | None:
    cmd = ["prompt-input", question]
    if default:
        cmd.extend(["--default", default])
    code, answer = run_prompt(cmd)
    if code != 0:
        return None
    return answer


def ask_text(default: str = "") -> str | None:
    cmd = ["prompt-multiline"]
    if default:
        cmd.extend(["--default", default])
    code, answer = run_prompt(cmd)
    if code != 0:
        return None
    return answer


def ask_select(question: str, entries: list[tuple[str, str]], default: str = "") -> str | None:
    cmd = ["prompt-select", "--prompt", question, "--return", "key"]
    if default:
        cmd.extend(["--default", default])
    cmd.extend(f"{key}={title}" for key, title in entries)
    code, answer = run_prompt(cmd)
    if code != 0:
        return None
    return answer


def glab_write(
    api: GitLabApi,
    method: str,
    path: str,
    fields: list[tuple[str, str]],
    *,
    typed: tuple[str, ...] = (),
) -> Any:
    cmd = ["glab", "api", "-X", method, path]
    for key, value in fields:
        flag = "--field" if key in typed else "--raw-field"
        cmd.extend([flag, f"{key}={value}"])
    if api.verbose:
        print(" ".join(cmd), file=sys.stderr)
    proc = subprocess.run(
        cmd, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or f"glab api {method} {path} failed")
    try:
        return json.loads(proc.stdout or "null")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid JSON from glab api {path}: {exc}") from exc


def resolve_project_id(api: GitLabApi, value: str) -> int | None:
    numeric = int_or_none(value)
    if numeric is not None:
        return numeric
    project = project_from_path(api, value)
    if project is None:
        return None
    return int_or_none(project.get("id"))


def user_id_for_username(api: GitLabApi, username: str) -> int | None:
    encoded = urllib.parse.quote(username, safe="")
    try:
        data = api.get(f"users?username={encoded}")
    except RuntimeError:
        return None
    if isinstance(data, list) and data:
        first = data[0]
        if isinstance(first, dict):
            return int_or_none(first.get("id"))
    return None


def group_epics(api: GitLabApi, project_id: int) -> list[dict[str, Any]]:
    try:
        namespace = project_namespace_path(api, project_id)
    except RuntimeError:
        return []
    if not namespace:
        return []
    root = namespace.split("/", 1)[0]
    encoded = urllib.parse.quote(root, safe="")
    data = api.get_paged(
        f"groups/{encoded}/epics?state=opened&include_descendant_groups=true"
        "&order_by=updated_at"
    )
    return [item for item in data if isinstance(item, dict)]


def known_project_paths(state: dict[str, Any], candidates: list[dict[str, Any]]) -> list[str]:
    paths: list[str] = []
    own = state.get("project_path")
    if own:
        paths.append(str(own))
    for candidate in candidates:
        path = candidate.get("project_path")
        if path and path not in paths:
            paths.append(str(path))
    return paths


def create_issue_interactively(
    api: GitLabApi,
    run_id: str,
    state: dict[str, Any],
    candidates: list[dict[str, Any]],
) -> dict[str, Any] | None:
    """Walk the user through creating an issue. None means they aborted."""
    default_project = str(state.get("project_path") or "")
    paths = known_project_paths(state, candidates)
    code, answer = run_prompt(
        ["prompt-complete", "--prompt", "Project:", "--default", default_project] + paths
    )
    if code != 0:
        return None
    project_path = answer.strip() or default_project
    if not project_path:
        warning("no project for the new issue")
        return None

    project_id = resolve_project_id(api, project_path)
    if project_id is None:
        warning(f"unknown project: {project_path}")
        return None

    title = ask_line("Title:", str(state.get("issue_title_default") or ""))
    if title is None:
        return None
    title = title.strip()
    if not title:
        warning("an issue needs a title")
        return None

    print("Description:", file=sys.stderr)
    description = ask_text(str(state.get("issue_description_default") or ""))
    if description is None:
        return None

    epic_id: int | None = None
    epics = group_epics(api, project_id)
    if epics:
        entries = [("", "(none)")]
        for epic in epics:
            epic_iid = int_or_none(epic.get("id"))
            if epic_iid is None:
                continue
            entries.append((str(epic_iid), ellipsize(epic.get("title"), 80)))
        answer = ask_select("Parent epic:", entries, default="")
        if answer is None:
            return None
        epic_id = int_or_none(answer)

    labels = ask_labels(run_id, project_id)

    assignee = ask_line("Assignee:", str(state.get("current_username") or ""))
    if assignee is None:
        return None

    print(file=sys.stderr)
    print(f"{project_path}: {title}", file=sys.stderr)
    proc = subprocess.run(["prompt-continue"], check=False)
    if proc.returncode != 0:
        return None

    fields: list[tuple[str, str]] = [("title", title), ("description", description)]
    if labels.strip():
        fields.append(("labels", labels.strip()))
    assignee_id = user_id_for_username(api, assignee.strip()) if assignee.strip() else None
    if assignee_id is not None:
        fields.append(("assignee_ids[]", str(assignee_id)))
    typed = ("assignee_ids[]", "epic_id")

    path = f"projects/{project_id}/issues"
    created: Any = None
    if epic_id is not None:
        try:
            created = glab_write(
                api, "POST", path, fields + [("epic_id", str(epic_id))], typed=typed
            )
        except RuntimeError as exc:
            warning(f"cannot set the parent epic, creating without it: {exc}")
            created = None
    if not isinstance(created, dict):
        try:
            created = glab_write(api, "POST", path, fields, typed=typed)
        except RuntimeError as exc:
            warning(f"cannot create the issue: {exc}")
            return None

    candidate = candidate_from_item(created)
    if candidate is None:
        warning("GitLab did not return the created issue")
        return None
    print(f"created {candidate['full_ref']} {candidate['web_url']}", file=sys.stderr)
    return candidate


def link_fields(event: dict[str, Any]) -> dict[str, Any]:
    """What write_back_target needs of an activity, from the event itself."""
    push_data = event.get("push_data")
    if not isinstance(push_data, dict):
        push_data = {}
    note = event.get("note")
    if not isinstance(note, dict):
        note = {}
    return {
        "project_id": int_or_none(event.get("project_id")),
        "target_type": event.get("target_type"),
        "target_iid": int_or_none(event.get("target_iid")),
        "commit_sha": str(
            push_data.get("commit_to") or push_data.get("commit_from") or ""
        ),
        "noteable_type": note.get("noteable_type"),
        "noteable_iid": int_or_none(note.get("noteable_iid")),
    }


def ref_from_web_url(web_url: str | None, iid: int) -> str:
    path = urllib.parse.urlsplit(web_url or "").path
    if "/-/" in path:
        return f"{path.split('/-/', 1)[0].strip('/')}#{iid}"
    return f"#{iid}"


def write_back_target(
    state: dict[str, Any], candidate: dict[str, Any]
) -> tuple[str, str, str] | None:
    """(label, api path, body field) of the place a back reference belongs."""
    project_id = int_or_none(state.get("project_id"))
    target_type = str(state.get("target_type") or "")
    target_iid = int_or_none(state.get("target_iid"))
    commit_sha = str(state.get("commit_sha") or "")
    noteable_type = str(state.get("noteable_type") or "")
    noteable_iid = int_or_none(state.get("noteable_iid"))

    if project_id is not None:
        if target_type == "Project" and commit_sha:
            return (
                f"comment on commit {commit_sha[:8]}",
                f"projects/{project_id}/repository/commits/{commit_sha}/comments",
                "note",
            )
        if target_type == "MergeRequest" and target_iid is not None:
            return (
                f"comment on merge request !{target_iid}",
                f"projects/{project_id}/merge_requests/{target_iid}/notes",
                "body",
            )
        if noteable_iid is not None and noteable_type == "MergeRequest":
            return (
                f"comment on merge request !{noteable_iid}",
                f"projects/{project_id}/merge_requests/{noteable_iid}/notes",
                "body",
            )
        if noteable_iid is not None and noteable_type in ("Issue", "WorkItem"):
            return (
                f"comment on issue #{noteable_iid}",
                f"projects/{project_id}/issues/{noteable_iid}/notes",
                "body",
            )

    issue_project = int_or_none(candidate.get("project_id"))
    issue_iid = int_or_none(candidate.get("iid"))
    if issue_project is None or issue_iid is None:
        return None
    return (
        f"comment on {candidate['full_ref']}",
        f"projects/{issue_project}/issues/{issue_iid}/notes",
        "body",
    )


def post_write_back(
    api: GitLabApi, state: dict[str, Any], candidate: dict[str, Any]
) -> None:
    """Comment the issue reference where the resolver will read it next run."""
    target = write_back_target(state, candidate)
    if target is None:
        return
    label, path, field = target
    body = candidate["full_ref"]
    activity_url = state.get("activity_url")
    if activity_url:
        body = f"{body}\n\n{activity_url}"
    try:
        glab_write(api, "POST", path, [(field, body)])
    except RuntimeError as exc:
        warning(f"cannot write the back reference: {exc}")
        return
    print(f"linked {candidate['full_ref']} ({label})", file=sys.stderr)


def ask_write_back(state: dict[str, Any], candidate: dict[str, Any]) -> str:
    """How far the back reference reaches: no, this activity, kind, project."""
    target = write_back_target(state, candidate)
    if target is None:
        return "no"
    label = target[0]
    kind_label = str(state.get("kind_label") or "activities")
    project_path = str(state.get("project_path") or "this project")
    answer = ask_select(
        f"Link to {candidate['full_ref']} in GitLab ({label}) for:",
        [
            ("no", "nothing, leave GitLab alone"),
            ("none", "this activity"),
            ("kind", f"every {kind_label} in {project_path} from here on"),
            ("project", f"every activity in {project_path} from here on"),
        ],
        default="no",
    )
    return answer or "no"


def ask_reuse(state: dict[str, Any], question: str) -> str:
    kind_label = str(state.get("kind_label") or "activities")
    project_path = str(state.get("project_path") or "this project")
    answer = ask_select(
        question,
        [
            ("none", "just this activity"),
            ("kind", f"all {kind_label} in {project_path}"),
            ("project", f"all activities in {project_path}"),
        ],
        default="none",
    )
    return answer or "none"


def finish_choice(
    api: GitLabApi,
    run_id: str,
    state: dict[str, Any],
    candidate: dict[str, Any],
    source: str,
) -> int:
    # a link scope named for an earlier activity answers this one already
    if state.get("link_remembered"):
        link_reuse = "remembered"
        post_write_back(api, state, candidate)
    else:
        link_reuse = ask_write_back(state, candidate)
        if link_reuse != "no":
            post_write_back(api, state, candidate)
    reuse = ask_reuse(state, f"Use {candidate['full_ref']} for:")
    write_json_file(
        pick_state_path(run_id, "choice"),
        {
            "action": "use",
            "source": source,
            "reuse": reuse,
            "link_reuse": link_reuse,
            "issue": candidate,
        },
    )
    return 1


def pick_print(run_id: str) -> int:
    candidates = read_json_file(pick_state_path(run_id, "candidates"), []) or []
    print_candidate_rows(candidates)
    return 0


def pick_preview(run_id: str, ref: str) -> int:
    width = preview_width()
    state = read_json_file(pick_state_path(run_id, "state"), {}) or {}
    # the activity leads every preview: the issue is chosen for it, so it has to
    # be readable in full while the issues are walked
    print(activity_block(state, width))
    print()
    print(f"{C_MUTED}{'─' * width}{C_RESET}")
    print()
    candidates = read_json_file(pick_state_path(run_id, "candidates"), []) or []
    for candidate in candidates:
        if candidate.get("ref") == ref:
            print_candidate_preview(candidate)
            break
    return 0


