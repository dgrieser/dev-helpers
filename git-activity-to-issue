def pick_labels_key(run_id: str, payload: str) -> int:
    lines = (payload or "").split("\n")
    key = lines[0].strip() if lines else ""
    if key != "enter":
        write_json_file(pick_state_path(run_id, "labels"), {"picked": False})
        return 1

    names: list[str] = []
    for line in lines[1:]:
        if not line.strip():
            continue
        # a label name may carry single spaces, the columns are two apart
        name = re.split(r"  +", line.strip())[0].strip()
        if name and name not in names:
            names.append(name)
    # nothing marked: whatever was typed is taken as a label of its own, so a
    # label the project does not have yet can be given here as well
    if not names:
        typed = os.environ.get("FZF_WITH_HEADER_QUERY", "").strip()
        if typed:
            names.append(typed)

    write_json_file(
        pick_state_path(run_id, "labels"), {"picked": bool(names), "labels": names}
    )
    return 1


def ask_labels(run_id: str, project_id: int) -> str:
