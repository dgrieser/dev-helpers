def pick_scope_key(run_id: str, payload: str) -> int:
    lines = (payload or "").split("\n")
    key = lines[0].strip() if lines else ""
    if key != "enter":
        # esc, or fzf ended without a key: the scope stays what it was
        write_json_file(pick_state_path(run_id, "scope"), {"picked": False})
        return 1

    groups: list[str] = []
    projects: list[str] = []
    for line in lines[1:]:
        field = line.split()[0] if line.strip() else ""
        kind, _, path = field.partition(":")
        if not path:
            continue
        if kind == "group" and path not in groups:
            groups.append(path)
        elif kind == "project" and path not in projects:
            projects.append(path)

    # nothing marked: whatever was typed is taken as a path of its own, so a
    # group or project the cached list does not have yet can be given here too
    if not groups and not projects:
        typed = os.environ.get("FZF_WITH_HEADER_QUERY", "").strip()
        if typed:
            api = GitLabApi()
            try:
                project = project_from_path(api, typed)
            except RuntimeError:
                project = None
            if project is not None:
                projects.append(typed)
            else:
                groups.append(typed)

    write_json_file(
        pick_state_path(run_id, "scope"),
        {"picked": bool(groups or projects), "groups": groups, "projects": projects},
    )
    return 1


def ask_scope(run_id: str) -> dict[str, Any] | None:
    """Let the user name the groups and projects to look for issues in."""
    base = f"{shlex.quote(self_command())} --pick-id {shlex.quote(run_id)}"
    cmd = [
        "fzf-with-header",
        "--key-command", f"{base} --pick-scope-key",
        "--command", f"{base} --pick-scope-print",
        "--key-descriptions", SCOPE_KEY_DESCS,
        "--columns", "2,3,4",
        "--multi",
        "--prompt=where to look for issues> ",
        f"--expect={SCOPE_KEYS}",
        "--no-sort",
    ]
    try:
        os.remove(pick_state_path(run_id, "scope"))
    except OSError:
        pass
    with open("/dev/tty", "r", encoding="utf-8") as tty_in, open(
        "/dev/tty", "w", encoding="utf-8"
    ) as tty_out:
        subprocess.run(cmd, check=False, stdin=tty_in, stdout=tty_out, stderr=tty_out)
    answer = read_json_file(pick_state_path(run_id, "scope"), {}) or {}
    if not answer.get("picked"):
        return None
    return answer


def ask_scope_remembered(run_id: str) -> dict[str, Any] | None:
    """The scope of the last run, kept: this one only confirms or changes it."""
    saved = load_selected_scope()
    if saved is None:
        chosen = ask_scope(run_id)
        if chosen is not None:
            save_selected_scope(chosen)
        return chosen

    answer = ask_select(
        "Where to look for issues:",
        [
            ("use", f"use {selected_scope_label(saved)}"),
            ("change", "pick groups and projects again"),
            ("skip", "this project, its group and what is assigned to me"),
        ],
        default="use",
    )
    if answer == "use":
        return saved
    if answer != "change":
        return None

    chosen = ask_scope(run_id)
    if chosen is None:
        # the picker was left without a selection: the saved one still stands
        return saved
    save_selected_scope(chosen)
    return chosen


@dataclass(frozen=True)
class PickChoice:
    action: str
    issue: IssueRef | None
    reuse: str
    link_reuse: str
    scope: dict[str, Any]


def resolve_interactively(
    api: GitLabApi,
    event: dict[str, Any],
    *,
    summary: str,
    url: str | None,
    scope: dict[str, Any],
    run_id: str,
    verbose: bool,
    link_remembered: bool = False,
) -> PickChoice:
    """Open the picker for one activity and report what came out of it."""
    if not scope.get("asked"):
        scope = dict(scope)
        scope["asked"] = True
        chosen = ask_scope_remembered(run_id)
        if chosen is not None:
            scope["groups"] = chosen["groups"]
            scope["projects"] = chosen["projects"]
            scope["assigned"] = False
            scope["explicit"] = True
    event_scope = scope_for_event(api, event, scope)
    state = build_pick_state(
        api,
        event,
        summary=summary,
        url=url,
        scope=event_scope,
        initial_scope=event_scope,
        verbose=verbose,
        link_remembered=link_remembered,
    )
    write_json_file(pick_state_path(run_id, "state"), state)
    try:
        candidates = load_candidates(api, event_scope)
    except RuntimeError as exc:
        warning(f"cannot list issues: {exc}")
        candidates = []
    write_json_file(pick_state_path(run_id, "candidates"), candidates)
    try:
        os.remove(pick_state_path(run_id, "choice"))
    except OSError:
        pass

    run_picker(run_id)

    # a group picked inside the picker sticks for the rest of the run; a scope
    # nobody touched stays the one the caller had, project of the activity and all
    state_after = read_json_file(pick_state_path(run_id, "state"), {}) or {}
    next_scope = state_after.get("scope")
    if isinstance(next_scope, dict) and next_scope != event_scope:
        scope = next_scope

    choice = read_json_file(pick_state_path(run_id, "choice"), {}) or {}
    action = str(choice.get("action") or "skip")
    reuse = str(choice.get("reuse") or "none")
    link_reuse = str(choice.get("link_reuse") or "no")
    if action != "use":
        return PickChoice(action, None, reuse, link_reuse, scope)

    issue_data = choice.get("issue") or {}
    project_id = int_or_none(issue_data.get("project_id"))
    iid = int_or_none(issue_data.get("iid"))
    if project_id is None or iid is None:
        return PickChoice("skip", None, "none", "no", scope)
    issue = IssueRef(
        project_id=project_id,
        iid=iid,
        source=str(choice.get("source") or "picked"),
        title=issue_data.get("title") or None,
        web_url=issue_data.get("web_url") or None,
    )
    return PickChoice("use", issue, reuse, link_reuse, scope)


