def cached_group_rows(api: GitLabApi) -> list[Any]:
    def build() -> list[Any]:
        rows: list[Any] = []
        for item in api.get_paged("groups?min_access_level=10&order_by=name&sort=asc"):
            if isinstance(item, dict) and item.get("full_path"):
                rows.append(
                    [
                        str(item["full_path"]),
                        clean_summary_part(item.get("name")) or "-",
                    ]
                )
        return rows

    return cached_list("groups", build)


def pick_groups(run_id: str) -> int:
    state = read_json_file(pick_state_path(run_id, "state"), {}) or {}
    api = GitLabApi(verbose=bool(state.get("verbose")))
    rows = [("(configured)", "the scope this run started with")]
    rows.extend((row[0], row[1]) for row in cached_group_rows(api))
    width = min(48, max(len("GROUP"), *(len(row[0]) for row in rows)))
    print(pad_column("GROUP", width) + "NAME")
    for path, name in rows:
        print(pad_column(path, width) + name)
    return 0


def pick_key(run_id: str, payload: str) -> int:
    lines = (payload or "").split("\n")
    key = lines[0].strip() if lines else ""
    line = lines[1] if len(lines) > 1 else ""
    state_file = pick_state_path(run_id, "state")
    candidates_file = pick_state_path(run_id, "candidates")
    state = read_json_file(state_file, {}) or {}
    candidates = read_json_file(candidates_file, []) or []
    api = GitLabApi(verbose=bool(state.get("verbose")))

    ref = line.split()[0] if line.strip() else ""
    candidate = next((entry for entry in candidates if entry.get("ref") == ref), None)

    if key == "esc":
        reuse = ask_reuse(state, "Leave without an issue for:")
        write_json_file(
            pick_state_path(run_id, "choice"), {"action": "skip", "reuse": reuse}
        )
        return 1
    if key == "ctrl-t":
        write_json_file(pick_state_path(run_id, "choice"), {"action": "retry"})
        return 1
    if key == "enter":
        if candidate is None:
            print("no issue under the cursor", file=sys.stderr)
            return 0
        return finish_choice(api, run_id, state, candidate, "picked")
    if key == "alt-i":
        created = create_issue_interactively(api, run_id, state, candidates)
        if created is None:
            return 0
        candidates.insert(0, created)
        write_json_file(candidates_file, candidates)
        return finish_choice(api, run_id, state, created, "created")
    if key == "ctrl-a":
        activity_url = state.get("activity_url")
        if activity_url:
            subprocess.run(
                ["gio", "open", activity_url],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        return 0
    if key == "ctrl-o":
        if candidate and candidate.get("web_url"):
            subprocess.run(
                ["gio", "open", candidate["web_url"]],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        return 0
    if key == "ctrl-y":
        if candidate and candidate.get("web_url"):
            subprocess.run(["clip"], check=False, text=True, input=candidate["web_url"])
            print(f"{candidate['web_url']} copied to clipboard.", file=sys.stderr)
        return 0
    if key == "ctrl-s":
        query = os.environ.get("FZF_WITH_HEADER_ANSWER", "").strip()
        if not query:
            return 0
        scope = state.get("scope") or {}
        try:
            merged = load_candidates(api, scope, search=query, existing=candidates)
        except RuntimeError as exc:
            print(f"search failed: {exc}", file=sys.stderr)
            return 0
        write_json_file(candidates_file, merged)
        found = len(merged) - len(candidates)
        print(f"{found} more issue(s) for '{query}'", file=sys.stderr)
        return 0
    if key == "ctrl-f":
        answer = os.environ.get("FZF_WITH_HEADER_ANSWER", "").strip()
        group = answer.split()[0] if answer else ""
        if not group:
            return 0
        scope = dict(state.get("scope") or {})
        if group == "(configured)":
            scope = dict(state.get("initial_scope") or scope)
        else:
            scope["groups"] = [group]
            scope["projects"] = []
            scope["assigned"] = False
        state["scope"] = scope
        state["scope_label"] = scope_label(scope)
        write_json_file(state_file, state)
        try:
            merged = load_candidates(api, scope)
        except RuntimeError as exc:
            print(f"cannot list issues of {group}: {exc}", file=sys.stderr)
            return 0
        write_json_file(candidates_file, merged)
        return 0

    # fzf was ended without one of the keys, e.g. by ctrl-c: the picker must
    # not come back, or there is no way out of it
    write_json_file(pick_state_path(run_id, "choice"), {"action": "skip"})
    return 1


def run_picker(run_id: str) -> int:
    base = f"{shlex.quote(self_command())} --pick-id {shlex.quote(run_id)}"
    cmd = [
        "fzf-with-header",
        "--key-command", f"{base} --pick-key",
        "--command", f"{base} --pick-print",
        "--footer-prefix", f"{base} --pick-footer",
        "--key-descriptions", PICK_KEY_DESCS,
        "--columns", PICK_COLUMNS,
        "--reload-keys", PICK_RELOAD_KEYS,
        "--silent-keys", PICK_SILENT_KEYS,
        "--ask", "ctrl-s:Search issues:",
        "--ask-prefill", f"ctrl-s:{base} --pick-query",
        "--pick", "ctrl-f:Group:",
        "--pick-command", f"ctrl-f:{base} --pick-groups",
        f"--preview={base} --pick-preview {{1}}",
        "--preview-window=right:60%,nowrap",
        f"--expect={PICK_KEYS}",
        "--no-sort",
    ]
    with open("/dev/tty", "r", encoding="utf-8") as tty_in, open(
        "/dev/tty", "w", encoding="utf-8"
    ) as tty_out:
        proc = subprocess.run(
            cmd, check=False, stdin=tty_in, stdout=tty_out, stderr=tty_out
        )
    return proc.returncode


def build_pick_state(
    api: GitLabApi,
    event: dict[str, Any],
    *,
    summary: str,
    url: str | None,
    scope: dict[str, Any],
    initial_scope: dict[str, Any],
    verbose: bool,
    link_remembered: bool = False,
) -> dict[str, Any]:
    project_id = int_or_none(event.get("project_id"))
    push_data = event.get("push_data")
    if not isinstance(push_data, dict):
        push_data = {}
    note = event.get("note")
    if not isinstance(note, dict):
        note = {}
    kind_key, kind_label = activity_kind(event)

    project_path = ""
    if project_id is not None:
        try:
            project = api.get(f"projects/{project_id}")
        except RuntimeError:
            project = None
        if isinstance(project, dict):
            project_path = str(project.get("path_with_namespace") or "")
    if not project_path and project_id is not None:
        project_path = str(project_id)

    title_default = clean_summary_part(
        push_data.get("commit_title") or event.get("target_title")
    )
    description_default = activity_summary(event, ellipsized=False)
    if url:
        description_default = f"{description_default}\n\nSee: {url}"

    try:
        username = current_username(api)
    except RuntimeError:
        username = ""

    created = event_created_at(event)
    return {
        "activity_summary": summary,
        "activity_summary_full": activity_summary(event, ellipsized=False),
        "activity_when": created.astimezone().strftime("%Y-%m-%d %H:%M") if created else "",
        "branch": clean_summary_part(push_data.get("ref")),
        "activity_url": url,
        "project_id": project_id,
        "project_path": project_path,
        **link_fields(event),
        "kind_key": kind_key,
        "kind_label": kind_label,
        "scope": scope,
        "initial_scope": initial_scope,
        "scope_label": scope_label(scope),
        "query_prefill": pick_query_prefill(event),
        "issue_title_default": title_default,
        "issue_description_default": description_default,
        "current_username": username,
        "link_remembered": link_remembered,
        "verbose": verbose,
    }


# a remembered decision is either an issue or the decision to book none
REUSE_SKIP = "skip"


class ReuseMap:
    """Choices the user asked to apply again, for this run only."""

    def __init__(self) -> None:
        self.by_kind: dict[tuple[int, str], Any] = {}
        self.by_project: dict[int, Any] = {}
        self.link_kinds: set[tuple[int, str]] = set()
        self.link_projects: set[int] = set()

    def lookup(self, event: dict[str, Any]) -> Any:
        project_id = int_or_none(event.get("project_id"))
        if project_id is None:
            return None
        kind_key, _ = activity_kind(event)
        issue = self.by_kind.get((project_id, kind_key))
        if issue is not None:
            return issue
        return self.by_project.get(project_id)

    def remember(self, event: dict[str, Any], issue: Any, reuse: str) -> None:
        project_id = int_or_none(event.get("project_id"))
        if project_id is None or reuse not in ("kind", "project"):
            return
        if reuse == "project":
            self.by_project[project_id] = issue
            return
        kind_key, _ = activity_kind(event)
        self.by_kind[(project_id, kind_key)] = issue

    def lookup_link(self, event: dict[str, Any]) -> bool:
        """Whether this activity is to be commented on without asking again."""
        project_id = int_or_none(event.get("project_id"))
        if project_id is None:
            return False
        if project_id in self.link_projects:
            return True
        kind_key, _ = activity_kind(event)
        return (project_id, kind_key) in self.link_kinds

    def remember_link(self, event: dict[str, Any], link_reuse: str) -> None:
        project_id = int_or_none(event.get("project_id"))
        if project_id is None or link_reuse not in ("kind", "project"):
            return
        if link_reuse == "project":
            self.link_projects.add(project_id)
            return
        kind_key, _ = activity_kind(event)
        self.link_kinds.add((project_id, kind_key))


