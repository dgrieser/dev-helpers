#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }
git-color() { command git-color --color=always "$@"; }

usage() {
    echo "Usage: $(basename "${0}") <git url>" 1>&2
    exit 1
}

URL=""
while [ $# -gt 0 ]; do
    case "${1}" in
        -h|--help)
            usage
            ;;
        *)
            if [ -z "${URL}" ]; then
                URL="${1}"
            else
                usage
            fi
            ;;
    esac
    shift
done

if [ -z "${URL}" ]; then
    command -v clip-paste &>/dev/null && URL="$(clip-paste)"
    command -v prompt-input &>/dev/null && if ! URL="$(prompt-input "URL:" -d "${URL}")"; then exit 1; fi
fi
[ -z "${URL}" ] && usage

PARENT_DIR="$(pwd)"

abort() {
    echo "Abort." 1>&2
    exit 1
}

if [[ ! "${URL}" =~ ^(https?|ssh)://.* ]] && [[ ! "${URL}" =~ ^git@.* ]]; then
    echo 1>&2
    echo "Looking for repository: ${URL}" 1>&2
    repo="$(git-search "${URL}")"
    if [ -z "${repo}" ]; then
        echo "ERROR: No such repository: ${URL}" 1>&2
        exit 1
    fi
    count=$(echo "${repo}" | wc -l)
    if [ ${count} -gt 1 ]; then
        echo 1>&2
        repo="$(printf '%s\n' "${repo}" | prompt-select -p "Choose repository:")" || abort
    else
        echo "Found repository: ${repo}" 1>&2
    fi
    if [[ "${repo}" =~ github\.com/ ]]; then
        repo_url="$(gh repo view "${repo}" --json sshUrl | jq -r '.sshUrl')"
    else
        repo_url="$(glab repo view "${repo}" -F json | jq -r '.ssh_url_to_repo')"
    fi
    if [ -n "${repo_url}" ]; then
        URL="${repo_url}"
        echo "${URL}" 1>&2
        echo 1>&2
    fi
fi

REPO_PATH=""
if [[ "${URL}" =~ ^git@.* ]]; then
    REPO_PATH="$(echo "${URL}" | cut -d':' -f2-)"
elif [[ "${URL}" =~ ^(https?|ssh)://.* ]]; then
    REPO_PATH="$(echo "${URL}" | cut -d'/' -f4-)"
fi

[ -n "${REPO_PATH}" ] && PARENT_DIR="${WORKSPACE}/$(dirname "${REPO_PATH}")"

PARENT_DIR="$(prompt-folder "Enter parent directory to clone into:" -d "${PARENT_DIR}")" || abort
[ -z "${PARENT_DIR}" ] && abort

mkdir -p "${PARENT_DIR}" 1>&2
cd "${PARENT_DIR}" 1>&2
PARENT_DIR="$(pwd)"

DIR_NAME="$(basename "${URL}" .git)"
if [ -d "${DIR_NAME}" ]; then
    prompt-no-yes "WARNING: ${PARENT_DIR}/${DIR_NAME} already exists, remove it first?" || abort
    rm -rf "${DIR_NAME}" 1>&2
fi

has_remote_branch() { command git -C "${1}" rev-parse --verify -q "refs/remotes/origin/${2}" >/dev/null; }

# Some servers do not advertise HEAD (e.g. GitLab with a stale on-disk HEAD),
# which leaves the clone without a checkout. Fall back to the forge's default
# branch, then to main/master.
checkout_default_branch() {
    local dir="${1}" branch=""
    command git -C "${dir}" rev-parse --verify -q HEAD >/dev/null && return 0

    if [[ "${URL}" =~ github\.com ]]; then
        branch="$(cd "${dir}" && gh repo view --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null)"
    else
        branch="$(cd "${dir}" && glab repo view -F json 2>/dev/null | jq -r '.default_branch // empty')"
    fi
    if [ -z "${branch}" ] || ! has_remote_branch "${dir}" "${branch}"; then
        branch=""
        for b in main master; do
            has_remote_branch "${dir}" "${b}" && branch="${b}" && break
        done
    fi
    if [ -z "${branch}" ]; then
        echo "WARNING: Remote HEAD is missing and no default branch was found, nothing checked out." 1>&2
        return 1
    fi

    echo "Remote HEAD is missing, checking out default branch: ${branch}" 1>&2
    git -C "${dir}" remote set-head origin "${branch}" 1>&2
    git -C "${dir}" checkout "${branch}" 1>&2
}

git-color clone "${URL}" 1>&2
[ -d "${DIR_NAME}/.git" ] && checkout_default_branch "${DIR_NAME}"
git-find-repo --update-listing
echo "${PARENT_DIR}/${DIR_NAME}"
