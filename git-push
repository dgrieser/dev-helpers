#!/bin/bash

git() { LC_ALL=C command git -c color.ui=always "$@"; }
git-color() { command git-color --color=always "$@"; }

usage() {
    echo "usage: $(basename "${0}") [-p|--push-only] [-F|--force-with-lease] [<branch>]" 1>&2
    exit 1
}

error() {
    echo "ERROR: ${1}" 1>&2
}

abort() {
    echo "Abort." 1>&2
    exit 1
}

fail() {
    local message="${1}"
    [ -z "${message}" ] && message="Failed."
    error "${message}"
    exit 1
}

# the byte ranges of a CSI sequence only mean what they say in the C locale
strip_ansi() {
    LC_ALL=C sed -e 's|\x1b\[[0-9;:?]*[ -/]*[@-~]||g'
}

# what the remote said arrives on stderr, so the stream is teed through a fifo:
# the terminal keeps seeing the push while it runs and the copy stays readable
# afterwards
push_with_log() {
    local fifo rc tee_pid

    push_log_dir="$(mktemp -d "${TMPDIR:-/tmp}/$(basename "${0}").XXXXXX")" \
        || fail "Cannot create a temp directory"
    trap 'rm -rf "${push_log_dir}"' EXIT
    fifo="${push_log_dir}/stderr"
    mkfifo "${fifo}" || fail "Cannot create a fifo"
    push_log="${push_log_dir}/push"
    tee "${push_log}" < "${fifo}" 1>&2 &
    tee_pid="${!}"
    "${@}" 2>"${fifo}"
    rc="${?}"
    wait "${tee_pid}"
    return "${rc}"
}

request_noun() {
    local url

    url="$(git -C "${git_dir}" remote get-url origin 2>/dev/null)"
    if [[ "${url}" == *github* ]] \
        || [ -n "$(git -C "${git_dir}" config --get remote.origin.gh-resolved 2>/dev/null)" ]; then
        echo "pull request"
    else
        echo "merge request"
    fi
}

# GitLab answers a push with "To create a merge request for <branch>, visit:"
# and GitHub with "Create a pull request for '<branch>' on GitHub by visiting:"
# whenever the pushed branch has no open request, so the push output settles the
# question for free. Only the presence of the hint is an answer though - GitHub
# prints it for a branch it has just seen for the first time and for no other -
# so without it the provider is asked, which git-pr does for both of them.
# 0 the branch has no open request, 1 it has one, 2 unknown
branch_has_no_request() {
    local count

    [ -n "${push_log}" ] && [ -r "${push_log}" ] \
        && strip_ansi < "${push_log}" | grep -qiE 'create a (merge|pull) request' \
        && return 0
    count="$(git-pr --print --output json --branch "${BRANCH_SHORT}" 2>/dev/null \
        | jq 'length' 2>/dev/null)"
    [[ "${count}" =~ ^[0-9]+$ ]] || return 2
    [ "${count}" -eq 0 ] && return 0
    return 1
}

# a pushed branch is ready for review, so the request it is still missing is
# offered right away. git-pr takes the source branch from the checkout, so the
# handover only works for the branch that is checked out
offer_request() {
    local noun

    [ "${BRANCH_SHORT}" = "$(git -C "${git_dir}" branch --show-current)" ] || return 0
    [ "${BRANCH_SHORT}" = "$(git-default 2>/dev/null)" ] && return 0
    branch_has_no_request || return 0
    noun="$(request_noun)"
    prompt-yes-no "No open ${noun} for \"${BRANCH_SHORT}\". Create one?" || return 0
    git-pr --create
}

BRANCH=""
PUSH_ONLY=0
PUSH_FORCE_WITH_LEASE=0

push_log_dir=""
push_log=""

while [ "$#" -gt 0 ]; do
    case "${1}" in
        -p|--push-only)
            PUSH_ONLY=1
            ;;
        -F|--force-with-lease)
            PUSH_FORCE_WITH_LEASE=1
            ;;
        *)
            if [ -z "${BRANCH}" ]; then
                [ -z "${1}" ] && usage
                BRANCH="${1}"
            else
                usage
            fi
            ;;
    esac
    shift
done

if [ "${PUSH_ONLY}" -eq 1 ] && [ "${PUSH_FORCE_WITH_LEASE}" -eq 1 ]; then
    fail "Cannot use -F with -p."
fi

git_dir="$(git rev-parse --show-toplevel)" || fail
[ -z "${BRANCH}" ] && BRANCH=$(git -C "${git_dir}" branch --show-current)

BRANCH_SHORT="${BRANCH}"
BRANCH_FQ="$(git -C "${git_dir}" show-ref --heads "${BRANCH}" | awk '{print $2}')"
if [ -n "${BRANCH_FQ}" ]; then
    BRANCH_SHORT="${BRANCH_FQ#refs/heads/}"
    BRANCH="${BRANCH_FQ}"
fi

if [ "${PUSH_ONLY}" -eq 0 ] && [ -z "$(git -C "${git_dir}" status --porcelain)" ]; then
    echo "No changes to commit."
    PUSH_ONLY=1
fi

message="Commit and push to \"${BRANCH_SHORT}\"?"
[ "${PUSH_ONLY}" -eq 1 ] && message="Push to \"${BRANCH_SHORT}\"?"
[ "${PUSH_FORCE_WITH_LEASE}" -eq 1 ] && message="Push to \"${BRANCH_SHORT}\" (force with lease)?"
prompt-yes-no "${message}" || abort
git-color -C "${git_dir}" init
ok=1
if [ "${PUSH_ONLY}" -eq 0 ]; then
    ok=0
    if git-add; then
        changes="$(git -C "${git_dir}" status --porcelain)"
        if [ -n "${changes}" ]; then
            git-color -C "${git_dir}" commit && ok=1
        else
            echo "No changes to commit."
            ok=1
        fi
    fi
fi
[ "${ok}" -ne 1 ] && abort
if [ "${PUSH_FORCE_WITH_LEASE}" -eq 0 ]; then
    remote_ref="refs/remotes/origin/${BRANCH_SHORT}"
    git -C "${git_dir}" fetch -q origin "${BRANCH_SHORT}" 2>/dev/null
    if git -C "${git_dir}" rev-parse -q --verify "${BRANCH}" >/dev/null && \
       git -C "${git_dir}" rev-parse -q --verify "${remote_ref}" >/dev/null && \
       ! git -C "${git_dir}" merge-base --is-ancestor "${remote_ref}" "${BRANCH}"; then
        prompt-no-yes "Remote \"origin/${BRANCH_SHORT}\" has diverged from local (e.g. after rebase). Push with --force-with-lease?" \
            || abort
        PUSH_FORCE_WITH_LEASE=1
    fi
fi
push_rc=0
if [ "${PUSH_FORCE_WITH_LEASE}" -eq 1 ]; then
    push_with_log git-color -C "${git_dir}" push --force-with-lease origin "${BRANCH}" || push_rc=1
else
    push_with_log git-color -C "${git_dir}" push -u origin "${BRANCH}" || push_rc=1
fi
[ "${push_rc}" -eq 0 ] && offer_request

# the pipelines of interest after a push are the ones of the branch it went to,
# so the tag queries are only latency here
git-pipe status --no-tags
